{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trainlab.garmin.smoke-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_id", "approved_modes", "approved_window", "backup_evidence_sha256", "prerequisites", "operations", "total_elapsed_seconds", "repeat_no_op", "activity_structure", "capability_check", "safety_checks", "acceptance_complete", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "1"},
    "authorization_id": {"$ref": "#/$defs/authorization_id"},
    "approved_modes": {"type": "array", "uniqueItems": true, "minItems": 1, "items": {"enum": ["auth", "incremental", "snapshot", "repair", "audit", "status"]}},
    "approved_window": {"type": "object", "additionalProperties": false, "required": ["timezone", "from_local_date", "through_local_date"], "properties": {"timezone": {"const": "Asia/Hong_Kong"}, "from_local_date": {"type": "string", "format": "date"}, "through_local_date": {"type": "string", "format": "date"}}},
    "backup_evidence_sha256": {"$ref": "#/$defs/hash"},
    "prerequisites": {"type": "object", "additionalProperties": false, "required": ["e01_e04_verified", "named_operator_registered", "backup_restore_verified", "shadow_window_registered", "legacy_path_independent_verified", "credential_permissions_verified", "bounded_activity_window_verified", "canonical_owner_unchanged"], "properties": {"e01_e04_verified": {"const": true}, "named_operator_registered": {"const": true}, "backup_restore_verified": {"const": true}, "shadow_window_registered": {"const": true}, "legacy_path_independent_verified": {"const": true}, "credential_permissions_verified": {"const": true}, "bounded_activity_window_verified": {"const": true}, "canonical_owner_unchanged": {"const": true}}},
    "operations": {"type": "array", "minItems": 8, "maxItems": 8, "prefixItems": [{"allOf": [{"$ref": "#/$defs/operation"}, {"properties": {"mode": {"const": "auth"}}}]}, {"allOf": [{"$ref": "#/$defs/operation"}, {"properties": {"mode": {"const": "incremental"}}}]}, {"allOf": [{"$ref": "#/$defs/operation"}, {"properties": {"mode": {"const": "incremental"}}}]}, {"allOf": [{"$ref": "#/$defs/operation"}, {"properties": {"mode": {"const": "snapshot"}}}]}, {"allOf": [{"$ref": "#/$defs/operation"}, {"properties": {"mode": {"const": "snapshot"}}}]}, {"allOf": [{"$ref": "#/$defs/operation"}, {"properties": {"mode": {"const": "repair"}}}]}, {"allOf": [{"$ref": "#/$defs/operation"}, {"properties": {"mode": {"const": "audit"}}}]}, {"allOf": [{"$ref": "#/$defs/operation"}, {"properties": {"mode": {"const": "status"}}}]}], "items": false},
    "total_elapsed_seconds": {"type": "number", "minimum": 0},
    "repeat_no_op": {"type": "object", "additionalProperties": false, "required": ["incremental", "snapshot"], "properties": {"incremental": {"$ref": "#/$defs/repeat_no_op"}, "snapshot": {"$ref": "#/$defs/repeat_no_op"}}},
    "activity_structure": {"type": "object", "additionalProperties": false, "required": ["summary_present", "fit_present", "segments_present", "samples_present", "enrichment_present", "segment_count", "sample_count", "enrichment_count"], "properties": {"summary_present": {"const": true}, "fit_present": {"const": true}, "segments_present": {"const": true}, "samples_present": {"const": true}, "enrichment_present": {"const": true}, "segment_count": {"type": "integer", "minimum": 1}, "sample_count": {"type": "integer", "minimum": 1}, "enrichment_count": {"type": "integer", "minimum": 1}}},
    "capability_check": {"type": "object", "additionalProperties": false, "required": ["checked", "state"], "properties": {"checked": {"const": true}, "state": {"enum": ["available", "not_available", "not_enabled", "not_supported"]}}},
    "safety_checks": {"type": "object", "additionalProperties": false, "required": ["receipt_log_scan_clean", "run_table_scan_clean", "temporary_zip_cleaned", "no_daemon", "no_background_threads", "no_timer", "no_listening_socket", "rollback_exercised"], "properties": {"receipt_log_scan_clean": {"const": true}, "run_table_scan_clean": {"const": true}, "temporary_zip_cleaned": {"const": true}, "no_daemon": {"const": true}, "no_background_threads": {"const": true}, "no_timer": {"const": true}, "no_listening_socket": {"const": true}, "rollback_exercised": {"const": true}}},
    "acceptance_complete": {"const": true},
    "evidence_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "authorization_id": {"type": "string", "pattern": "^authz-[0-9a-f]{32}$"},
    "invocation_id": {"type": "string", "pattern": "^inv-[0-9a-f]{32}$"},
    "run_id": {"type": "string", "pattern": "^gr-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repeat_no_op": {"type": "object", "additionalProperties": false, "required": ["first_run_id", "repeat_run_id", "same_request_hash", "no_op_confirmed"], "properties": {"first_run_id": {"$ref": "#/$defs/run_id"}, "repeat_run_id": {"$ref": "#/$defs/run_id"}, "same_request_hash": {"const": true}, "no_op_confirmed": {"const": true}}},
    "operation": {"type": "object", "additionalProperties": false, "required": ["mode", "run_id", "invocation_id", "request_sha256", "receipt_sha256", "request_schema_valid", "receipt_schema_valid", "status", "exit_code", "duration_seconds", "within_approved_window", "effective_window", "outcome_handed_off"], "properties": {"mode": {"enum": ["auth", "incremental", "snapshot", "repair", "audit", "status"]}, "run_id": {"anyOf": [{"$ref": "#/$defs/run_id"}, {"type": "null"}]}, "invocation_id": {"$ref": "#/$defs/invocation_id"}, "request_sha256": {"$ref": "#/$defs/hash"}, "receipt_sha256": {"$ref": "#/$defs/hash"}, "request_schema_valid": {"const": true}, "receipt_schema_valid": {"const": true}, "status": {"enum": ["succeeded", "partial", "deferred", "failed", "auth_required", "lock_busy"]}, "exit_code": {"type": "integer", "minimum": 0, "maximum": 255}, "duration_seconds": {"type": "number", "minimum": 0}, "within_approved_window": {"const": true}, "effective_window": {"type": "object", "additionalProperties": false, "required": ["from_local_date", "through_local_date"], "properties": {"from_local_date": {"type": ["string", "null"], "format": "date"}, "through_local_date": {"type": ["string", "null"], "format": "date"}}}, "outcome_handed_off": {"type": "boolean"}}}
  }
}
