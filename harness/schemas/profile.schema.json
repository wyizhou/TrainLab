{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timezone", "personal", "goal", "running", "strength", "climbing", "medical"],
  "properties": {
    "schema_version": {"const": 1},
    "timezone": {"const": "Asia/Singapore"},
    "personal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["birth_month"],
      "properties": {
        "birth_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"}
      }
    },
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode", "race_date", "target_time"],
      "properties": {
        "type": {"const": "half_marathon"},
        "mode": {"const": "rolling_adaptive_base"},
        "race_date": {"type": ["string", "null"], "format": "date"},
        "target_time": {"type": ["string", "null"], "pattern": "^[0-9]{2}:[0-5][0-9]:[0-5][0-9]$"}
      }
    },
    "running": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heart_rate_method"],
      "properties": {
        "heart_rate_method": {"const": "heart_rate_reserve"}
      }
    },
    "strength": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal", "structure"],
      "properties": {
        "goal": {"const": "running_and_climbing_support"},
        "structure": {"const": "full_body"}
      }
    },
    "climbing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planned_days"],
      "properties": {"planned_days": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}
    },
    "medical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraints", "active_injuries", "heart_rate_affecting_medications"],
      "properties": {
        "constraints": {"type": "array", "items": {"type": "string"}},
        "active_injuries": {"type": "array", "items": {"type": "string"}},
        "heart_rate_affecting_medications": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
