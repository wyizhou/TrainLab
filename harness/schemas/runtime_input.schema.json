{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/runtime-input-v1.json",
  "title": "TrainLab runtime input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "training_controls", "run", "profile", "data_freshness", "health", "sleep", "activities", "feedback", "history", "compression", "exercise_catalog", "policy"],
  "properties": {
    "schema_version": {"const": 1},
    "training_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "training_method", "allowed_future_activity_kinds", "training_difficulty_level", "training_difficulty_source", "marathon_target_finish_time", "marathon_target_finish_time_source", "half_marathon_target_finish_time", "half_marathon_target_finish_time_source"],
      "properties": {
        "contract_version": {"const": "1"},
        "training_method": {"const": "hansons_marathon_method"},
        "allowed_future_activity_kinds": {"const": ["running", "rest"]},
        "training_difficulty_level": {"type": "integer", "minimum": 1, "maximum": 5},
        "training_difficulty_source": {"enum": ["default", "project_global_config"]},
        "marathon_target_finish_time": {"type": ["string", "null"], "pattern": "^(?!00:00$)[0-9]{2}:[0-5][0-9]$"},
        "marathon_target_finish_time_source": {"enum": ["default", "project_global_config"]},
        "half_marathon_target_finish_time": {"type": ["string", "null"], "pattern": "^(?!00:00$)[0-9]{2}:[0-5][0-9]$"},
        "half_marathon_target_finish_time_source": {"enum": ["default", "project_global_config"]}
      }
    },
    "run": {
      "type": "object",
      "required": ["run_id", "slot", "as_of", "timezone", "window_start", "window_end", "plan_date"],
      "properties": {
        "run_id": {"type": "string", "minLength": 8},
        "slot": {"enum": ["morning", "evening"]},
        "as_of": {"type": "string", "format": "date-time"},
        "timezone": {"const": "Asia/Singapore"},
        "window_start": {"type": "string", "format": "date-time"},
        "window_end": {"type": "string", "format": "date-time"},
        "plan_date": {"type": "string", "format": "date"}
      },
      "additionalProperties": true
    },
    "profile": {"type": "object"},
    "data_freshness": {"type": "object"},
    "health": {"type": "array", "items": {"type": "object"}},
    "sleep": {"type": "array", "items": {"type": "object"}},
    "activities": {
      "type": "object",
      "required": ["summaries", "details"],
      "properties": {
        "summaries": {"type": "array", "items": {"type": "object"}},
        "details": {
          "type": "object",
          "properties": {
            "running": {"type": "array", "maxItems": 2},
            "climbing": {"type": "array", "maxItems": 2},
            "strength_training": {"type": "array", "maxItems": 2}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "feedback": {"type": "object"},
    "history": {
      "type": "object",
      "required": ["weekly", "monthly"],
      "properties": {
        "weekly": {"type": "array", "maxItems": 8},
        "monthly": {"type": "array", "maxItems": 12}
      },
      "additionalProperties": false
    },
    "compression": {"type": "object"},
    "exercise_catalog": {"type": "array", "items": {"type": "object"}},
    "policy": {"type": "object"}
  }
}
