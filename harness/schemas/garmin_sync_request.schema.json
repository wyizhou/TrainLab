{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "health_from_local_date", "through_local_date", "snapshot_local_date", "resource_kinds", "activity_ids", "repair_strategy", "invocation_id"],
  "properties": {
    "mode": {"enum": ["auth", "full", "incremental", "snapshot", "repair", "audit", "status"]},
    "health_from_local_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "through_local_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "snapshot_local_date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "resource_kinds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "activity_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "repair_strategy": {"enum": ["auto", "refetch", "reparse", "reconcile", null]},
    "invocation_id": {"type": ["string", "null"], "minLength": 1},
    "production_budget": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["max_provider_entries", "max_wall_seconds", "max_activities", "max_fit_downloads", "max_new_raw_objects", "cached_tokens_only"],
      "properties": {
        "max_provider_entries": {"type": "integer", "minimum": 1},
        "max_wall_seconds": {"type": "integer", "minimum": 1},
        "max_activities": {"type": "integer", "minimum": 1},
        "max_fit_downloads": {"type": "integer", "minimum": 1},
        "max_new_raw_objects": {"type": "integer", "minimum": 1},
        "cached_tokens_only": {"const": true}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"mode": {"enum": ["auth", "status"]}}}, "then": {"properties": {"health_from_local_date": {"const": null}, "through_local_date": {"const": null}, "snapshot_local_date": {"const": null}, "resource_kinds": {"maxItems": 0}, "activity_ids": {"maxItems": 0}, "repair_strategy": {"const": null}, "production_budget": {"const": null}}}},
    {"if": {"properties": {"mode": {"const": "full"}}}, "then": {"properties": {"snapshot_local_date": {"const": null}, "activity_ids": {"maxItems": 0}, "repair_strategy": {"const": null}}}},
    {"if": {"properties": {"mode": {"const": "incremental"}}}, "then": {"properties": {"health_from_local_date": {"const": null}, "snapshot_local_date": {"const": null}, "resource_kinds": {"maxItems": 0}, "activity_ids": {"maxItems": 0}, "repair_strategy": {"const": null}, "production_budget": {"const": null}}}},
    {"if": {"properties": {"mode": {"const": "snapshot"}}}, "then": {"properties": {"health_from_local_date": {"const": null}, "through_local_date": {"const": null}, "resource_kinds": {"maxItems": 0}, "activity_ids": {"maxItems": 0}, "repair_strategy": {"const": null}, "production_budget": {"const": null}}}},
    {"if": {"properties": {"mode": {"const": "audit"}}}, "then": {"properties": {"snapshot_local_date": {"const": null}, "resource_kinds": {"maxItems": 0}, "activity_ids": {"maxItems": 0}, "repair_strategy": {"const": null}, "production_budget": {"const": null}}}},
    {"if": {"properties": {"mode": {"const": "repair"}}}, "then": {"properties": {"snapshot_local_date": {"const": null}, "production_budget": {"const": null}}, "anyOf": [{"properties": {"health_from_local_date": {"type": "string"}}}, {"properties": {"through_local_date": {"type": "string"}}}, {"properties": {"resource_kinds": {"minItems": 1}}}, {"properties": {"activity_ids": {"minItems": 1}}}]}}
  ]
}
