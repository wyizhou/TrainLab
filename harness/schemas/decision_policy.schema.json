{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/decision-policy-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "one_primary_training_per_day", "user_selects_start_clock_time", "selection_order", "running_load", "recovery", "climbing", "strength", "feedback"],
  "properties": {
    "schema_version": {"const": 1},
    "one_primary_training_per_day": {"const": true},
    "user_selects_start_clock_time": {"const": true},
    "selection_order": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "running_load": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_complete_weeks", "minimum_complete_weeks_for_progression", "progression_requires_successful_weeks", "maximum_weekly_volume_increase_fraction", "forced_weekly_increase", "change_distance_frequency_or_intensity_dimensions_per_week", "sudden_weekly_increase_over_fraction", "sudden_increase_action", "insufficient_history_fallback", "long_run", "quality_sessions_use_running_policy"],
      "properties": {
        "baseline_complete_weeks": {"type": "integer", "minimum": 3},
        "minimum_complete_weeks_for_progression": {"type": "integer", "minimum": 2},
        "progression_requires_successful_weeks": {"type": "integer", "minimum": 2},
        "maximum_weekly_volume_increase_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.10},
        "forced_weekly_increase": {"const": false},
        "change_distance_frequency_or_intensity_dimensions_per_week": {"const": 1},
        "sudden_weekly_increase_over_fraction": {"type": "number", "minimum": 0.20},
        "sudden_increase_action": {"const": "do_not_prescribe_and_flag"},
        "insufficient_history_fallback": {
          "type": "object", "additionalProperties": false,
          "required": ["course_type", "main_set_minutes", "exact_zone_when_available", "without_exact_zone"],
          "properties": {
            "course_type": {"const": "easy_run"},
            "main_set_minutes": {"type": "integer", "minimum": 10, "maximum": 60},
            "exact_zone_when_available": {"const": "zone_2"},
            "without_exact_zone": {"const": "full_sentence_talk_test"}
          }
        },
        "long_run": {
          "type": "object", "additionalProperties": false,
          "required": ["minimum_recent_completed_runs", "initial_main_set_minutes", "target_zone", "increase_minutes_maximum", "increase_requires_normal_48_hour_recovery"],
          "properties": {
            "minimum_recent_completed_runs": {"type": "integer", "minimum": 2},
            "initial_main_set_minutes": {"type": "integer", "minimum": 30},
            "target_zone": {"const": "zone_2"},
            "increase_minutes_maximum": {"type": "integer", "minimum": 1, "maximum": 10},
            "increase_requires_normal_48_hour_recovery": {"const": true}
          }
        },
        "quality_sessions_use_running_policy": {"const": true}
      }
    },
    "recovery": {
      "type": "object", "additionalProperties": false,
      "required": ["adult_sleep_reference_minimum_hours", "single_short_sleep_night_changes_plan_alone", "single_device_anomaly_changes_plan_alone", "independent_signals_required_to_downgrade_quality", "independent_signal_examples", "explicit_not_recovered_downgrades_quality", "red_flag_or_acute_injury_action", "missing_or_stale_data_action"],
      "properties": {
        "adult_sleep_reference_minimum_hours": {"type": "number", "minimum": 7},
        "single_short_sleep_night_changes_plan_alone": {"const": false},
        "single_device_anomaly_changes_plan_alone": {"const": false},
        "independent_signals_required_to_downgrade_quality": {"type": "integer", "minimum": 2},
        "independent_signal_examples": {"type": "array", "minItems": 2, "items": {"type": "string"}, "uniqueItems": true},
        "explicit_not_recovered_downgrades_quality": {"const": true},
        "red_flag_or_acute_injury_action": {"const": "rest_and_professional_care_message"},
        "missing_or_stale_data_action": {"const": "easy_talk_test_or_rest_with_data_warning"}
      }
    },
    "climbing": {
      "type": "object", "additionalProperties": false,
      "required": ["fixed_schedule_required", "recommend_from", "minimum_pattern_occurrences_on_matching_weekday", "required_recovered_areas", "output_prefix", "output_recovery_reason_sentences", "forbidden_details"],
      "properties": {
        "fixed_schedule_required": {"const": false},
        "recommend_from": {"type": "array", "minItems": 1, "items": {"enum": ["explicit_user_plan", "supported_recent_weekly_pattern"]}, "uniqueItems": true},
        "minimum_pattern_occurrences_on_matching_weekday": {"type": "integer", "minimum": 2},
        "required_recovered_areas": {"type": "array", "items": {"enum": ["forearms", "back", "shoulders", "core"]}, "minItems": 4, "maxItems": 4, "uniqueItems": true},
        "output_prefix": {"const": "今日攀岩"},
        "output_recovery_reason_sentences": {"const": 1},
        "forbidden_details": {"type": "array", "items": {"enum": ["duration", "route", "grade", "sets", "repetitions", "technique_drill"]}, "minItems": 6, "uniqueItems": true}
      }
    },
    "strength": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_source", "recommendation_requires_enabled_policy", "recommendation_mode", "history_or_e1rm_required", "equipment_increment_required", "avoid_when_forearm_back_or_shoulder_recovery_is_poor"],
      "properties": {
        "policy_source": {"const": "config/strength_policy.yaml"},
        "recommendation_requires_enabled_policy": {"const": true},
        "recommendation_mode": {"const": "movement_only"},
        "history_or_e1rm_required": {"const": false},
        "equipment_increment_required": {"const": false},
        "avoid_when_forearm_back_or_shoulder_recovery_is_poor": {"const": true}
      }
    },
    "feedback": {
      "type": "object", "additionalProperties": false,
      "required": ["no_reply_interpretation", "no_reply_is_medical_confirmation", "temporary_feeling_expiry_days", "injury_remains_active_until_explicit_recovery_or_expiry_review", "only_explicit_long_term_language_changes_profile"],
      "properties": {
        "no_reply_interpretation": {"const": "no_new_issue_reported"},
        "no_reply_is_medical_confirmation": {"const": false},
        "temporary_feeling_expiry_days": {"type": "integer", "minimum": 1, "maximum": 30},
        "injury_remains_active_until_explicit_recovery_or_expiry_review": {"const": true},
        "only_explicit_long_term_language_changes_profile": {"const": true}
      }
    }
  }
}
