{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/garmin_live_acceptance_receipt.schema.json",
  "title": "TrainLab redacted Garmin live acceptance documents",
  "oneOf": [
    {"$ref": "#/$defs/checkpoint_document"},
    {"$ref": "#/$defs/result_document"},
    {"$ref": "#/$defs/auth_refresh_receipt_document"}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date_or_null": {"type": ["string", "null"], "format": "date"},
    "date_range": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "through"],
      "properties": {"from": {"$ref": "#/$defs/date_or_null"}, "through": {"$ref": "#/$defs/date_or_null"}}
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["fetched", "empty", "unchanged", "revised", "failed", "deferred", "not_available", "not_enabled"],
      "properties": {"fetched": {"type": "integer", "minimum": 0}, "empty": {"type": "integer", "minimum": 0}, "unchanged": {"type": "integer", "minimum": 0}, "revised": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "deferred": {"type": "integer", "minimum": 0}, "not_available": {"type": "integer", "minimum": 0}, "not_enabled": {"type": "integer", "minimum": 0}}
    },
    "entry_bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["first", "last"],
      "properties": {"first": {"type": ["integer", "null"], "minimum": 1}, "last": {"type": ["integer", "null"], "minimum": 1}}
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["ordinal", "mode", "status", "request_semantic_sha256", "requested_local_dates", "effective_local_dates", "receipt_schema_valid", "receipt_counts", "provider_entry_ordinals"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 5},
        "mode": {"enum": ["auth", "incremental", "snapshot", "audit"]},
        "status": {"enum": ["succeeded", "partial", "deferred", "failed", "auth_required", "lock_busy"]},
        "request_semantic_sha256": {"$ref": "#/$defs/hash"},
        "requested_local_dates": {"$ref": "#/$defs/date_range"},
        "effective_local_dates": {"$ref": "#/$defs/date_range"},
        "receipt_schema_valid": {"const": true},
        "receipt_counts": {"$ref": "#/$defs/counts"},
        "provider_entry_ordinals": {"$ref": "#/$defs/entry_bounds"}
      },
      "allOf": [
        {"if": {"properties": {"mode": {"const": "auth"}}}, "then": {"properties": {"ordinal": {"const": 1}, "requested_local_dates": {"properties": {"from": {"const": null}, "through": {"const": null}}}, "effective_local_dates": {"properties": {"from": {"const": null}, "through": {"const": null}}}}}},
        {"if": {"properties": {"mode": {"const": "incremental"}}}, "then": {"properties": {"requested_local_dates": {"properties": {"from": {"const": null}, "through": {"const": "2026-08-06"}}}, "effective_local_dates": {"properties": {"from": {"type": "string", "format": "date"}, "through": {"const": "2026-08-06"}}}}}},
        {"if": {"properties": {"mode": {"const": "snapshot"}}}, "then": {"properties": {"requested_local_dates": {"properties": {"from": {"const": null}, "through": {"const": "2026-08-07"}}}, "effective_local_dates": {"properties": {"from": {"const": "2026-08-07"}, "through": {"const": "2026-08-07"}}}}}},
        {"if": {"properties": {"mode": {"const": "audit"}}}, "then": {"properties": {"requested_local_dates": {"properties": {"from": {"const": "2026-08-06"}, "through": {"const": "2026-08-06"}}}, "effective_local_dates": {"properties": {"from": {"const": "2026-08-06"}, "through": {"const": "2026-08-06"}}}}}}
      ]
    },
    "checkpoint_document": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "document_kind", "timezone", "operation", "prior_provider_entry_count", "provider_entry_count", "configured_minimum_interval_ns", "adjacent_controlled_provider_intervals_ns", "previous_checkpoint_sha256", "checkpoint_sha256"],
      "properties": {
        "schema_version": {"const": "1"}, "document_kind": {"const": "garmin_live_acceptance_checkpoint"}, "timezone": {"const": "Asia/Hong_Kong"}, "operation": {"$ref": "#/$defs/operation"},
        "prior_provider_entry_count": {"type": "integer", "minimum": 0}, "provider_entry_count": {"type": "integer", "minimum": 0}, "configured_minimum_interval_ns": {"type": "integer", "minimum": 0},
        "adjacent_controlled_provider_intervals_ns": {"type": "array", "items": {"type": "integer", "minimum": 0}}, "previous_checkpoint_sha256": {"$ref": "#/$defs/hash"}, "checkpoint_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "authority": {
      "type": "object", "additionalProperties": false, "required": ["production_database", "production_raw_root", "credential_permissions"],
      "properties": {"production_database": {"const": true}, "production_raw_root": {"const": true}, "credential_permissions": {"const": true}}
    },
    "auth_refresh_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["refresh_provider_entry_count", "credential_replace_count", "social_profile_http_count", "user_settings_http_count", "cached_identity_http_count", "password_login_attempt_count", "mfa_attempt_count", "credential_fallback_attempt_count", "library_token_dump_attempt_count", "legacy_refresh_attempt_count", "implicit_401_refresh_attempt_count", "second_refresh_attempt_count", "auth_profile_retry_attempt_count", "unreviewed_profile_attempt_count"],
      "properties": {
        "refresh_provider_entry_count": {"const": 1}, "credential_replace_count": {"const": 1}, "social_profile_http_count": {"const": 1}, "user_settings_http_count": {"const": 1}, "cached_identity_http_count": {"const": 0},
        "password_login_attempt_count": {"const": 0}, "mfa_attempt_count": {"const": 0}, "credential_fallback_attempt_count": {"const": 0}, "library_token_dump_attempt_count": {"const": 0}, "legacy_refresh_attempt_count": {"const": 0}, "implicit_401_refresh_attempt_count": {"const": 0}, "second_refresh_attempt_count": {"const": 0}, "auth_profile_retry_attempt_count": {"const": 0}, "unreviewed_profile_attempt_count": {"const": 0}
      }
    },
    "auth_refresh_receipt_document": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "document_kind", "refresh_client_distribution", "credential_serialization_sha256", "counts", "credential_replaced_before_profile", "receipt_persisted_before_profile", "auth_refresh_receipt_sha256"],
      "properties": {
        "schema_version": {"const": "1"}, "document_kind": {"const": "garmin_live_auth_refresh_receipt"}, "refresh_client_distribution": {"const": "python-garminconnect-0.3.6"},
        "credential_serialization_sha256": {"$ref": "#/$defs/hash"}, "counts": {"$ref": "#/$defs/auth_refresh_counts"},
        "credential_replaced_before_profile": {"const": true}, "receipt_persisted_before_profile": {"const": true}, "auth_refresh_receipt_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "partitions": {
      "type": "object", "additionalProperties": false, "required": ["idempotence", "pacing", "durability"],
      "properties": {
        "idempotence": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["incremental-through-2026-08-06", "stable-repeat-no-new-object", "provider-drift-one-distinct-revision", "snapshot-2026-08-07", "audit-only-2026-08-06", "empty-delta", "provider-deferred", "rate-limit-boundary"]}},
        "pacing": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["first-call", "exact-minimum", "just-below-minimum", "pre-call-persistence-delay", "early-sleep-return", "retry-call", "long-provider-call"]}},
        "durability": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["pre-provider-failure-zero-entry-receipt", "completed-operation-integer-nanosecond-intervals", "post-provider-local-gate-failure-preserves-checkpoint", "ambiguous-in-flight-provider-preserves-last-checkpoint"]}}
      }
    },
    "result_document": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "document_kind", "timezone", "checkpoints", "provider_entry_count", "configured_minimum_interval_ns", "adjacent_controlled_provider_intervals_ns", "authority_unchanged", "token_dump_attempt_count", "drift_evidence", "failure_evidence", "final_checkpoint_sha256", "result_sha256", "partition_coverage"],
      "properties": {
        "schema_version": {"const": "1"}, "document_kind": {"const": "garmin_live_acceptance_result"}, "timezone": {"const": "Asia/Hong_Kong"},
        "checkpoints": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/checkpoint_document"}},
        "provider_entry_count": {"type": "integer", "minimum": 0}, "configured_minimum_interval_ns": {"type": "integer", "minimum": 0}, "adjacent_controlled_provider_intervals_ns": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "authority_unchanged": {"$ref": "#/$defs/authority"}, "token_dump_attempt_count": {"const": 0},
        "drift_evidence": {"type": "object", "additionalProperties": false, "required": ["stable_repeat_count", "changed_payload_count", "stable_repeat_violation_count", "changed_revision_violation_count", "changed_current_provenance_violation_count"], "properties": {"stable_repeat_count": {"type": "integer", "minimum": 0}, "changed_payload_count": {"type": "integer", "minimum": 0}, "stable_repeat_violation_count": {"type": "integer", "minimum": 0}, "changed_revision_violation_count": {"type": "integer", "minimum": 0}, "changed_current_provenance_violation_count": {"type": "integer", "minimum": 0}}},
        "failure_evidence": {"type": "object", "additionalProperties": false, "required": ["outcome", "last_checkpoint_preserved"], "properties": {"outcome": {"enum": ["none", "pre-provider", "post-provider-local", "ambiguous"]}, "last_checkpoint_preserved": {"type": ["boolean", "null"]}}, "allOf": [{"if": {"properties": {"outcome": {"const": "none"}}}, "then": {"properties": {"last_checkpoint_preserved": {"const": null}}}}, {"if": {"properties": {"outcome": {"enum": ["pre-provider", "post-provider-local", "ambiguous"]}}}, "then": {"properties": {"last_checkpoint_preserved": {"const": true}}}}]},
        "final_checkpoint_sha256": {"$ref": "#/$defs/hash"}, "result_sha256": {"$ref": "#/$defs/hash"}, "partition_coverage": {"$ref": "#/$defs/partitions"}
      }
    }
  }
}
