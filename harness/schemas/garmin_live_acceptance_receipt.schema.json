        "plan_id": {"const": "trainlab-reliability-21"},
        "plan_version": {"const": 5},
        "plan_hash": {"const": "94562869382e87b00a6417225cba607750914e01b22fd86c78f94ef85f8ecac9"},
        "attempt_id": {"type": "string", "pattern": "^trainlab-reliability-21-v5-n14-garmin-live-a1$"},
        "authority_file_count": {"type": "integer", "minimum": 0},
        "authority_byte_count": {"type": "integer", "minimum": 0},
        "authority_aggregate_sha256": {"$ref": "#/$defs/hash"},
