      "properties": {
        "refresh_provider_entry_count": {"type": "integer", "minimum": 0, "maximum": 1}, "credential_replace_count": {"type": "integer", "minimum": 0, "maximum": 1}, "social_profile_http_count": {"type": "integer", "minimum": 0, "maximum": 1}, "user_settings_http_count": {"type": "integer", "minimum": 0, "maximum": 1}, "cached_identity_http_count": {"const": 0},
        "password_login_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "mfa_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "credential_fallback_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "library_token_dump_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "legacy_refresh_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "implicit_401_refresh_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "second_refresh_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "auth_profile_retry_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}, "unreviewed_profile_attempt_count": {"type": "integer", "minimum": 0, "maximum": 1}
      }
