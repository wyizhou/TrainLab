      "properties": {"token_path_unchanged": {"type": "boolean"}, "token_directory_unchanged": {"type": "boolean"}, "owner_unchanged": {"type": "boolean"}, "group_unchanged": {"type": "boolean"}, "directory_mode_0700": {"type": "boolean"}, "file_mode_0600": {"type": "boolean"}, "structure_unchanged": {"type": "boolean"}, "content_changed_exactly_once": {"type": "boolean"}, "reloaded_nonexpiring": {"type": "boolean"}}
