        "pacing": {"type": "array", "uniqueItems": true, "items": {"enum": ["first-call", "exact-minimum", "just-below-minimum", "pre-call-persistence-delay", "early-sleep-return", "retry-call", "long-provider-call"]}},
        "durability": {"type": "array", "uniqueItems": true, "items": {"enum": ["pre-provider-failure-zero-entry-receipt", "completed-operation-integer-nanosecond-intervals", "post-provider-local-gate-failure-preserves-checkpoint", "ambiguous-in-flight-provider-preserves-last-checkpoint"]}}
      }
