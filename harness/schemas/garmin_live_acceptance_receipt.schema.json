        "reload": {"$ref": "#/$defs/phase_progress"},
        "authority_recheck": {"$ref": "#/$defs/phase_progress"},
        "rotation_checkpoint_receipt": {"$ref": "#/$defs/phase_progress"},
        "social_profile": {"$ref": "#/$defs/phase_progress"},
        "user_settings": {"$ref": "#/$defs/phase_progress"},
        "cached_identity": {"$ref": "#/$defs/phase_progress"},
