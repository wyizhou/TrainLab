      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "document_kind", "timezone", "failure_stage", "failure_code", "plan_id", "plan_version", "plan_hash", "attempt_id", "authority_file_count", "authority_byte_count", "authority_aggregate_sha256", "provider_entry_count", "credential_content_read_count", "credential_write_count", "production_authority_write_count", "stop_sha256"],
      "properties": {
