{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/analysis_result.schema.json",
  "title": "TrainLab analysis result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_key", "mode", "subject_id", "status", "artifacts", "training_plan", "source_usage", "quality_disclosures", "safety", "warnings"],
  "properties": {
    "schema_version": {"const": "1"},
    "run_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "mode": {"enum": ["daily", "weekly", "revise_plan", "regenerate"]},
    "subject_id": {"type": "integer", "minimum": 1},
    "status": {"const": "accepted"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"$ref": "#/$defs/artifact"}},
    "training_plan": {"type": "null"},
    "source_usage": {"type": "array", "minItems": 1, "maxItems": 4000, "items": {"$ref": "#/$defs/source_usage"}},
    "quality_disclosures": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/disclosure"}},
    "safety": {"$ref": "#/$defs/safety"},
    "warnings": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  },
  "$defs": {
    "period": {"type": "object", "additionalProperties": false, "required": ["start_local_date", "end_local_date"], "properties": {"start_local_date": {"type": "string", "format": "date"}, "end_local_date": {"type": "string", "format": "date"}}},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "period", "structured_content", "user_visible_text"],
      "properties": {
        "artifact_kind": {"enum": ["daily_summary", "daily_training_advice", "weekly_summary", "weekly_training_plan"]},
        "period": {"$ref": "#/$defs/period"},
        "structured_content": {"$ref": "#/$defs/json_value"},
        "user_visible_text": {"type": "string", "minLength": 1, "maxLength": 30000}
      }
    },
    "source_usage": {"type": "object", "additionalProperties": false, "required": ["ordinal", "input_role", "source_entity_id", "source_revision_id"], "properties": {"ordinal": {"type": "integer", "minimum": 0, "maximum": 3999}, "input_role": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"}, "source_entity_id": {"type": "string", "minLength": 1, "maxLength": 192}, "source_revision_id": {"type": "string", "minLength": 1, "maxLength": 192}}},
    "disclosure": {"type": "object", "additionalProperties": false, "required": ["code", "entity"], "properties": {"code": {"type": "string", "pattern": "^[a-z0-9_]{1,96}$"}, "entity": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9_.:-]+$"}}},
    "safety": {"type": "object", "additionalProperties": false, "required": ["safety_state", "primary_item"], "properties": {"safety_state": {"enum": ["normal", "warning", "suspended"]}, "primary_item": {"$ref": "#/$defs/json_value"}}},
    "json_value": {"anyOf": [{"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string", "maxLength": 10000}, {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/json_value"}}, {"type": "object", "maxProperties": 128, "propertyNames": {"type": "string", "maxLength": 128}, "additionalProperties": {"$ref": "#/$defs/json_value"}}]}
  }
}
