{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "periods", "retained_sections"],
  "properties": {
    "schema_version": {"const": 1},
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "enabled", "timezone", "source"],
        "properties": {
          "name": {"type": "string"},
          "kind": {"enum": ["day", "week", "month"]},
          "enabled": {"type": "boolean"},
          "timezone": {"const": "Asia/Singapore"},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "retained_sections": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
