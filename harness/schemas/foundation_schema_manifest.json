    "v_training_plan_items":{"source":"training_plan_items"},
    "v_analysis_history_context":{"source":"analysis_artifacts","trust_marker":"prior_model_output"},
    "v_current_analysis_deliveries":{"source":"analysis_deliveries"},
    "v_current_mail_response_artifacts":{"source":"mail_response_artifacts","filter":"is_current=1"},
    "v_mail_response_history_context":{"source":"mail_response_artifacts","trust_marker":"prior_model_output"},
