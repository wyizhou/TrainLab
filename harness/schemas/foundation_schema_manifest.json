  "views": {
    "v_current_daily_health":{"source":"daily_health","filter":"is_current=1"},
    "v_current_physiology_records":{"source":"physiology_records","filter":"source_revision_id IS NULL OR source_revision_id IN (SELECT id FROM source_revisions WHERE is_current=1)"},
    "v_current_physiology_metrics":{"source":"physiology_metrics","filter":"r.source_revision_id IS NULL OR r.source_revision_id IN (SELECT id FROM source_revisions WHERE is_current=1)"},
    "v_current_sleep_sessions":{"source":"sleep_sessions","filter":"source_revision_id IS NULL OR source_revision_id IN (SELECT id FROM source_revisions WHERE is_current=1)"},
    "v_current_activities":{"source":"activities","filter":"provider_state != 'provider_deleted'"},
    "v_activity_segments":{"source":"activity_segments"},
    "v_activity_metric_sources":{"source":"activity_metric_sources"},
    "v_current_mail_threads":{"source":"mail_threads","filter":"is_current=1"},
    "v_current_mail_messages":{"source":"mail_messages"},
    "v_conversation_context":{"source":"conversation_events","order":"occurred_at_utc,id"},
    "v_active_user_facts":{"source":"user_facts","filter":"is_active=1"},
    "v_current_analysis_artifacts":{"source":"analysis_artifacts","filter":"is_current=1"},
    "v_current_weekly_summaries":{"source":"analysis_artifacts","filter":"is_current=1 AND artifact_kind='weekly_summary'"},
