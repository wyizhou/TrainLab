    "v_open_data_quality_issues":{"source":"data_quality_issues","filter":"status IN ('open','acknowledged')"},
    "v_recent_orchestrator_runs":{"source":"orchestrator_runs","order":"started_at_utc DESC"},
    "v_open_operational_incidents":{"source":"operational_incidents","filter":"state IN ('open','acknowledged')"}
