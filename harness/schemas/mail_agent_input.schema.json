{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "run", "trigger_message", "thread_context", "conversation_events", "active_user_facts", "current_health_context", "current_activity_context", "current_training_plan", "relevant_analysis_artifacts", "prior_mail_responses", "data_quality", "policies", "input_manifest", "context_limits"],
  "properties": {
    "schema_version": {"const": "1"}, "run": {"$ref": "#/$defs/run"}, "trigger_message": {"$ref": "#/$defs/trigger_message"},
    "thread_context": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/thread_message"}}, "conversation_events": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/conversation_event"}},
    "active_user_facts": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/user_fact"}}, "current_health_context": {"type": "array", "maxItems": 1, "items": {"$ref": "#/$defs/health_context"}},
    "current_activity_context": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/activity_context"}}, "current_training_plan": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/training_plan"}]},
    "relevant_analysis_artifacts": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/analysis_artifact"}}, "prior_mail_responses": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/prior_mail_response"}},
    "data_quality": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/quality_issue"}}, "policies": {"$ref": "#/$defs/policies"}, "input_manifest": {"type": "array", "items": {"$ref": "#/$defs/manifest"}}, "context_limits": {"$ref": "#/$defs/context_limits"}
  },
  "$defs": {
    "id": {"type": "integer", "minimum": 1}, "revision": {"type": "integer", "minimum": 1}, "nonnegative_integer": {"type": "integer", "minimum": 0}, "nonnegative_number": {"type": "number", "minimum": 0},
    "local_date": {"type": "string", "format": "date"}, "utc_datetime": {"type": "string", "format": "date-time", "pattern": "Z$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_id": {"type": ["null", "integer"], "minimum": 1}, "nullable_string": {"type": ["null", "string"]}, "nullable_utc_datetime": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/utc_datetime"}]},
    "json_value": {"anyOf": [{"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string"}, {"type": "array", "items": {"$ref": "#/$defs/json_value"}}, {"type": "object", "additionalProperties": {"$ref": "#/$defs/json_value"}}]},
    "run": {"type": "object", "additionalProperties": false, "required": ["id", "run_key", "invocation_id", "request_kind"], "properties": {"id": {"$ref": "#/$defs/id"}, "run_key": {"type": "string", "minLength": 1}, "invocation_id": {"type": "string", "minLength": 1}, "request_kind": {"const": "process"}}},
    "trigger_message": {"type": "object", "additionalProperties": false, "required": ["id", "provider_message_id", "thread_id", "provider_thread_id", "timestamp_utc", "subject", "latest_authored_text", "body_sha256", "source_revision_id", "value_origin", "content_instruction_trust"], "properties": {"id": {"$ref": "#/$defs/id"}, "provider_message_id": {"type": "string", "minLength": 1}, "thread_id": {"$ref": "#/$defs/id"}, "provider_thread_id": {"type": "string", "minLength": 1}, "timestamp_utc": {"$ref": "#/$defs/utc_datetime"}, "subject": {"$ref": "#/$defs/nullable_string"}, "latest_authored_text": {"type": "string", "minLength": 1}, "body_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "source_revision_id": {"$ref": "#/$defs/id"}, "value_origin": {"const": "user_asserted"}, "content_instruction_trust": {"const": "untrusted_content"}}},
    "thread_message": {"type": "object", "additionalProperties": false, "required": ["id", "provider_message_id", "timestamp_utc", "subject", "body_text", "body_sha256", "actor_role", "direction", "source_revision_id", "value_origin", "content_instruction_trust"], "properties": {"id": {"$ref": "#/$defs/id"}, "provider_message_id": {"type": "string", "minLength": 1}, "timestamp_utc": {"$ref": "#/$defs/nullable_utc_datetime"}, "subject": {"$ref": "#/$defs/nullable_string"}, "body_text": {"type": "string"}, "body_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]}, "actor_role": {"enum": ["user", "trainlab", "unknown"]}, "direction": {"enum": ["inbound", "outbound", "self_copy", "unknown"]}, "source_revision_id": {"$ref": "#/$defs/id"}, "value_origin": {"enum": ["user_asserted", "prior_model_output"]}, "content_instruction_trust": {"const": "untrusted_content"}}, "oneOf": [{"properties": {"actor_role": {"const": "user"}, "direction": {"const": "inbound"}, "value_origin": {"const": "user_asserted"}}}, {"properties": {"actor_role": {"const": "trainlab"}, "direction": {"enum": ["outbound", "self_copy"]}, "value_origin": {"const": "prior_model_output"}}}, {"properties": {"actor_role": {"const": "unknown"}, "direction": {"const": "outbound"}, "value_origin": {"const": "prior_model_output"}}}]},
    "conversation_event": {"type": "object", "additionalProperties": false, "required": ["id", "subject_id", "event_type", "actor_role", "occurred_at_utc", "trust_level", "created_by"], "properties": {"id": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"}, "event_type": {"type": "string", "minLength": 1}, "actor_role": {"enum": ["user", "trainlab", "unknown"]}, "occurred_at_utc": {"$ref": "#/$defs/utc_datetime"}, "mail_message_id": {"$ref": "#/$defs/nullable_id"}, "analysis_artifact_id": {"$ref": "#/$defs/nullable_id"}, "mail_response_artifact_id": {"$ref": "#/$defs/nullable_id"}, "analysis_delivery_id": {"$ref": "#/$defs/nullable_id"}, "mail_delivery_id": {"$ref": "#/$defs/nullable_id"}, "related_run_key": {"$ref": "#/$defs/nullable_string"}, "content_text": {"$ref": "#/$defs/nullable_string"}, "structured_payload_json": {"$ref": "#/$defs/nullable_string"}, "trust_level": {"enum": ["untrusted_content", "system_generated"]}, "created_by": {"type": "string", "minLength": 1}}},
    "user_fact": {"type": "object", "additionalProperties": false, "required": ["id", "fact_key", "value", "scope", "effective_from_utc", "expires_at_utc", "confidence"], "properties": {"id": {"$ref": "#/$defs/id"}, "fact_key": {"type": "string", "minLength": 1}, "value": {"$ref": "#/$defs/json_value"}, "scope": {"enum": ["temporary", "long_term"]}, "effective_from_utc": {"$ref": "#/$defs/nullable_utc_datetime"}, "expires_at_utc": {"$ref": "#/$defs/nullable_utc_datetime"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}},
    "health_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "completed_days", "source_count", "sources", "aggregate_sha256", "metrics"],
      "properties": {
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"$ref": "#/$defs/local_date"},
            "end": {"$ref": "#/$defs/local_date"}
          }
        },
        "completed_days": {"type": "integer", "minimum": 0, "maximum": 30},
        "source_count": {"type": "integer", "minimum": 1, "maximum": 1000},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source_revision_id", "local_date"],
            "properties": {
              "id": {"$ref": "#/$defs/id"},
              "source_revision_id": {"$ref": "#/$defs/id"},
              "local_date": {"$ref": "#/$defs/local_date"}
            }
          }
        },
        "aggregate_sha256": {"$ref": "#/$defs/sha256"},
        "metrics": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric_key", "value_kind", "observation_count", "coverage_days", "latest"],
            "properties": {
              "metric_key": {"type": "string", "minLength": 1, "maxLength": 512},
              "value_kind": {"enum": ["numeric", "categorical"]},
              "observation_count": {"type": "integer", "minimum": 1},
              "coverage_days": {"type": "integer", "minimum": 1, "maximum": 30},
              "latest": {
                "type": "object",
                "additionalProperties": false,
                "required": ["local_date", "value"],
                "properties": {
                  "local_date": {"$ref": "#/$defs/local_date"},
                  "value": {"$ref": "#/$defs/json_value"}
                }
              },
              "average": {"type": "number"},
              "minimum": {"type": "number"},
              "maximum": {"type": "number"},
              "trend": {"enum": ["increasing", "decreasing", "stable", "insufficient"]},
              "value_counts": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["value", "count"],
                  "properties": {
                    "value": {"$ref": "#/$defs/json_value"},
                    "count": {"type": "integer", "minimum": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "activity_context": {"oneOf": [{"$ref": "#/$defs/activity_context_full"}, {"$ref": "#/$defs/activity_context_compact"}]},
    "activity_context_full": {"type": "object", "additionalProperties": false, "required": ["id", "provider_activity_id", "name", "sport", "sub_sport", "start_time_utc", "end_time_utc", "local_date", "elapsed_seconds", "timer_seconds", "distance_m", "primary_revision_id", "provider_state"], "properties": {"id": {"$ref": "#/$defs/id"}, "provider_activity_id": {"type": "string", "minLength": 1}, "name": {"$ref": "#/$defs/nullable_string"}, "sport": {"$ref": "#/$defs/nullable_string"}, "sub_sport": {"$ref": "#/$defs/nullable_string"}, "start_time_utc": {"$ref": "#/$defs/utc_datetime"}, "end_time_utc": {"$ref": "#/$defs/nullable_utc_datetime"}, "local_date": {"$ref": "#/$defs/local_date"}, "elapsed_seconds": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonnegative_number"}]}, "timer_seconds": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonnegative_number"}]}, "distance_m": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonnegative_number"}]}, "primary_revision_id": {"$ref": "#/$defs/id"}, "provider_state": {"enum": ["active", "suspected_missing"]}}},
    "activity_context_compact": {"type": "object", "additionalProperties": false, "required": ["id", "provider_activity_id", "sport", "local_date", "start_time_utc", "elapsed_seconds", "distance_m", "primary_revision_id"], "properties": {"id": {"$ref": "#/$defs/id"}, "provider_activity_id": {"type": "string", "minLength": 1}, "sport": {"$ref": "#/$defs/nullable_string"}, "local_date": {"$ref": "#/$defs/local_date"}, "start_time_utc": {"$ref": "#/$defs/utc_datetime"}, "elapsed_seconds": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonnegative_number"}]}, "distance_m": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/nonnegative_number"}]}, "primary_revision_id": {"$ref": "#/$defs/id"}}},
    "training_plan_item": {"type": "object", "additionalProperties": false, "required": ["id", "training_plan_id", "item_index", "local_date", "activity_kind", "prescription_json", "rationale_text", "stop_conditions_json"], "properties": {"id": {"$ref": "#/$defs/id"}, "training_plan_id": {"$ref": "#/$defs/id"}, "item_index": {"$ref": "#/$defs/nonnegative_integer"}, "local_date": {"$ref": "#/$defs/local_date"}, "activity_kind": {"enum": ["running", "climbing", "strength", "rest"]}, "prescription_json": {"type": "string"}, "rationale_text": {"$ref": "#/$defs/nullable_string"}, "stop_conditions_json": {"type": "string"}}},
    "training_plan": {"type": "object", "additionalProperties": false, "required": ["id", "subject_id", "analysis_artifact_id", "plan_start_local_date", "plan_end_local_date", "timezone", "status", "objective_json", "constraints_json", "created_at_utc", "artifact_revision_no", "items"], "properties": {"id": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"}, "analysis_artifact_id": {"$ref": "#/$defs/id"}, "plan_start_local_date": {"$ref": "#/$defs/local_date"}, "plan_end_local_date": {"$ref": "#/$defs/local_date"}, "timezone": {"const": "Asia/Singapore"}, "status": {"const": "active"}, "objective_json": {"type": "string"}, "constraints_json": {"type": "string"}, "created_at_utc": {"$ref": "#/$defs/utc_datetime"}, "artifact_revision_no": {"$ref": "#/$defs/revision"}, "items": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/training_plan_item"}}}},
    "analysis_artifact": {"type": "object", "additionalProperties": false, "required": ["id", "subject_id", "artifact_kind", "period_start_local_date", "period_end_local_date", "revision_no", "generated_by_run_id", "schema_version", "structured_content_json", "user_visible_text", "content_sha256", "is_current", "supersedes_artifact_id", "created_at_utc"], "properties": {"id": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"}, "artifact_kind": {"enum": ["daily_summary", "daily_training_advice", "weekly_summary", "weekly_training_plan"]}, "period_start_local_date": {"$ref": "#/$defs/local_date"}, "period_end_local_date": {"$ref": "#/$defs/local_date"}, "revision_no": {"$ref": "#/$defs/revision"}, "generated_by_run_id": {"$ref": "#/$defs/id"}, "schema_version": {"type": "string", "minLength": 1}, "structured_content_json": {"type": "string"}, "user_visible_text": {"type": "string"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "is_current": {"const": 1}, "supersedes_artifact_id": {"$ref": "#/$defs/nullable_id"}, "created_at_utc": {"$ref": "#/$defs/utc_datetime"}}},
    "prior_mail_response": {"type": "object", "additionalProperties": false, "required": ["id", "subject_id", "mail_thread_id", "in_reply_to_mail_message_id", "response_kind", "revision_no", "generated_by_mail_agent_run_id", "schema_version", "structured_content_json", "user_visible_text", "content_sha256", "is_current", "supersedes_mail_response_artifact_id", "created_at_utc", "trust_class"], "properties": {"id": {"$ref": "#/$defs/id"}, "subject_id": {"$ref": "#/$defs/id"}, "mail_thread_id": {"$ref": "#/$defs/id"}, "in_reply_to_mail_message_id": {"$ref": "#/$defs/nullable_id"}, "response_kind": {"type": "string", "minLength": 1}, "revision_no": {"$ref": "#/$defs/revision"}, "generated_by_mail_agent_run_id": {"$ref": "#/$defs/id"}, "schema_version": {"type": "string", "minLength": 1}, "structured_content_json": {"type": "string"}, "user_visible_text": {"type": "string"}, "content_sha256": {"$ref": "#/$defs/sha256"}, "is_current": {"enum": [0, 1]}, "supersedes_mail_response_artifact_id": {"$ref": "#/$defs/nullable_id"}, "created_at_utc": {"$ref": "#/$defs/utc_datetime"}, "trust_class": {"const": "prior_model_output"}}},
    "quality_issue": {"type": "object", "additionalProperties": false, "required": ["id", "entity_type", "entity_id", "issue_code", "severity", "details_json", "status", "first_seen_at_utc", "last_seen_at_utc", "resolved_at_utc", "source_revision_id"], "properties": {"id": {"$ref": "#/$defs/id"}, "entity_type": {"type": "string", "minLength": 1}, "entity_id": {"$ref": "#/$defs/nullable_id"}, "issue_code": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "error"]}, "details_json": {"type": "string"}, "status": {"enum": ["open", "acknowledged"]}, "first_seen_at_utc": {"$ref": "#/$defs/utc_datetime"}, "last_seen_at_utc": {"$ref": "#/$defs/utc_datetime"}, "resolved_at_utc": {"$ref": "#/$defs/nullable_utc_datetime"}, "source_revision_id": {"$ref": "#/$defs/nullable_id"}}},
    "policies": {"type": "object", "additionalProperties": false, "required": ["version", "timezone", "sensitive_field_policy"], "properties": {"version": {"type": "string", "minLength": 1}, "timezone": {"const": "Asia/Singapore"}, "sensitive_field_policy": {"const": "recursive_minimization"}}},
    "manifest": {"type": "object", "additionalProperties": false, "required": ["ordinal", "input_role", "source_entity_type", "source_entity_id", "source_revision_id", "entity_revision", "value_origin", "trust_class", "content_instruction_trust", "input_sha256", "context_schema_version", "policy_version", "shared_harness_version", "mail_harness_version"], "properties": {"ordinal": {"$ref": "#/$defs/nonnegative_integer"}, "input_role": {"enum": ["trigger_message", "thread_message", "active_user_fact", "health_fact", "activity_fact", "analysis_artifact", "prior_mail_response", "current_plan", "conversation_event", "quality_state"]}, "source_entity_type": {"enum": ["mail_message", "user_fact", "daily_health", "activity", "analysis_artifact", "mail_response_artifact", "training_plan", "conversation_event", "data_quality_issue"]}, "source_entity_id": {"$ref": "#/$defs/id"}, "source_revision_id": {"$ref": "#/$defs/nullable_id"}, "entity_revision": {"$ref": "#/$defs/revision"}, "value_origin": {"enum": ["provider_fact", "user_asserted", "derived_statistic", "prior_model_output"]}, "trust_class": {"enum": ["provider_fact", "user_asserted", "derived_statistic", "prior_model_output"]}, "content_instruction_trust": {"const": "untrusted_content"}, "input_sha256": {"$ref": "#/$defs/sha256"}, "context_schema_version": {"const": "1"}, "policy_version": {"type": "string", "minLength": 1}, "shared_harness_version": {"type": "string", "minLength": 1}, "mail_harness_version": {"type": "string", "minLength": 1}}},
    "omission": {"oneOf": [{"$ref": "#/$defs/omission_thread_messages"}, {"$ref": "#/$defs/omission_thread_body"}, {"$ref": "#/$defs/omission_thread_untrusted"}, {"$ref": "#/$defs/omission_completed_days"}, {"$ref": "#/$defs/omission_unrelated_artifacts"}, {"$ref": "#/$defs/omission_conversation_events"}, {"$ref": "#/$defs/omission_quality_issues"}, {"$ref": "#/$defs/omission_thread_total"}, {"$ref": "#/$defs/omission_activity_compacted"}, {"$ref": "#/$defs/omission_artifact_total"}, {"$ref": "#/$defs/omission_prior_total"}]},
    "omission_thread_messages": {"type": "object", "additionalProperties": false, "required": ["kind", "count", "selection"], "properties": {"kind": {"const": "thread_messages_omitted"}, "count": {"$ref": "#/$defs/nonnegative_integer"}, "selection": {"const": "oldest_first_removed"}}},
    "omission_thread_body": {"type": "object", "additionalProperties": false, "required": ["kind", "entity_id", "omitted_bytes", "selection"], "properties": {"kind": {"const": "thread_body_truncated"}, "entity_id": {"$ref": "#/$defs/id"}, "omitted_bytes": {"$ref": "#/$defs/nonnegative_integer"}, "selection": {"const": "oldest_body_first"}}},
    "omission_thread_untrusted": {"type": "object", "additionalProperties": false, "required": ["kind", "entity_id"], "properties": {"kind": {"const": "thread_message_untrusted_excluded"}, "entity_id": {"$ref": "#/$defs/id"}}},
    "omission_completed_days": {"type": "object", "additionalProperties": false, "required": ["kind", "count", "before_local_date"], "properties": {"kind": {"const": "completed_days_omitted"}, "count": {"$ref": "#/$defs/nonnegative_integer"}, "before_local_date": {"$ref": "#/$defs/local_date"}}},
    "omission_unrelated_artifacts": {"type": "object", "additionalProperties": false, "required": ["kind", "count", "window_start", "window_end"], "properties": {"kind": {"const": "unrelated_artifacts_excluded"}, "count": {"$ref": "#/$defs/nonnegative_integer"}, "window_start": {"$ref": "#/$defs/local_date"}, "window_end": {"$ref": "#/$defs/local_date"}}},
    "omission_conversation_events": {"type": "object", "additionalProperties": false, "required": ["kind", "count", "selection"], "properties": {"kind": {"const": "conversation_events_omitted"}, "count": {"$ref": "#/$defs/nonnegative_integer"}, "selection": {"const": "oldest_first"}}},
    "omission_quality_issues": {"type": "object", "additionalProperties": false, "required": ["kind", "count", "selection"], "properties": {"kind": {"const": "quality_issues_omitted"}, "count": {"$ref": "#/$defs/nonnegative_integer"}, "selection": {"const": "lowest_priority_last"}}},
    "omission_thread_total": {"type": "object", "additionalProperties": false, "required": ["kind", "entity_id", "selection"], "properties": {"kind": {"const": "thread_message_omitted_total_limit"}, "entity_id": {"$ref": "#/$defs/id"}, "selection": {"const": "oldest_nontrigger_first"}}},
    "omission_activity_compacted": {"type": "object", "additionalProperties": false, "required": ["kind", "entity_id", "omitted_fields"], "properties": {"kind": {"const": "activity_detail_compacted_total_limit"}, "entity_id": {"$ref": "#/$defs/id"}, "omitted_fields": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}},
    "omission_artifact_total": {"type": "object", "additionalProperties": false, "required": ["kind", "entity_id"], "properties": {"kind": {"const": "artifact_omitted_total_limit"}, "entity_id": {"$ref": "#/$defs/id"}}},
    "omission_prior_total": {"type": "object", "additionalProperties": false, "required": ["kind", "entity_id"], "properties": {"kind": {"const": "prior_response_omitted_total_limit"}, "entity_id": {"$ref": "#/$defs/id"}}},
    "context_limits": {"type": "object", "additionalProperties": false, "required": ["trigger_bytes", "thread_body_bytes", "thread_messages", "completed_days", "prior_responses", "related_artifacts", "max_bytes", "date_extension_reason", "omissions"], "properties": {"trigger_bytes": {"$ref": "#/$defs/nonnegative_integer"}, "thread_body_bytes": {"$ref": "#/$defs/nonnegative_integer"}, "thread_messages": {"$ref": "#/$defs/nonnegative_integer"}, "completed_days": {"$ref": "#/$defs/nonnegative_integer"}, "prior_responses": {"$ref": "#/$defs/nonnegative_integer"}, "related_artifacts": {"$ref": "#/$defs/nonnegative_integer"}, "max_bytes": {"const": 1000000}, "date_extension_reason": {"enum": [null, "explicit_earlier_date", "explicit_date_range", "plan_history_question"]}, "omissions": {"type": "array", "items": {"$ref": "#/$defs/omission"}}}}
  }
}
