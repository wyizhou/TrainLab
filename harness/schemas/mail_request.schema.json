{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/mail_request.schema.json",
  "title": "TrainLab MailRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "subject_id", "invocation_id", "requested_at_utc"],
  "properties": {
    "mode": {"enum": ["run", "poll", "process", "deliver_response", "reconcile", "status"]},
    "subject_id": {"type": "integer", "minimum": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "requested_at_utc": {"type": "string", "minLength": 1},
    "mail_message_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mail_response_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dependency_analysis_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "mail_delivery_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "run_key": {"type": ["string", "null"], "minLength": 1},
    "thread_id": {"type": ["string", "null"], "minLength": 1},
    "max_items": {"type": ["integer", "null"], "minimum": 0},
    "max_threads": {"type": ["integer", "null"], "minimum": 0},
    "deadline_seconds": {"type": ["integer", "null"], "minimum": 0},
    "regeneration_reason_code": {"type": ["string", "null"], "minLength": 1}
  }
}
