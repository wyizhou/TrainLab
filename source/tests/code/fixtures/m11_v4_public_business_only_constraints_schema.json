{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/tests/all-business-only-keywords.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["lengths", "items", "patterned", "dated", "bounded"],
  "properties": {
    "lengths": {"type": "string", "minLength": 1, "maxLength": 20},
    "items": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string"}},
    "patterned": {"type": "string", "pattern": "^[a-z]+$"},
    "dated": {"type": "string", "format": "date"},
    "bounded": {"type": "number", "minimum": 1, "maximum": 10}
  }
}
