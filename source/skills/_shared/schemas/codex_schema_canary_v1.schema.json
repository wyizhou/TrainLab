{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/codex_schema_canary_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "error_code", "input_class", "codex_version",
    "codex_executable_sha256",
    "timeout_seconds", "command_contract", "wire_schema_sha256", "prompt_sha256", "events_captured_bytes",
    "events_sha256", "stderr_captured_bytes", "stderr_sha256",
    "result_bytes", "result_sha256", "provider_calls", "external_actions"
  ],
  "properties": {
    "schema_version": {"const": "codex_schema_canary_v1"},
    "status": {"enum": ["succeeded", "failed"]},
    "error_code": {"type": ["string", "null"], "minLength": 1},
    "input_class": {"const": "public_synthetic"},
    "codex_version": {"type": "string", "minLength": 1},
    "codex_executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
    "command_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ephemeral", "ignore_user_config", "sandbox", "json_events", "output_schema"],
      "properties": {
        "ephemeral": {"const": true},
        "ignore_user_config": {"const": true},
        "sandbox": {"const": "read-only"},
        "json_events": {"const": true},
        "output_schema": {"const": "daily_ai_result_codex_v2"}
      }
    },
    "wire_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "events_captured_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
    "events_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_captured_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_bytes": {"type": ["integer", "null"], "minimum": 1, "maximum": 1048576},
    "result_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "provider_calls": {"const": 0},
    "external_actions": {"const": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}},
      "then": {
        "properties": {
          "error_code": {"const": null},
          "result_bytes": {"type": "integer", "minimum": 1},
          "result_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "error_code": {"type": "string", "minLength": 1},
          "result_bytes": {"const": null},
          "result_sha256": {"const": null}
        }
      }
    }
  ]
}
