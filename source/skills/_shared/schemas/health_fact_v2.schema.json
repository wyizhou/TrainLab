{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/health_fact_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["metric_code", "status", "value", "unit", "observed_date", "raw_refs", "reason_code", "uncertainty"],
  "properties": {
    "metric_code": {
      "type": "string",
      "enum": ["sleep:main_sleep", "rhr:resting_heart_rate", "hrv:hrv", "heart_rates:heart_rate", "max_metrics:vo2_max", "weigh_ins:weight"]
    },
    "status": {"type": "string", "enum": ["available", "missing", "insufficient_data"]},
    "value": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/sleep_value"},
        {"$ref": "#/$defs/rhr_value"},
        {"$ref": "#/$defs/hrv_value"},
        {"$ref": "#/$defs/heart_rates_value"},
        {"$ref": "#/$defs/vo2_value"},
        {"$ref": "#/$defs/weight_value"}
      ]
    },
    "unit": {"type": ["string", "null"]},
    "observed_date": {"type": ["string", "null"], "format": "date"},
    "raw_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/raw_ref"}},
    "reason_code": {
      "type": ["string", "null"],
      "enum": [null, "not_found", "outside_lookback", "parse_error", "incomplete", "date_mismatch", "unit_invalid", "conflicting_records"]
    },
    "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "available"}}},
      "then": {
        "properties": {
          "observed_date": {"type": "string", "format": "date"},
          "raw_refs": {"minItems": 1, "maxItems": 1},
          "reason_code": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "missing"}}},
      "then": {
        "properties": {
          "value": {"type": "null"},
          "unit": {"type": "null"},
          "observed_date": {"type": "null"},
          "raw_refs": {"maxItems": 0},
          "reason_code": {"enum": ["not_found", "outside_lookback"]}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "insufficient_data"}}},
      "then": {
        "properties": {
          "value": {"type": "null"},
          "unit": {"type": "null"},
          "observed_date": {"type": "null"},
          "raw_refs": {"minItems": 1},
          "reason_code": {"enum": ["parse_error", "incomplete", "date_mismatch", "unit_invalid", "conflicting_records"]}
        }
      }
    },
    {
      "if": {"properties": {"metric_code": {"const": "sleep:main_sleep"}, "status": {"const": "available"}}},
      "then": {"properties": {"value": {"$ref": "#/$defs/sleep_value"}, "unit": {"const": "seconds"}}}
    },
    {
      "if": {"properties": {"metric_code": {"const": "rhr:resting_heart_rate"}, "status": {"const": "available"}}},
      "then": {"properties": {"value": {"$ref": "#/$defs/rhr_value"}, "unit": {"const": "bpm"}}}
    },
    {
      "if": {"properties": {"metric_code": {"const": "hrv:hrv"}, "status": {"const": "available"}}},
      "then": {"properties": {"value": {"$ref": "#/$defs/hrv_value"}, "unit": {"const": "ms"}}}
    },
    {
      "if": {"properties": {"metric_code": {"const": "heart_rates:heart_rate"}, "status": {"const": "available"}}},
      "then": {"properties": {"value": {"$ref": "#/$defs/heart_rates_value"}, "unit": {"const": "bpm"}}}
    },
    {
      "if": {"properties": {"metric_code": {"const": "max_metrics:vo2_max"}, "status": {"const": "available"}}},
      "then": {"properties": {"value": {"$ref": "#/$defs/vo2_value"}, "unit": {"const": "ml/kg/min"}}}
    },
    {
      "if": {"properties": {"metric_code": {"const": "weigh_ins:weight"}, "status": {"const": "available"}}},
      "then": {"properties": {"value": {"$ref": "#/$defs/weight_value"}, "unit": {"const": "kg"}}}
    }
  ],
  "$defs": {
    "raw_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_file_id", "raw_sha256"],
      "properties": {
        "raw_file_id": {"type": "integer", "minimum": 1},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sleep_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "metric", "uncertainty", "completeness", "sleep_start", "sleep_end", "duration_seconds", "sleep_wake_date"],
      "properties": {
        "resource": {"type": "string", "const": "sleep"},
        "metric": {"type": "string", "const": "main_sleep"},
        "uncertainty": {"type": "string", "const": "named_fields"},
        "completeness": {"type": "string", "const": "complete"},
        "sleep_start": {"type": "string", "format": "date-time"},
        "sleep_end": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "sleep_wake_date": {"type": "string", "format": "date"},
        "stage_group_count": {"type": "integer", "minimum": 0},
        "sleep_stages": {"$ref": "#/$defs/sleep_stages"}
      }
    },
    "sleep_stages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "durations_seconds", "timeline"],
      "properties": {
        "source": {"type": "string", "const": "garmin_named_sleep_stage_durations"},
        "durations_seconds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deep", "light", "rem", "awake"],
          "properties": {
            "deep": {"type": "number", "minimum": 0},
            "light": {"type": "number", "minimum": 0},
            "rem": {"type": "number", "minimum": 0},
            "awake": {"type": "number", "minimum": 0}
          }
        },
        "timeline": {"type": "array", "items": {"$ref": "#/$defs/sleep_stage_interval"}}
      }
    },
    "sleep_stage_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "start", "end", "duration_seconds"],
      "properties": {
        "stage": {"type": "string", "enum": ["deep", "light", "rem", "awake"]},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "rhr_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "uncertainty", "metric", "resting_heart_rate_bpm"],
      "properties": {
        "resource": {"type": "string", "const": "rhr"},
        "uncertainty": {"type": "string", "const": "named_fields"},
        "metric": {"type": "string", "const": "resting_heart_rate"},
        "resting_heart_rate_bpm": {"type": "number", "minimum": 0}
      }
    },
    "hrv_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "uncertainty", "metric"],
      "properties": {
        "resource": {"type": "string", "const": "hrv"},
        "uncertainty": {"type": "string", "const": "named_fields"},
        "metric": {"type": "string", "const": "hrv"},
        "last_night_average": {"type": "number", "minimum": 0},
        "weekly_average": {"type": "number", "minimum": 0},
        "last_night_5_min_high": {"type": "number", "minimum": 0}
      },
      "anyOf": [
        {"required": ["last_night_average"]},
        {"required": ["weekly_average"]},
        {"required": ["last_night_5_min_high"]}
      ]
    },
    "heart_rates_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "uncertainty", "metric", "sample_count"],
      "properties": {
        "resource": {"type": "string", "const": "heart_rates"},
        "uncertainty": {"type": "string", "const": "named_fields"},
        "metric": {"type": "string", "const": "heart_rate"},
        "sample_count": {"type": "integer", "minimum": 1},
        "aggregate": {"$ref": "#/$defs/numeric_summary"},
        "median": {"type": "number", "minimum": 0},
        "average": {"type": "number", "minimum": 0},
        "resting_heart_rate_bpm": {"type": "number", "minimum": 0}
      }
    },
    "numeric_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "minimum": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "minimum": 0},
        "average": {"type": "number", "minimum": 0}
      }
    },
    "vo2_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "metric", "vo2_max", "unit", "observed_date", "age_days", "selection_kind"],
      "properties": {
        "resource": {"type": "string", "const": "max_metrics"},
        "metric": {"type": "string", "const": "vo2_max"},
        "vo2_max": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "const": "ml/kg/min"},
        "observed_date": {"type": "string", "format": "date"},
        "age_days": {"type": "integer", "minimum": 0, "maximum": 30},
        "selection_kind": {"type": "string", "enum": ["exact_date", "latest_prior"]}
      }
    },
    "weight_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "metric", "weight", "unit", "observed_date", "age_days", "selection_kind"],
      "properties": {
        "resource": {"type": "string", "const": "weigh_ins"},
        "metric": {"type": "string", "const": "weight"},
        "weight": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "const": "kg"},
        "observed_date": {"type": "string", "format": "date"},
        "age_days": {"type": "integer", "minimum": 0, "maximum": 14},
        "selection_kind": {"type": "string", "enum": ["exact_date", "latest_prior"]}
      }
    }
  }
}
