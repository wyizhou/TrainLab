{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "period_start_utc",
    "period_end_utc",
    "next_plan_dates",
    "goal_snapshot",
    "provider_calls",
    "external_actions"
  ],
  "properties": {
    "schema_version": {
      "const": "fit_weekly_stage_input_v3"
    },
    "stage": {
      "enum": [
        "plan",
        "summary"
      ]
    },
    "period_start_utc": {
      "type": "string",
      "format": "date-time"
    },
    "period_end_utc": {
      "type": "string",
      "format": "date-time"
    },
    "next_plan_dates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string",
        "format": "date"
      }
    },
    "goal_snapshot": {
      "type": "object",
      "required": [
        "sha256",
        "goal"
      ],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "goal": {
          "$ref": "urn:trainlab:training_goal_text_v1"
        }
      }
    },
    "provider_calls": {
      "type": "integer",
      "const": 0
    },
    "external_actions": {
      "type": "integer",
      "const": 0
    },
    "running_activities": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "activity_ref",
              "fit_sha256",
              "parser_version",
              "start_utc",
              "methods",
              "sessions"
            ],
            "additionalProperties": false,
            "properties": {
              "activity_ref": {
                "type": "string",
                "pattern": "^[0-9]{1,32}$"
              },
              "fit_sha256": {
                "$ref": "#/$defs/sha"
              },
              "parser_version": {
                "enum": [
                  "fit-summary-1",
                  "fit-summary-2"
                ]
              },
              "start_utc": {
                "type": "string",
                "format": "date-time"
              },
              "methods": {
                "type": "object"
              },
              "sessions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    {
                      "anyOf": [
                        {
                          "$ref": "urn:trainlab:fit_activity_v1#/$defs/session"
                        },
                        {
                          "$ref": "urn:trainlab:fit_activity_v2#/$defs/session"
                        }
                      ]
                    },
                    {
                      "properties": {
                        "sport": {
                          "const": "running"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "activity_ref",
              "fit_sha256",
              "parser_version",
              "start_utc",
              "methods",
              "sessions"
            ],
            "additionalProperties": false,
            "properties": {
              "activity_ref": {
                "type": "string",
                "pattern": "^[0-9]{1,32}$"
              },
              "fit_sha256": {
                "$ref": "#/$defs/sha"
              },
              "parser_version": {
                "const": "fit-summary-3"
              },
              "start_utc": {
                "type": "string",
                "format": "date-time"
              },
              "methods": {
                "type": "object"
              },
              "sessions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "allOf": [
                    {
                      "$ref": "urn:trainlab:fit_activity_v3#/$defs/session"
                    },
                    {
                      "properties": {
                        "sport": {
                          "const": "running"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    },
    "running_history": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "period_end_utc",
          "running_sha256",
          "running"
        ],
        "additionalProperties": false,
        "properties": {
          "period_end_utc": {
            "type": "string",
            "format": "date-time"
          },
          "running_sha256": {
            "$ref": "#/$defs/sha"
          },
          "running": {
            "type": "object",
            "required": [
              "analysis",
              "plan"
            ],
            "properties": {
              "analysis": true,
              "plan": true
            },
            "additionalProperties": false
          }
        }
      }
    },
    "current_week": {
      "type": "object"
    },
    "history_reports": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object"
      }
    },
    "fixed_plan": {
      "type": "object",
      "required": [
        "period_end_utc",
        "request_sha256",
        "capture_sha256",
        "result_sha256",
        "plan"
      ],
      "additionalProperties": false,
      "properties": {
        "period_end_utc": {
          "type": "string",
          "format": "date-time"
        },
        "request_sha256": {
          "$ref": "#/$defs/sha"
        },
        "capture_sha256": {
          "$ref": "#/$defs/sha"
        },
        "result_sha256": {
          "$ref": "#/$defs/sha"
        },
        "plan": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "plan"
          }
        }
      },
      "then": {
        "required": [
          "running_activities",
          "running_history"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "current_week"
              ]
            },
            {
              "required": [
                "history_reports"
              ]
            },
            {
              "required": [
                "fixed_plan"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "current_week",
          "history_reports",
          "fixed_plan"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "running_activities"
              ]
            },
            {
              "required": [
                "running_history"
              ]
            }
          ]
        }
      }
    }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
