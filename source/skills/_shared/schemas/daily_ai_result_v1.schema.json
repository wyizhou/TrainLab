{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/daily_ai_result_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "report_date", "review_date", "sleep_wake_date", "safety", "summary", "evidence_refs", "provider_calls"],
  "properties": {
    "schema_version": {"const": "daily_ai_result_v1"},
    "status": {"enum": ["succeeded", "blocked"]},
    "error_code": {"type": ["string", "null"], "minLength": 1},
    "report_date": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"},
    "sleep_wake_date": {"type": "string", "format": "date"},
    "safety": {"enum": ["ready", "caution", "blocked"]},
    "summary": {"type": "string", "minLength": 1},
    "bounded_metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
    "recent_trend_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "today_course": {"type": "object", "additionalProperties": true},
    "provider_calls": {"const": 0}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"required": ["bounded_metrics", "stop_conditions"]}},
    {"if": {"properties": {"status": {"const": "blocked"}}}, "then": {"required": ["error_code"]}}
  ],
  "$defs": {
    "evidence_ref": {"type": "object", "additionalProperties": false, "required": ["raw_file_id", "sha256", "claim"], "properties": {"raw_file_id": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "claim": {"type": "string", "minLength": 1}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["name", "value", "unit", "evidence_ref"], "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": ["number", "string", "null"]}, "unit": {"type": "string", "minLength": 1}, "evidence_ref": {"type": "integer", "minimum": 1}}}
  }
}
