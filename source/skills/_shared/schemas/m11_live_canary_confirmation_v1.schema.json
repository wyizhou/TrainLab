{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/m11_live_canary_confirmation_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "kind", "action_id", "gmail_message_id_sha256", "web_confirmed", "mobile_confirmed", "provider_calls", "confirmed_at_utc"],
  "properties": {
    "schema_version": {"type": "string", "const": "m11_live_canary_confirmation_v1"},
    "status": {"type": "string", "const": "succeeded"},
    "kind": {"type": "string", "enum": ["daily", "weekly"]},
    "action_id": {"type": "integer", "minimum": 1},
    "gmail_message_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "web_confirmed": {"type": "boolean", "const": true},
    "mobile_confirmed": {"type": "boolean", "const": true},
    "provider_calls": {"type": "integer", "const": 0},
    "confirmed_at_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
