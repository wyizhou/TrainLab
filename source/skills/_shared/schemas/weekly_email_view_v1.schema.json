{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_email_view_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "period", "status", "error_code", "decision", "progression_dimension", "summary", "stats", "plan_items", "charts", "extra_sections", "evidence", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "weekly_email_view_v1"},
    "kind": {"type": "string", "const": "weekly"},
    "title": {"type": "string", "pattern": "^TrainLab · 每周总结 · [0-9]{4}-[0-9]{2}-[0-9]{2}~[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "status": {"type": "string", "enum": ["ready", "blocked"]},
    "error_code": {"type": ["string", "null"]},
    "decision": {"enum": ["advance", "hold", "deload", null]},
    "progression_dimension": {"enum": ["distance", "intensity", "none", null]},
    "summary": {"type": "string", "minLength": 1},
    "stats": {"type": "object", "additionalProperties": false, "required": ["daily_count", "caution_days", "running_distance_km"], "properties": {"daily_count": {"type": "integer", "const": 7}, "caution_days": {"type": "integer", "minimum": 0, "maximum": 7}, "running_distance_km": {"type": "number", "minimum": 0}}},
    "plan_items": {"type": "array", "maxItems": 7, "items": {"$ref": "#/$defs/course"}},
    "charts": {"type": "array", "maxItems": 4, "items": {"$ref": "#/$defs/chart"}},
    "extra_sections": {"type": "array", "maxItems": 0},
    "evidence": {"$ref": "#/$defs/evidence"},
    "provider_calls": {"type": "integer", "const": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
      "then": {
        "properties": {
          "decision": {"type": "null"},
          "progression_dimension": {"type": "null"},
          "plan_items": {"maxItems": 0},
          "charts": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]},
      "then": {
        "properties": {
          "decision": {"type": "string", "enum": ["advance", "hold", "deload"]},
          "progression_dimension": {"type": "string", "enum": ["distance", "intensity", "none"]}
        }
      }
    }
  ],
  "$defs": {
    "course": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "activity_kind", "name", "purpose", "load_level", "garmin_mapping_status", "rpe", "downgrade_rule", "stop_conditions"],
      "properties": {
        "date": {"type": "string", "format": "date"}, "activity_kind": {"type": "string", "enum": ["running", "climbing", "rest"]},
        "name": {"type": "string"}, "purpose": {"type": "string"}, "load_level": {"type": "string"}, "garmin_mapping_status": {"type": "string"},
        "distance_km": {"type": "number"}, "duration_minutes": {"type": "number"}, "pace_min_seconds_per_km": {"type": "number"}, "pace_max_seconds_per_km": {"type": "number"},
        "heart_rate_min_bpm": {"type": "number"}, "heart_rate_max_bpm": {"type": "number"}, "rpe": {"type": "number"}, "steps": {"type": "array", "items": {"type": "object"}},
        "downgrade_rule": {"type": "string"}, "stop_conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "chart": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "title", "unit", "points", "source_refs"],
      "properties": {
        "role": {"type": "string", "enum": ["weekly_sleep", "weekly_rhr", "weekly_hrv", "weekly_activity_duration"]}, "title": {"type": "string"}, "unit": {"type": "string"},
        "points": {"type": "array", "minItems": 2, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "string", "format": "date"}, "y": {"type": "number"}}}},
        "source_refs": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["count", "refs"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "refs": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "sha256", "claim"],
            "properties": {
              "id": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "claim": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
