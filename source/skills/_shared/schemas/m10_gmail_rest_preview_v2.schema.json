{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m10_gmail_rest_preview_v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "transport", "parent_marker_sha256",
    "parent_database_sha256", "parent_preview_output_id",
    "parent_preview_output_sha256", "completed_canary", "emails",
    "prior_api_calls", "prior_send_calls", "gmail_api_budget",
    "gmail_send_budget", "preview_sha256"
  ],
  "properties": {
    "schema_version": {"const": "m10_gmail_rest_preview_v2"},
    "batch_id": {"const": "m10-r07-gmail-rest-continuation"},
    "transport": {"const": "gmail_rest"},
    "parent_marker_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_database_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_preview_output_id": {"type": "integer", "minimum": 1},
    "parent_preview_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "completed_canary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id", "requested_message_id", "actual_message_id",
        "gmail_message_id", "eml_relative_path", "eml_sha256",
        "reconciliation_output_id", "reconciliation_output_sha256",
        "user_confirmed", "provider_calls", "send_calls"
      ],
      "properties": {
        "action_id": {"type": "integer", "minimum": 1},
        "requested_message_id": {"type": "string", "pattern": "^<trainlab\\.[0-9a-f]{64}@trainlab\\.invalid>$"},
        "actual_message_id": {"type": "string", "pattern": "^<[^<>\\s@]+@[^<>\\s@]+>$"},
        "gmail_message_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,256}$"},
        "eml_relative_path": {"type": "string", "minLength": 1},
        "eml_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reconciliation_output_id": {"type": "integer", "minimum": 1},
        "reconciliation_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "user_confirmed": {"const": true},
        "provider_calls": {"const": 4},
        "send_calls": {"const": 1}
      }
    },
    "emails": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ordinal", "prior_source_output_id", "prior_source_output_sha256",
          "source_output_id", "source_output_sha256", "envelope_relative_path",
          "envelope_sha256", "recipient_sha256", "subject", "subject_sha256",
          "requested_message_id", "mime_sha256", "request_sha256"
        ],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 2, "maximum": 8},
          "prior_source_output_id": {"type": "integer", "minimum": 1},
          "prior_source_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_output_id": {"type": "integer", "minimum": 1},
          "source_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "envelope_relative_path": {"type": "string", "minLength": 1},
          "envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "recipient_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "subject": {"type": "string", "minLength": 1},
          "subject_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "requested_message_id": {"type": "string", "pattern": "^<trainlab\\.[0-9a-f]{64}@trainlab\\.invalid>$"},
          "mime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "prior_api_calls": {"const": 4},
    "prior_send_calls": {"const": 1},
    "gmail_api_budget": {"const": 129},
    "gmail_send_budget": {"const": 8},
    "preview_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
