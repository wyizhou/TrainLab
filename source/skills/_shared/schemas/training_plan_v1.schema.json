{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/training_plan_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "items", "progression_rule", "progression_dimension", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "training_plan_v1"},
    "status": {"type": "string", "enum": ["succeeded", "blocked"]},
    "items": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/course_item"}},
    "progression_rule": {"type": "string", "enum": ["advance", "hold", "deload"]},
    "progression_dimension": {"type": "string", "enum": ["distance", "intensity", "none"]},
    "previous_week_distance_km": {"type": "number", "minimum": 0},
    "current_week_distance_km": {"type": "number", "minimum": 0},
    "previous_week_intensity_score": {"type": "number", "minimum": 0},
    "current_week_intensity_score": {"type": "number", "minimum": 0},
    "evidence_running_distance_km": {"type": "number", "minimum": 0},
    "evidence_caution_days": {"type": "integer", "minimum": 0, "maximum": 7},
    "evidence_daily_count": {"type": "integer", "minimum": 0, "maximum": 7},
    "provider_calls": {"type": "integer", "const": 0}
  },
  "$defs": {
    "step": {"type": "object", "additionalProperties": false, "required": ["name", "end_condition"], "properties": {"name": {"type": "string", "minLength": 1}, "end_condition": {"type": "string", "minLength": 1}}},
    "base": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "activity_kind", "name", "purpose", "load_level", "garmin_mapping_status", "rpe", "downgrade_rule", "stop_conditions"],
      "properties": {
        "date": {"type": "string", "format": "date"}, "activity_kind": {"type": "string", "enum": ["running", "climbing", "rest"]}, "name": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "load_level": {"type": "string", "enum": ["low", "moderate", "hard"]}, "garmin_mapping_status": {"type": "string", "enum": ["candidate", "requires_review", "unsupported_skip"]},
        "distance_km": {"type": "number", "exclusiveMinimum": 0}, "duration_minutes": {"type": "number", "exclusiveMinimum": 0}, "pace_min_seconds_per_km": {"type": "number", "exclusiveMinimum": 0}, "pace_max_seconds_per_km": {"type": "number", "exclusiveMinimum": 0}, "heart_rate_min_bpm": {"type": "number", "exclusiveMinimum": 0}, "heart_rate_max_bpm": {"type": "number", "exclusiveMinimum": 0}, "rpe": {"type": "number", "minimum": 1, "maximum": 10}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}, "downgrade_rule": {"type": "string", "minLength": 1}, "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "course_item": {"oneOf": [
      {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"activity_kind": {"const": "running"}, "garmin_mapping_status": {"enum": ["candidate", "requires_review"]}}, "anyOf": [{"required": ["distance_km"]}, {"required": ["duration_minutes"]}]}]},
      {"allOf": [{"$ref": "#/$defs/base"}, {"required": ["duration_minutes"], "properties": {"activity_kind": {"const": "climbing"}, "garmin_mapping_status": {"const": "unsupported_skip"}}}]},
      {"allOf": [{"$ref": "#/$defs/base"}, {"properties": {"activity_kind": {"const": "rest"}, "garmin_mapping_status": {"const": "unsupported_skip"}}, "not": {"anyOf": [{"required": ["distance_km"]}, {"required": ["duration_minutes"]}]}}]}
    ]}
  }
}
