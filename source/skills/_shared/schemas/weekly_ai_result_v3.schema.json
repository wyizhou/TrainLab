{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_ai_result_v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "period", "week_conclusion", "health_review", "all_activity_review", "technical_findings", "plan_comparison", "climbing_and_combined_load", "progression_decision", "training_plan", "uncertainty", "evidence_refs", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "weekly_ai_result_v3"},
    "status": {"type": "string", "enum": ["succeeded", "blocked"]},
    "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "week_conclusion": {"type": "string", "minLength": 1},
    "health_review": {"type": "string", "minLength": 1},
    "all_activity_review": {"type": "string", "minLength": 1},
    "technical_findings": {
      "type": "array", "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["activity_refs", "observation", "interpretation", "planning_implication", "confidence", "evidence_refs", "limitations"],
        "properties": {
          "activity_refs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
          "observation": {"type": "string", "minLength": 1},
          "interpretation": {"type": "string", "minLength": 1},
          "planning_implication": {"type": "string", "minLength": 1},
          "confidence": {"type": "string", "enum": ["high", "moderate", "low"]},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "plan_comparison": {"type": "string", "minLength": 1},
    "climbing_and_combined_load": {"type": "string", "minLength": 1},
    "progression_decision": {"type": "string", "enum": ["advance", "hold", "deload"]},
    "training_plan": {"$ref": "https://trainlab.local/schemas/training_plan_v3.schema.json"},
    "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "provider_calls": {"type": "integer", "const": 0}
  }
}
