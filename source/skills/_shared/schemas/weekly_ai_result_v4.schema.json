{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_ai_result_v4.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "period", "plan_dates", "decision", "provider_calls", "external_actions"],
  "properties": {
    "schema_version": {"type": "string", "const": "weekly_ai_result_v4"},
    "status": {"type": "string", "const": "succeeded"},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_start_date", "activity_end_date", "sleep_wake_start_date", "sleep_wake_end_date", "plan_start_date", "plan_end_date"],
      "properties": {
        "activity_start_date": {"type": "string", "format": "date"},
        "activity_end_date": {"type": "string", "format": "date"},
        "sleep_wake_start_date": {"type": "string", "format": "date"},
        "sleep_wake_end_date": {"type": "string", "format": "date"},
        "plan_start_date": {"type": "string", "format": "date"},
        "plan_end_date": {"type": "string", "format": "date"}
      }
    },
    "plan_dates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day_1", "day_2", "day_3", "day_4", "day_5", "day_6", "day_7"],
      "properties": {
        "day_1": {"type": "string", "format": "date"},
        "day_2": {"type": "string", "format": "date"},
        "day_3": {"type": "string", "format": "date"},
        "day_4": {"type": "string", "format": "date"},
        "day_5": {"type": "string", "format": "date"},
        "day_6": {"type": "string", "format": "date"},
        "day_7": {"type": "string", "format": "date"}
      }
    },
    "decision": {"$ref": "https://trainlab.local/schemas/weekly_model_decision_v1.schema.json"},
    "provider_calls": {"type": "integer", "const": 0},
    "external_actions": {"type": "integer", "const": 0}
  }
}
