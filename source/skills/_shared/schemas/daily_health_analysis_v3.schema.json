{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/daily_health_analysis_v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "report_date", "review_date", "sleep_wake_date", "safety", "health_summary", "sleep_analysis", "recovery_analysis", "health_alert", "uncertainty", "evidence_refs", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "daily_health_analysis_v3"},
    "status": {"type": "string", "enum": ["succeeded", "blocked"]},
    "report_date": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"},
    "sleep_wake_date": {"type": "string", "format": "date"},
    "safety": {"type": "string", "enum": ["ready", "caution", "blocked"]},
    "health_summary": {"type": "string", "minLength": 1},
    "sleep_analysis": {"type": "string", "minLength": 1},
    "recovery_analysis": {"type": "string", "minLength": 1},
    "health_alert": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["severity", "message", "blocks_external_execution"],
      "properties": {
        "severity": {"type": "string", "enum": ["caution", "red_flag"]},
        "message": {"type": "string", "minLength": 1},
        "blocks_external_execution": {"type": "boolean"}
      }
    },
    "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
    "provider_calls": {"type": "integer", "const": 0}
  }
}
