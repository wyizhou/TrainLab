{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/training_goal_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "current_goal", "weekly_availability", "training_preferences", "constraints", "temporary_adjustment"],
  "properties": {
    "schema_version": {"type": "string", "const": "training_goal_v1"},
    "current_goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["competition_goal_and_date", "training_focus", "long_term_load_rule"],
      "properties": {
        "competition_goal_and_date": {"$ref": "#/$defs/long_text"},
        "training_focus": {"$ref": "#/$defs/long_text"},
        "long_term_load_rule": {"$ref": "#/$defs/long_text"}
      }
    },
    "weekly_availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"],
      "properties": {
        "monday": {"$ref": "#/$defs/short_text"},
        "tuesday": {"$ref": "#/$defs/short_text"},
        "wednesday": {"$ref": "#/$defs/short_text"},
        "thursday": {"$ref": "#/$defs/short_text"},
        "friday": {"$ref": "#/$defs/short_text"},
        "saturday": {"$ref": "#/$defs/short_text"},
        "sunday": {"$ref": "#/$defs/short_text"}
      }
    },
    "training_preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intensity_preference", "progression_rule", "hard_load_rule", "missed_session_rule"],
      "properties": {
        "intensity_preference": {"type": "integer", "minimum": 1, "maximum": 5},
        "progression_rule": {"$ref": "#/$defs/long_text"},
        "hard_load_rule": {"$ref": "#/$defs/long_text"},
        "missed_session_rule": {"$ref": "#/$defs/long_text"}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_limitations", "recovery_signals", "red_flag_preference"],
      "properties": {
        "known_limitations": {"$ref": "#/$defs/long_text"},
        "recovery_signals": {"$ref": "#/$defs/long_text"},
        "red_flag_preference": {"$ref": "#/$defs/long_text"}
      }
    },
    "temporary_adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjustment", "valid_period"],
      "properties": {
        "adjustment": {"$ref": "#/$defs/long_text"},
        "valid_period": {"$ref": "#/$defs/long_text"}
      }
    }
  },
  "$defs": {
    "short_text": {"type": "string", "minLength": 1, "maxLength": 500},
    "long_text": {"type": "string", "minLength": 1, "maxLength": 2000}
  }
}
