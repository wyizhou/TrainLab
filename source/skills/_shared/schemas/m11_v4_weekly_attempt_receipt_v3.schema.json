{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/m11_v4_weekly_attempt_receipt_v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "error_code", "attempt", "model_calls", "wire_result_sha256", "ai_result_sha256", "reader_result_sha256", "provider_calls", "external_actions"],
  "properties": {
    "schema_version": {"type": "string", "const": "m11_v4_weekly_attempt_receipt_v3"},
    "status": {"type": "string", "enum": ["succeeded", "blocked"]},
    "error_code": {"type": ["string", "null"]},
    "attempt": {"type": "integer", "const": 1},
    "model_calls": {"type": "integer", "const": 1},
    "wire_result_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "ai_result_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "reader_result_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "provider_calls": {"type": "integer", "const": 0},
    "external_actions": {"type": "integer", "const": 0}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
