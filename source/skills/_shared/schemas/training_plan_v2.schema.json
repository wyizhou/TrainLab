{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/training_plan_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "progression_rule", "progression_dimension", "sos_omission_reason", "items", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "training_plan_v2"},
    "status": {"type": "string", "enum": ["succeeded", "blocked"]},
    "progression_rule": {"type": "string", "enum": ["advance", "hold", "deload"]},
    "progression_dimension": {"type": "string", "enum": ["distance", "intensity", "none"]},
    "sos_omission_reason": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sos_reason"}]},
    "sos_schedule_reason": {"type": ["string", "null"]},
    "items": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/course"}},
    "provider_calls": {"type": "integer", "const": 0}
  },
  "$defs": {
    "sos_reason": {
      "type": "object", "additionalProperties": false,
      "required": ["reason_code", "explanation", "evidence_refs"],
      "properties": {
        "reason_code": {"type": "string", "enum": ["deload", "red_flag", "insufficient_recovery"]},
        "explanation": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "seconds_per_km", "observed_date", "activity_output_id", "activity_sha256", "label"],
      "properties": {
        "schema_version": {"type": "string", "const": "comparable_pace_reference_v1"},
        "seconds_per_km": {"type": "number", "exclusiveMinimum": 0},
        "observed_date": {"type": "string", "format": "date"},
        "activity_output_id": {"type": "integer", "minimum": 1},
        "activity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "label": {"type": "string", "const": "历史参考，不是目标配速"}
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "name", "instruction", "end_condition"],
      "properties": {
        "phase": {"type": "string", "enum": ["warmup", "main", "recovery", "cooldown", "checklist"]},
        "name": {"type": "string", "minLength": 1},
        "instruction": {"type": "string", "minLength": 1},
        "end_condition": {"type": "string", "minLength": 1},
        "repeats": {"type": "integer", "minimum": 1},
        "duration_minutes": {"type": "number", "exclusiveMinimum": 0},
        "distance_km": {"type": "number", "exclusiveMinimum": 0},
        "rpe_min": {"type": "number", "minimum": 1, "maximum": 10},
        "rpe_max": {"type": "number", "minimum": 1, "maximum": 10}
      }
    },
    "course": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "activity_kind", "session_type", "name", "purpose", "load_level", "garmin_mapping_status", "rpe_min", "rpe_max", "feel_guidance", "steps", "start_gate", "technique_notes", "downgrade_rule", "stop_conditions"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "activity_kind": {"type": "string", "enum": ["running", "climbing", "rest"]},
        "session_type": {"type": "string", "enum": ["recovery_run", "easy_run", "long_easy", "sos_threshold", "sos_cruise_intervals", "sos_hills", "climbing_technique", "climbing_hard", "rest"]},
        "name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "load_level": {"type": "string", "enum": ["low", "moderate", "hard"]},
        "garmin_mapping_status": {"type": "string", "enum": ["candidate", "requires_review", "unsupported_skip"]},
        "duration_minutes": {"type": "number", "exclusiveMinimum": 0},
        "distance_km": {"type": "number", "exclusiveMinimum": 0},
        "rpe_min": {"type": "number", "minimum": 1, "maximum": 10},
        "rpe_max": {"type": "number", "minimum": 1, "maximum": 10},
        "feel_guidance": {"type": "string", "minLength": 1},
        "reference_pace": {"$ref": "#/$defs/reference"},
        "steps": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/step"}},
        "start_gate": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "technique_notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "downgrade_rule": {"type": "string", "minLength": 1},
        "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
