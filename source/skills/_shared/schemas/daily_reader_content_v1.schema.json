{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/daily_reader_content_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "title", "report_date", "activity_date", "sleep_wake_date", "fixed_course_ref", "sections", "charts", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "daily_reader_content_v1"},
    "status": {"type": "string", "const": "ready"},
    "title": {"type": "string", "minLength": 1},
    "report_date": {"type": "string", "format": "date"},
    "activity_date": {"type": "string", "format": "date"},
    "sleep_wake_date": {"type": "string", "format": "date"},
    "fixed_course_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_output_id", "plan_output_sha256", "course_sha256"],
      "properties": {
        "plan_output_id": {"type": "integer", "minimum": 1},
        "plan_output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "course_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "sections": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/section"}},
    "charts": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/chart"}},
    "provider_calls": {"type": "integer", "const": 0}
  },
  "$defs": {
    "section": {"type": "object", "additionalProperties": false, "required": ["section_code", "heading", "paragraphs", "items"], "properties": {"section_code": {"type": "string"}, "heading": {"type": "string", "minLength": 1}, "paragraphs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "items": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "chart": {"type": "object", "additionalProperties": false, "required": ["chart_code", "title", "alt_text", "data"], "properties": {"chart_code": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "alt_text": {"type": "string", "minLength": 1}, "data": {"type": "array"}}}
  }
}
