{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/workflow_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "outcome", "workflow_key", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "workflow_receipt_v1"},
    "status": {"type": "string", "enum": ["succeeded", "blocked", "failed"]},
    "outcome": {"type": "string", "enum": ["daily_complete", "daily_weekly_complete", "blocked", "failed"]},
    "workflow_key": {"type": "string", "pattern": "^(daily|weekly):[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"},
    "provider_calls": {"type": "integer", "const": 0},
    "summary_output_id": {"type": "integer", "minimum": 1},
    "review_output_id": {"type": "integer", "minimum": 1},
    "sync_output_id": {"type": "integer", "minimum": 1},
    "history_output_id": {"type": "integer", "minimum": 1},
    "plan_output_id": {"type": "integer", "minimum": 1},
    "gts_output_id": {"type": "integer", "minimum": 1},
    "render_output_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "email_output_id": {"type": "integer", "minimum": 1},
    "gts_prepared": {"type": "boolean"},
    "gts_actions": {"type": "integer", "minimum": 0},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "error_code": {"type": "string"}
  }
}
