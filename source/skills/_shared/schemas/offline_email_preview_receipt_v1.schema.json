{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/offline_email_preview_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "render_sha256", "mime_sha256", "requested_message_id", "actual_message_id", "files", "provider_calls", "external_actions"],
  "properties": {
    "schema_version": {"type": "string", "const": "offline_email_preview_receipt_v1"},
    "status": {"type": "string", "const": "succeeded"},
    "render_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_message_id": {"type": "string", "pattern": "^<trainlab\\.v2\\.[0-9a-f]{64}@trainlab\\.invalid>$"},
    "actual_message_id": {"type": "string", "pattern": "^<trainlab\\.v2\\.[0-9a-f]{64}@trainlab\\.invalid>$"},
    "files": {"type": "array", "const": ["message.eml"]},
    "provider_calls": {"type": "integer", "const": 0},
    "external_actions": {"type": "integer", "const": 0}
  }
}
