{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m10_mcp_call_result_v1.schema.json",
  "title": "M10 bounded MCP call result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider",
    "tool_name",
    "request_sha256",
    "external_action_ids",
    "message_id",
    "matched_message_ids",
    "match_count"
  ],
  "properties": {
    "schema_version": {"const": "m10_mcp_call_result_v1"},
    "provider": {"const": "gmail"},
    "tool_name": {"enum": ["send_email", "search_emails"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "external_action_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "message_id": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "matched_message_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "match_count": {"type": "integer", "minimum": 0, "maximum": 10}
  }
}
