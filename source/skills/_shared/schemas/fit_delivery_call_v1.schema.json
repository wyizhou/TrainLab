{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fit_delivery_call_v1"
    },
    "action_key": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "arguments": {
      "type": "object"
    },
    "authorization_key": {
      "type": "string",
      "minLength": 1
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "schema_version",
    "action_key",
    "tool",
    "arguments",
    "authorization_key",
    "ordinal"
  ],
  "additionalProperties": false
}
