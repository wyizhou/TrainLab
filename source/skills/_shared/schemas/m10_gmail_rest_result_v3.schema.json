{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m10_gmail_rest_result_v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "status", "action_id", "ordinal",
    "requested_message_id", "actual_message_id", "gmail_message_id",
    "eml_relative_path", "eml_sha256", "content_verified",
    "confirmation_kind", "provider_calls", "send_calls", "completed_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "m10_gmail_rest_result_v3"},
    "batch_id": {"const": "m10-r08-gmail-rest-corrected-subjects"},
    "status": {"const": "succeeded"},
    "action_id": {"type": "integer", "minimum": 1},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 8},
    "requested_message_id": {"type": "string", "pattern": "^<trainlab\\.[0-9a-f]{64}@trainlab\\.invalid>$"},
    "actual_message_id": {"type": "string", "pattern": "^<[^<>\\s@]+@[^<>\\s@]+>$"},
    "gmail_message_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,256}$"},
    "eml_relative_path": {"type": "string", "minLength": 1},
    "eml_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "content_verified": {"const": true},
    "confirmation_kind": {"const": "provider_query"},
    "provider_calls": {"type": "integer", "minimum": 0, "maximum": 16},
    "send_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "completed_at_utc": {"type": "string", "format": "date-time"}
  }
}
