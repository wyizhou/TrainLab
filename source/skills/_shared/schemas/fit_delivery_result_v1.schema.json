{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fit_delivery_result_v1"
    },
    "action_key": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "success"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "action_key",
    "status",
    "request_sha256",
    "evidence"
  ],
  "additionalProperties": false
}
