{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/email_chart_v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["chart_type", "role", "title", "unit", "source_refs"],
  "properties": {
    "chart_type": {"enum": ["series", "stacked_duration"]},
    "role": {"enum": ["daily_activity_hr_zones", "daily_sleep_stages", "daily_activity_heart_rate", "weekly_sleep", "weekly_rhr", "weekly_hrv", "weekly_running_distance", "weekly_activity_duration", "weekly_activity_hr_zones"]},
    "title": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "points": {"type": "array", "minItems": 2, "maxItems": 2880, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": ["integer", "string"]}, "y": {"type": "number"}}}},
    "segments": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["label", "duration_seconds", "percentage"], "properties": {"label": {"type": "string", "minLength": 1}, "duration_seconds": {"type": "number", "minimum": 0}, "percentage": {"type": "number", "minimum": 0, "maximum": 100}}}},
    "percentage_source": {"const": "derived_from_provider_duration"},
    "source_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "properties": {"raw_file_id": {"type": "integer", "minimum": 1}, "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "output_id": {"type": "integer", "minimum": 1}, "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "oneOf": [{"required": ["raw_file_id", "raw_sha256"]}, {"required": ["output_id", "output_sha256"]}]}}
  },
  "allOf": [
    {"if": {"properties": {"chart_type": {"const": "series"}}}, "then": {"required": ["points"], "not": {"required": ["segments"]}}},
    {"if": {"properties": {"chart_type": {"const": "stacked_duration"}}}, "then": {"required": ["segments", "percentage_source"], "not": {"required": ["points"]}}},
    {"if": {"properties": {"role": {"enum": ["daily_activity_hr_zones", "daily_sleep_stages", "weekly_activity_hr_zones"]}}, "required": ["role"]}, "then": {"properties": {"chart_type": {"const": "stacked_duration"}, "unit": {"const": "seconds"}}}},
    {"if": {"properties": {"role": {"const": "daily_activity_heart_rate"}}, "required": ["role"]}, "then": {"properties": {"chart_type": {"const": "series"}, "unit": {"const": "bpm"}}}},
    {"if": {"properties": {"role": {"const": "weekly_sleep"}}, "required": ["role"]}, "then": {"properties": {"chart_type": {"const": "series"}, "unit": {"const": "hours"}}}},
    {"if": {"properties": {"role": {"const": "weekly_rhr"}}, "required": ["role"]}, "then": {"properties": {"chart_type": {"const": "series"}, "unit": {"const": "bpm"}}}},
    {"if": {"properties": {"role": {"const": "weekly_hrv"}}, "required": ["role"]}, "then": {"properties": {"chart_type": {"const": "series"}, "unit": {"const": "ms"}}}},
    {"if": {"properties": {"role": {"const": "weekly_running_distance"}}, "required": ["role"]}, "then": {"properties": {"chart_type": {"const": "series"}, "unit": {"const": "km"}}}},
    {"if": {"properties": {"role": {"const": "weekly_activity_duration"}}, "required": ["role"]}, "then": {"properties": {"chart_type": {"const": "series"}, "unit": {"const": "minutes"}}}}
  ]
}
