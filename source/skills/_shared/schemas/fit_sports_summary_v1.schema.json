{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "fit_sports_summary_v1"
    },
    "core_conclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1,
      "maxItems": 5
    },
    "running_analysis": {
      "type": "object",
      "properties": {
        "overview": {
          "$ref": "#/$defs/claim"
        },
        "technique": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          },
          "minItems": 0,
          "maxItems": 3
        },
        "plan_comparison": {
          "$ref": "#/$defs/claim"
        }
      },
      "required": [
        "overview",
        "technique",
        "plan_comparison"
      ],
      "additionalProperties": false,
      "description": "Use only independently projected running evidence and running history. Never other-sport load or alternative plans."
    },
    "other_sports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activity_ref": {
            "type": "string",
            "minLength": 1
          },
          "session_ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "explanation": {
            "$ref": "#/$defs/claim"
          }
        },
        "required": [
          "activity_ref",
          "session_ordinal",
          "explanation"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "data_limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "maxItems": 20
    },
    "safety": {
      "type": "object",
      "properties": {
        "performance_is_not_health_clearance": {
          "type": "boolean",
          "const": true
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "performance_is_not_health_clearance",
        "note"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "core_conclusions",
    "running_analysis",
    "other_sports",
    "data_limitations",
    "safety"
  ],
  "additionalProperties": false,
  "description": "All-sport weekly explanation. Host supplies the complete inventory/statistics/dates and adds the original fixed plan. No second plan or edits. At most three running technique findings. Only recorded historical heart rate/session zones; no future BPM, invented zones or health clearance. GPS alone does not prove weather or gradient.",
  "$defs": {
    "claim": {
      "$ref": "urn:trainlab:fit_running_plan_v1#/$defs/claim"
    }
  }
}
