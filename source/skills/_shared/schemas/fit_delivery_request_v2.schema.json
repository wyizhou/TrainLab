{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fit_delivery_request_v2"
    },
    "action_key": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "gmail",
        "gmail_label_ensure",
        "gmail_label_apply"
      ]
    },
    "source_key": {
      "type": "string",
      "minLength": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d\\d-\\d\\d$"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "action_key",
    "kind",
    "source_key",
    "source_sha256",
    "date",
    "payload"
  ],
  "additionalProperties": false
}
