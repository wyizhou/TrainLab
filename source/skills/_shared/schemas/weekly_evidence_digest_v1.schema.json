{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_evidence_digest_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "period", "daily_count", "daily_refs", "health_summary", "activity_summary", "history_count", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "weekly_evidence_digest_v1"},
    "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "daily_count": {"type": "integer", "const": 7},
    "daily_refs": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "object"}},
    "health_summary": {"type": "object"},
    "activity_summary": {"type": "object"},
    "history_count": {"type": "integer", "minimum": 0, "maximum": 4},
    "provider_calls": {"type": "integer", "const": 0}
  }
}
