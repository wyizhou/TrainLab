{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/activity_technical_evidence_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "activity_inventory_id", "raw_file_id", "raw_sha256", "climbing_intensity", "metrics", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "activity_technical_evidence_v1"},
    "status": {"type": "string", "enum": ["ready", "blocked"]},
    "activity_inventory_id": {"type": "integer", "minimum": 1},
    "raw_file_id": {"type": "integer", "minimum": 1},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "climbing_intensity": {"type": "string", "enum": ["not_climbing", "provider_supported", "user_rpe_supported", "intensity_unknown"]},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "provider_calls": {"type": "integer", "const": 0}
  },
  "$defs": {
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_code", "status", "value", "unit", "method", "coverage", "confidence", "evidence_refs", "limitations"],
      "properties": {
        "metric_code": {"type": "string", "enum": ["provider_hr_zone_duration_v1", "explicit_work_lap_stability_v1", "aerobic_decoupling_power_hr_v1", "running_dynamics_front_back_v1"]},
        "status": {"type": "string", "enum": ["available", "not_applicable", "insufficient_data"]},
        "value": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/provider_zone_value"},
            {"$ref": "#/$defs/work_lap_value"},
            {"type": "number"},
            {"$ref": "#/$defs/running_dynamics_value"}
          ]
        },
        "unit": {"type": ["string", "null"]},
        "method": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method_code", "method_version", "segment", "exclusions"],
          "properties": {
            "method_code": {"type": "string", "minLength": 1},
            "method_version": {"type": "string", "minLength": 1},
            "segment": {"type": "string"},
            "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence": {"type": "string", "enum": ["high", "moderate", "low", "none"]},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "not_applicable"}}},
          "then": {"properties": {"value": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "insufficient_data"}}},
          "then": {"properties": {"value": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "available"}, "metric_code": {"const": "provider_hr_zone_duration_v1"}}},
          "then": {"properties": {"value": {"$ref": "#/$defs/provider_zone_value"}}}
        },
        {
          "if": {"properties": {"status": {"const": "available"}, "metric_code": {"const": "explicit_work_lap_stability_v1"}}},
          "then": {"properties": {"value": {"$ref": "#/$defs/work_lap_value"}}}
        },
        {
          "if": {"properties": {"status": {"const": "available"}, "metric_code": {"const": "aerobic_decoupling_power_hr_v1"}}},
          "then": {"properties": {"value": {"type": "number"}}}
        },
        {
          "if": {"properties": {"status": {"const": "available"}, "metric_code": {"const": "running_dynamics_front_back_v1"}}},
          "then": {"properties": {"value": {"$ref": "#/$defs/running_dynamics_value"}}}
        }
      ]
    },
    "provider_zone_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durations_seconds", "percentages", "definition_sha256", "percentage_source"],
      "properties": {
        "durations_seconds": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "number", "minimum": 0}},
        "percentages": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "number", "minimum": 0, "maximum": 100}},
        "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "percentage_source": {"type": "string", "const": "derived_from_provider_duration"}
      }
    },
    "work_lap_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pace_cv_percent", "work_lap_count"],
      "properties": {
        "pace_cv_percent": {"type": "number", "minimum": 0},
        "work_lap_count": {"type": "integer", "minimum": 3}
      }
    },
    "running_dynamics_value": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cadence_spm": {"$ref": "#/$defs/front_back_value"},
        "step_length_m": {"$ref": "#/$defs/front_back_value"},
        "ground_contact_time_ms": {"$ref": "#/$defs/front_back_value"},
        "vertical_oscillation_mm": {"$ref": "#/$defs/front_back_value"},
        "vertical_ratio_pct": {"$ref": "#/$defs/front_back_value"},
        "power_watts": {"$ref": "#/$defs/front_back_value"}
      }
    },
    "front_back_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_half", "second_half", "change_percent"],
      "properties": {
        "first_half": {"type": "number"},
        "second_half": {"type": "number"},
        "change_percent": {"type": "number"}
      }
    }
  }
}
