{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_email_render_v3.schema.json",
  "$ref": "#/$defs/render",
  "$defs": {"render": {"type": "object", "additionalProperties": false, "required": ["schema_version", "kind", "subject", "text", "html", "view_sha256", "asset_manifest", "provider_calls"], "properties": {"schema_version": {"const": "weekly_email_render_v3"}, "kind": {"const": "weekly"}, "subject": {"type": "string", "pattern": "^TrainLab · 每周总结 · [0-9]{4}-[0-9]{2}-[0-9]{2}~[0-9]{4}-[0-9]{2}-[0-9]{2}$"}, "text": {"type": "string", "minLength": 1}, "html": {"type": "string", "minLength": 1, "maxLength": 81920}, "view_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "asset_manifest": {"$ref": "https://trainlab.local/schemas/email_inline_asset_manifest_v1.schema.json"}, "provider_calls": {"const": 0}}}}
}
