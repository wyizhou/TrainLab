{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m10_gmail_rest_result_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "status", "action_id", "ordinal",
    "message_id", "gmail_message_id", "eml_relative_path", "eml_sha256",
    "content_verified", "provider_calls", "send_calls", "completed_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "m10_gmail_rest_result_v1"},
    "batch_id": {"const": "m10-r06-gmail-rest"},
    "status": {"enum": ["succeeded", "blocked", "unknown"]},
    "action_id": {"type": "integer", "minimum": 1},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 8},
    "message_id": {"type": "string", "pattern": "^<trainlab\\.[0-9a-f]{64}@trainlab\\.invalid>$"},
    "gmail_message_id": {"type": ["string", "null"]},
    "eml_relative_path": {"type": ["string", "null"]},
    "eml_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "content_verified": {"type": "boolean"},
    "provider_calls": {"type": "integer", "minimum": 0, "maximum": 16},
    "send_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "completed_at_utc": {"type": "string", "format": "date-time"}
  }
}
