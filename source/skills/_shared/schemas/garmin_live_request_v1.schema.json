{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/garmin_live_request_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "timezone", "run_date", "health_activity_date",
    "sleep_wake_date", "mcp_commit", "garminconnect_version", "mcp_version",
    "base_calls", "optional_tools", "budgets", "cached_tokens_only", "retries"
  ],
  "properties": {
    "schema_version": {"const": "garmin_live_request_v1"},
    "timezone": {"const": "Asia/Hong_Kong"},
    "run_date": {"const": "2026-08-17"},
    "health_activity_date": {"const": "2026-08-16"},
    "sleep_wake_date": {"const": "2026-08-17"},
    "mcp_commit": {"const": "3610be6feed93088d85b0f35aba9d7d07c2505a7"},
    "garminconnect_version": {"const": "0.3.9"},
    "mcp_version": {"const": "1.29.0"},
    "base_calls": {
      "const": [
        {"tool": "get_rhr_day", "arguments": {"date": "2026-08-16"}},
        {"tool": "get_hrv_data", "arguments": {"date": "2026-08-16", "return_timeseries": false}},
        {"tool": "get_heart_rates", "arguments": {"date": "2026-08-16"}},
        {"tool": "get_vo2max_trend", "arguments": {"start_date": "2026-08-16", "end_date": "2026-08-16"}},
        {"tool": "get_weigh_ins", "arguments": {"start_date": "2026-08-16", "end_date": "2026-08-16"}},
        {"tool": "get_sleep_data", "arguments": {"date": "2026-08-17"}},
        {"tool": "get_activities_by_date", "arguments": {"start_date": "2026-08-16", "end_date": "2026-08-16", "page": 0, "page_size": 10}}
      ]
    },
    "optional_tools": {"const": ["download_activity_file", "get_activity_weather"]},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mcp_tool_calls", "provider_entries", "activity_ids", "fit_files", "weather_calls", "new_files", "wall_seconds"],
      "properties": {
        "mcp_tool_calls": {"const": 11},
        "provider_entries": {"const": 12},
        "activity_ids": {"const": 10},
        "fit_files": {"const": 2},
        "weather_calls": {"const": 2},
        "new_files": {"const": 11},
        "wall_seconds": {"const": 90}
      }
    },
    "cached_tokens_only": {"const": true},
    "retries": {"const": 0}
  }
}
