{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "m10_gmail_rest_intent_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "batch_id", "action_id", "ordinal", "message_id",
    "mime_sha256", "request_sha256", "send_started", "provider_calls",
    "send_calls", "created_at_utc", "updated_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "m10_gmail_rest_intent_v1"},
    "batch_id": {"const": "m10-r06-gmail-rest"},
    "action_id": {"type": "integer", "minimum": 1},
    "ordinal": {"type": "integer", "minimum": 1, "maximum": 8},
    "message_id": {"type": "string", "pattern": "^<trainlab\\.[0-9a-f]{64}@trainlab\\.invalid>$"},
    "mime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "send_started": {"type": "boolean"},
    "provider_calls": {"type": "integer", "minimum": 0, "maximum": 16},
    "send_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "updated_at_utc": {"type": "string", "format": "date-time"}
  }
}
