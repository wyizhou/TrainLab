{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/sync_summary_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "file_count", "manifest_sha256", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "sync_summary_v1"},
    "status": {"type": "string", "enum": ["indexed", "blocked"]},
    "file_count": {"type": "integer", "minimum": 0},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_calls": {"type": "integer", "const": 0},
    "error_code": {"type": "string"}
  }
}
