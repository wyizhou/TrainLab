{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/recent_trend_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "days_available", "sleep", "recovery", "running", "data_gaps", "sha256"],
  "properties": {
    "schema_version": {"const": "recent_trend_v1"},
    "days_available": {"type": "integer", "minimum": 0, "maximum": 14},
    "sleep": {"$ref": "#/$defs/sleep_summary"},
    "recovery": {"$ref": "#/$defs/recovery_summary"},
    "running": {"$ref": "#/$defs/running_summary"},
    "data_gaps": {"type": "array", "items": {"type": "string"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "sleep_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["average_hours", "insufficient_days", "consecutive_insufficient_days"],
      "properties": {
        "average_hours": {"type": ["number", "null"], "minimum": 0},
        "insufficient_days": {"type": "integer", "minimum": 0},
        "consecutive_insufficient_days": {"type": "integer", "minimum": 0}
      }
    },
    "recovery_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caution_days", "rhr_average", "rhr_change", "hrv_average", "hrv_change"],
      "properties": {
        "caution_days": {"type": "integer", "minimum": 0},
        "rhr_average": {"type": ["number", "null"], "minimum": 0},
        "rhr_change": {"type": ["number", "null"]},
        "hrv_average": {"type": ["number", "null"], "minimum": 0},
        "hrv_change": {"type": ["number", "null"]}
      }
    },
    "running_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distance_km", "activity_count", "activity_days"],
      "properties": {
        "distance_km": {"type": "number", "minimum": 0},
        "activity_count": {"type": "integer", "minimum": 0},
        "activity_days": {"type": "integer", "minimum": 0}
      }
    }
  }
}
