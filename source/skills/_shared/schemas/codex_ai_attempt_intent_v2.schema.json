{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/codex_ai_attempt_intent_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt", "created_at_utc", "timeout_seconds",
    "max_log_bytes", "command_contract", "prior_attempt_receipt_sha256",
    "canary_receipt_sha256", "context_sha256", "prompt_sha256",
    "wire_schema_sha256", "business_schema_sha256", "provider_calls",
    "external_actions"
  ],
  "properties": {
    "schema_version": {"const": "codex_ai_attempt_intent_v2"},
    "attempt": {"const": 4},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 180},
    "max_log_bytes": {"type": "integer", "minimum": 1, "maximum": 2097152},
    "command_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ephemeral", "ignore_user_config", "sandbox", "json_events", "output_schema"],
      "properties": {
        "ephemeral": {"const": true},
        "ignore_user_config": {"const": true},
        "sandbox": {"const": "read-only"},
        "json_events": {"const": true},
        "output_schema": {"const": "daily_ai_result_codex_v2"}
      }
    },
    "prior_attempt_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canary_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "context_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "wire_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "business_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_calls": {"const": 0},
    "external_actions": {"const": 0}
  }
}
