{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/recent_health_metrics_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "report_date", "review_date", "metrics", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "recent_health_metrics_v1"},
    "status": {"type": "string", "const": "ready"},
    "report_date": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vo2_max", "weight"],
      "properties": {
        "vo2_max": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "status", "value", "unit", "observed_date", "age_days", "selection_kind", "lookback_days", "raw_file_id", "sha256"],
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "ready"}}},
              "then": {
                "properties": {
                  "value": {"type": "number"},
                  "observed_date": {"type": "string"},
                  "age_days": {"type": "integer"},
                  "selection_kind": {"type": "string"},
                  "raw_file_id": {"type": "integer"},
                  "sha256": {"type": "string"}
                }
              },
              "else": {
                "properties": {
                  "value": {"type": "null"},
                  "observed_date": {"type": "null"},
                  "age_days": {"type": "null"},
                  "selection_kind": {"type": "null"},
                  "raw_file_id": {"type": "null"},
                  "sha256": {"type": "null"}
                }
              }
            }
          ],
          "properties": {
            "resource": {"type": "string", "const": "max_metrics"},
            "status": {"type": "string", "enum": ["ready", "missing"]},
            "value": {"type": ["number", "null"], "minimum": 10, "maximum": 100},
            "unit": {"type": "string", "const": "ml/kg/min"},
            "observed_date": {"type": ["string", "null"], "format": "date"},
            "age_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 30},
            "selection_kind": {"type": ["string", "null"], "enum": ["exact_date", "latest_prior", null]},
            "lookback_days": {"type": "integer", "const": 30},
            "raw_file_id": {"type": ["integer", "null"], "minimum": 1},
            "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "weight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource", "status", "value", "unit", "observed_date", "age_days", "selection_kind", "lookback_days", "raw_file_id", "sha256"],
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "ready"}}},
              "then": {
                "properties": {
                  "value": {"type": "number"},
                  "observed_date": {"type": "string"},
                  "age_days": {"type": "integer"},
                  "selection_kind": {"type": "string"},
                  "raw_file_id": {"type": "integer"},
                  "sha256": {"type": "string"}
                }
              },
              "else": {
                "properties": {
                  "value": {"type": "null"},
                  "observed_date": {"type": "null"},
                  "age_days": {"type": "null"},
                  "selection_kind": {"type": "null"},
                  "raw_file_id": {"type": "null"},
                  "sha256": {"type": "null"}
                }
              }
            }
          ],
          "properties": {
            "resource": {"type": "string", "const": "weigh_ins"},
            "status": {"type": "string", "enum": ["ready", "missing"]},
            "value": {"type": ["number", "null"], "minimum": 30, "maximum": 300},
            "unit": {"type": "string", "const": "kg"},
            "observed_date": {"type": ["string", "null"], "format": "date"},
            "age_days": {"type": ["integer", "null"], "minimum": 1, "maximum": 14},
            "selection_kind": {"type": ["string", "null"], "enum": ["exact_date", "latest_prior", null]},
            "lookback_days": {"type": "integer", "const": 14},
            "raw_file_id": {"type": ["integer", "null"], "minimum": 1},
            "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "provider_calls": {"type": "integer", "const": 0}
  }
}
