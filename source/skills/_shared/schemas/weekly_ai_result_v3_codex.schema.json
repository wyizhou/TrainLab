{
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "period", "week_conclusion", "health_review", "all_activity_review", "technical_findings", "plan_comparison", "climbing_and_combined_load", "progression_decision", "training_plan", "uncertainty", "evidence_refs", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "weekly_ai_result_v3"},
    "status": {"type": "string", "const": "succeeded"},
    "period": {"type": "string"},
    "week_conclusion": {"type": "string"},
    "health_review": {"type": "string"},
    "all_activity_review": {"type": "string"},
    "technical_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "plan_comparison": {"type": "string"},
    "climbing_and_combined_load": {"type": "string"},
    "progression_decision": {"type": "string", "enum": ["advance", "hold", "deload"]},
    "training_plan": {"$ref": "#/$defs/plan"},
    "uncertainty": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "provider_calls": {"type": "integer", "const": 0}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_refs", "observation", "interpretation", "planning_implication", "confidence", "evidence_refs", "limitations"],
      "properties": {
        "activity_refs": {"type": "array", "items": {"type": "integer"}},
        "observation": {"type": "string"},
        "interpretation": {"type": "string"},
        "planning_implication": {"type": "string"},
        "confidence": {"type": "string", "enum": ["high", "moderate", "low"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "sos_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_code", "explanation", "evidence_refs"],
      "properties": {
        "reason_code": {"type": "string", "enum": ["deload", "red_flag", "insufficient_recovery"]},
        "explanation": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "integer"}}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "name", "instruction", "end_condition"],
      "properties": {
        "phase": {"type": "string", "enum": ["warmup", "main", "recovery", "cooldown", "checklist"]},
        "name": {"type": "string"},
        "instruction": {"type": "string"},
        "end_condition": {"type": "string"}
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "activity_kind", "session_type", "name", "purpose", "load_level", "duration_minutes", "rpe_min", "rpe_max", "feel_guidance", "steps", "technique_notes", "stop_conditions"],
      "properties": {
        "date": {"type": "string"},
        "activity_kind": {"type": "string", "enum": ["running", "climbing", "rest"]},
        "session_type": {"type": "string", "enum": ["recovery_run", "easy_run", "long_easy", "sos_threshold", "sos_cruise_intervals", "sos_hills", "climbing_technique", "climbing_hard", "rest"]},
        "name": {"type": "string"},
        "purpose": {"type": "string"},
        "load_level": {"type": "string", "enum": ["low", "moderate", "hard"]},
        "duration_minutes": {"type": "number"},
        "rpe_min": {"type": "number"},
        "rpe_max": {"type": "number"},
        "feel_guidance": {"type": "string"},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
        "technique_notes": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "progression_rule", "progression_dimension", "sos_omission_reason", "sos_schedule_reason", "items", "provider_calls"],
      "properties": {
        "schema_version": {"type": "string", "const": "training_plan_v3"},
        "status": {"type": "string", "const": "succeeded"},
        "progression_rule": {"type": "string", "enum": ["advance", "hold", "deload"]},
        "progression_dimension": {"type": "string", "enum": ["distance", "intensity", "none"]},
        "sos_omission_reason": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sos_reason"}]},
        "sos_schedule_reason": {"type": ["string", "null"]},
        "items": {"type": "array", "items": {"$ref": "#/$defs/course"}},
        "provider_calls": {"type": "integer", "const": 0}
      }
    }
  }
}
