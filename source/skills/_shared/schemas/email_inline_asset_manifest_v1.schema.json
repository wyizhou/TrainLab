{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/email_inline_asset_manifest_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": {"type": "string", "const": "email_inline_asset_manifest_v1"},
    "assets": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "cid", "filename", "media_type", "width_px", "height_px", "byte_size", "sha256", "alt"],
        "properties": {
          "role": {"type": "string", "enum": ["email_brand_mark", "email_status_ready", "email_status_caution", "email_status_blocked", "daily_activity_hr_zones", "daily_sleep_stages", "daily_activity_heart_rate", "weekly_sleep", "weekly_rhr", "weekly_hrv", "weekly_running_distance", "weekly_activity_duration", "weekly_activity_hr_zones"]},
          "cid": {"type": "string", "pattern": "^[A-Za-z0-9._-]+@trainlab\\.invalid$"},
          "filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.png$"},
          "media_type": {"type": "string", "const": "image/png"},
          "width_px": {"type": "integer", "enum": [64, 96, 1248]},
          "height_px": {"type": "integer", "minimum": 1, "maximum": 1248},
          "byte_size": {"type": "integer", "minimum": 1, "maximum": 1048576},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "alt": {"type": "string", "minLength": 1, "maxLength": 40000}
        }
      }
    }
  }
}
