{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/auto_result_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "outcome", "timezone", "observed_at_hk",
    "slot_date", "slot_start", "slot_end", "workflow_refs", "skill_run_ids",
    "output_ids", "external_action_ids", "provider_calls", "next_slot_at", "warnings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "auto_result_v1"},
    "status": {"enum": ["succeeded", "blocked", "failed"]},
    "outcome": {"enum": ["no_due", "daily_complete", "daily_weekly_complete", "blocked", "failed"]},
    "timezone": {"type": "string", "const": "Asia/Hong_Kong"},
    "observed_at_hk": {"type": "string", "format": "date-time"},
    "slot_date": {"type": "string", "format": "date"},
    "slot_start": {"type": "string", "format": "date-time"},
    "slot_end": {"type": "string", "format": "date-time"},
    "workflow_refs": {"type": "array", "items": {"type": "string", "pattern": "^(daily|weekly):[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"}},
    "skill_run_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "output_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "external_action_ids": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "provider_calls": {"type": "integer", "const": 0},
    "next_slot_at": {"type": "string", "format": "date-time"},
    "warnings": {"type": "array", "items": {"type": "string", "maxLength": 200}}
  }
}
