{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_email_view_v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "status", "error_code", "period", "progression_rule", "health_summary", "activity_summary", "weekly_kpis", "week_comparison", "charts", "data_limits", "insights", "training_plan", "uncertainty", "daily_presentation_refs", "source_weekly_result", "provider_calls"],
  "properties": {
    "schema_version": {"const": "weekly_email_view_v3"},
    "kind": {"const": "weekly"},
    "title": {"type": "string", "pattern": "^TrainLab · 每周总结 · [0-9]{4}-[0-9]{2}-[0-9]{2}~[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "status": {"enum": ["succeeded", "blocked"]},
    "error_code": {"type": ["string", "null"]},
    "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "progression_rule": {"enum": ["advance", "hold", "deload"]},
    "health_summary": {"type": "string", "minLength": 1},
    "activity_summary": {"type": "string", "minLength": 1},
    "weekly_kpis": {"type": "object", "additionalProperties": false, "required": ["daily_count", "caution_days", "activity_count", "running_distance_km", "activity_duration_minutes", "average_sleep_hours"], "properties": {"daily_count": {"const": 7}, "caution_days": {"type": "integer", "minimum": 0, "maximum": 7}, "activity_count": {"type": "integer", "minimum": 0}, "running_distance_km": {"type": "number", "minimum": 0}, "activity_duration_minutes": {"type": "number", "minimum": 0}, "average_sleep_hours": {"type": ["number", "null"], "minimum": 0}}},
    "week_comparison": {"type": "object", "additionalProperties": false, "required": ["status", "summary"], "properties": {"status": {"enum": ["available", "unavailable"]}, "summary": {"type": "string", "minLength": 1}}},
    "charts": {"type": "array", "maxItems": 8, "items": {"$ref": "https://trainlab.local/schemas/email_chart_v3.schema.json"}},
    "data_limits": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "insights": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["observation", "meaning", "action"], "properties": {"observation": {"type": "string", "minLength": 1}, "meaning": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}}}},
    "training_plan": {"$ref": "https://trainlab.local/schemas/training_plan_v2.schema.json"},
    "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "daily_presentation_refs": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/presentation_ref"}},
    "source_weekly_result": {"$ref": "#/$defs/output_ref"},
    "provider_calls": {"const": 0}
  },
  "$defs": {
    "output_ref": {"type": "object", "additionalProperties": false, "required": ["output_id", "sha256", "content_json_sha256"], "properties": {"output_id": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "content_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "persisted_output_ref": {"type": "object", "additionalProperties": false, "required": ["output_id", "sha256"], "properties": {"output_id": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "presentation_ref": {"type": "object", "additionalProperties": false, "required": ["report_date", "presentation_sha256", "source_daily_result", "presentation_output"], "properties": {"report_date": {"type": "string", "format": "date"}, "presentation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "source_daily_result": {"$ref": "#/$defs/output_ref"}, "presentation_output": {"$ref": "#/$defs/persisted_output_ref"}}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]}, "then": {"properties": {"charts": {"maxItems": 0}}}}]
}
