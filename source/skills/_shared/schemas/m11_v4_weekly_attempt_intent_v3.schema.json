{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/m11_v4_weekly_attempt_intent_v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "attempt", "candidate_kind", "prompt_sha256", "context_sha256", "wire_schema_sha256", "business_schema_sha256", "ai_result_schema_sha256", "reader_schema_sha256", "prompt_template_sha256", "canary_proof_sha256", "timeout_seconds", "command_contract", "provider_calls", "external_actions"],
  "properties": {
    "schema_version": {"type": "string", "const": "m11_v4_weekly_attempt_intent_v3"},
    "attempt": {"type": "integer", "const": 1},
    "candidate_kind": {"type": "string", "enum": ["public_canary", "private_weekly"]},
    "prompt_sha256": {"$ref": "#/$defs/sha"},
    "context_sha256": {"$ref": "#/$defs/sha"},
    "wire_schema_sha256": {"$ref": "#/$defs/sha"},
    "business_schema_sha256": {"$ref": "#/$defs/sha"},
    "ai_result_schema_sha256": {"$ref": "#/$defs/sha"},
    "reader_schema_sha256": {"$ref": "#/$defs/sha"},
    "prompt_template_sha256": {"$ref": "#/$defs/sha"},
    "canary_proof_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "timeout_seconds": {"type": "integer", "const": 180},
    "command_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ephemeral", "ignore_user_config", "sandbox", "output_schema", "skip_git_repo_check"],
      "properties": {
        "ephemeral": {"type": "boolean", "const": true},
        "ignore_user_config": {"type": "boolean", "const": true},
        "sandbox": {"type": "string", "const": "read-only"},
        "output_schema": {"type": "string", "const": "weekly_model_decision_v1_codex"},
        "skip_git_repo_check": {"type": "boolean", "const": true}
      }
    },
    "provider_calls": {"type": "integer", "const": 0},
    "external_actions": {"type": "integer", "const": 0}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
