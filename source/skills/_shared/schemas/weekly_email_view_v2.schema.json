{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_email_view_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "period", "status", "health_summary", "activity_summary", "insights", "training_plan", "uncertainty", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "weekly_email_view_v2"},
    "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "status": {"type": "string", "enum": ["advance", "hold", "deload", "blocked"]},
    "health_summary": {"type": "string", "minLength": 1},
    "activity_summary": {"type": "string", "minLength": 1},
    "insights": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["observation", "meaning", "action"], "properties": {"observation": {"type": "string", "minLength": 1}, "meaning": {"type": "string", "minLength": 1}, "action": {"type": "string", "minLength": 1}}}},
    "training_plan": {"$ref": "https://trainlab.local/schemas/training_plan_v2.schema.json"},
    "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provider_calls": {"type": "integer", "const": 0}
  }
}
