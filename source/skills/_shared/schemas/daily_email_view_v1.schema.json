{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/daily_email_view_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "period", "review_date", "sleep_wake_date", "status", "error_code", "summary", "stop_conditions", "metrics", "activities", "today_course", "course_notice", "recent_trend", "charts", "extra_sections", "evidence", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "daily_email_view_v1"},
    "kind": {"type": "string", "const": "daily"},
    "title": {"type": "string", "pattern": "^TrainLab · 每日训练简报 · [0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "period": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"},
    "sleep_wake_date": {"type": "string", "format": "date"},
    "status": {"type": "string", "enum": ["ready", "caution", "blocked"]},
    "error_code": {"type": ["string", "null"]},
    "summary": {"type": "string", "minLength": 1},
    "stop_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sleep", "rhr", "hrv", "vo2_max", "weight"],
      "properties": {
        "sleep": {"$ref": "#/$defs/metric"},
        "rhr": {"$ref": "#/$defs/metric"},
        "hrv": {"$ref": "#/$defs/metric"},
        "vo2_max": {"$ref": "#/$defs/metric"},
        "weight": {"$ref": "#/$defs/metric"}
      }
    },
    "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
    "today_course": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/course"}]},
    "course_notice": {"type": ["string", "null"]},
    "recent_trend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["days_available", "sleep", "recovery", "running", "data_gaps"],
      "properties": {
        "days_available": {"type": ["integer", "null"], "minimum": 0, "maximum": 14},
        "sleep": {"type": ["object", "null"]},
        "recovery": {"type": ["object", "null"]},
        "running": {"type": ["object", "null"]},
        "data_gaps": {"type": ["array", "null"], "items": {"type": "string"}}
      }
    },
    "charts": {"type": "array", "items": {"$ref": "#/$defs/chart"}},
    "extra_sections": {"type": "array", "maxItems": 0},
    "evidence": {"$ref": "#/$defs/evidence"},
    "provider_calls": {"type": "integer", "const": 0}
  },
  "$defs": {
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "label", "value", "missing", "detail", "source_refs"],
      "properties": {
        "key": {"type": "string"}, "label": {"type": "string"}, "value": {"type": "string"},
        "missing": {"type": "boolean"}, "detail": {"type": ["string", "null"]},
        "source_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "label", "distance", "duration", "pace", "lap_count", "source_refs"],
      "properties": {
        "kind": {"type": "string"}, "label": {"type": "string"},
        "distance": {"type": ["string", "null"]}, "duration": {"type": ["string", "null"]},
        "pace": {"type": ["string", "null"]}, "lap_count": {"type": ["integer", "null"]},
        "source_refs": {"type": "array", "items": {"type": "integer", "minimum": 1}}
      }
    },
    "course": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "activity_kind", "name", "purpose", "load_level", "rpe", "downgrade_rule", "stop_conditions", "garmin_mapping_status"],
      "properties": {
        "date": {"type": "string", "format": "date"}, "activity_kind": {"type": "string", "enum": ["running", "climbing", "rest"]},
        "name": {"type": "string"}, "purpose": {"type": "string"}, "load_level": {"type": "string"},
        "distance_km": {"type": "number"}, "duration_minutes": {"type": "number"},
        "pace_min_seconds_per_km": {"type": "number"}, "pace_max_seconds_per_km": {"type": "number"},
        "heart_rate_min_bpm": {"type": "number"}, "heart_rate_max_bpm": {"type": "number"},
        "rpe": {"type": "number"}, "steps": {"type": "array", "items": {"type": "object"}},
        "downgrade_rule": {"type": "string"}, "stop_conditions": {"type": "array", "items": {"type": "string"}},
        "garmin_mapping_status": {"type": "string"}
      }
    },
    "chart": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "title", "unit", "points", "source_refs"],
      "properties": {
        "role": {"type": "string", "const": "daily_activity_heart_rate"}, "title": {"type": "string"}, "unit": {"type": "string", "const": "bpm"},
        "points": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "number"}}}},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["count", "refs"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "refs": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "sha256", "claim"],
            "properties": {
              "id": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "claim": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
