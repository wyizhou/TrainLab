{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_ai_result_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "period", "daily_input_sha256", "summary", "evidence_refs", "training_plan", "provider_calls"],
  "properties": {
    "schema_version": {"const": "weekly_ai_result_v1"},
    "status": {"enum": ["succeeded", "blocked"]},
    "error_code": {"type": ["string", "null"], "minLength": 1},
    "period": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "daily_input_sha256": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "summary": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_ref"}},
    "goal_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "training_plan": {"type": "object", "additionalProperties": true},
    "provider_calls": {"const": 0}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"required": ["goal_sha256"]}},
    {"if": {"properties": {"status": {"const": "blocked"}}}, "then": {"required": ["error_code"]}}
  ],
  "$defs": {
    "evidence_ref": {"type": "object", "additionalProperties": false, "required": ["output_id", "sha256", "claim"], "properties": {"output_id": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "claim": {"type": "string", "minLength": 1}}}
  }
}
