{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/daily_email_view_v3.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "title", "status", "error_code", "report_date", "review_date", "sleep_wake_date", "safety", "yesterday_summary", "review_health_summary", "recovery_summary", "planned_course_context", "planned_course", "adjustment", "effective_course", "decision_reasons", "adjustment_reason_codes", "stop_conditions", "uncertainty", "activity_kpis", "sleep_card", "health_cards", "charts", "data_limits", "recent_trend", "evidence_labels", "source_daily_result", "presentation_evidence_sha256", "provider_calls"],
  "properties": {
    "schema_version": {"const": "daily_email_view_v3"},
    "kind": {"const": "daily"},
    "title": {"type": "string", "pattern": "^TrainLab · 每日训练简报 · [0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "status": {"enum": ["succeeded", "blocked"]},
    "error_code": {"type": ["string", "null"]},
    "report_date": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"},
    "sleep_wake_date": {"type": "string", "format": "date"},
    "safety": {"enum": ["ready", "caution", "blocked"]},
    "yesterday_summary": {"type": "string", "minLength": 1},
    "review_health_summary": {"type": "string", "minLength": 1},
    "recovery_summary": {"type": "string", "minLength": 1},
    "planned_course_context": {"enum": ["verified_original", "test_baseline"]},
    "planned_course": {"$ref": "https://trainlab.local/schemas/training_plan_v2.schema.json#/$defs/course"},
    "adjustment": {"enum": ["as_planned", "modified", "rest", "blocked", "unavailable"]},
    "effective_course": {"$ref": "https://trainlab.local/schemas/training_plan_v2.schema.json#/$defs/course"},
    "decision_reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "adjustment_reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "activity_kpis": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
    "sleep_card": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sleep"}]},
    "health_cards": {"type": "object", "additionalProperties": false, "required": ["rhr", "hrv", "vo2_max", "weight"], "properties": {"rhr": {"$ref": "#/$defs/nullable_metric"}, "hrv": {"$ref": "#/$defs/nullable_metric"}, "vo2_max": {"$ref": "#/$defs/nullable_metric"}, "weight": {"$ref": "#/$defs/nullable_metric"}}},
    "charts": {"type": "array", "maxItems": 8, "items": {"$ref": "https://trainlab.local/schemas/email_chart_v3.schema.json"}},
    "data_limits": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "recent_trend": {"type": "object", "additionalProperties": false, "required": ["days_available"], "properties": {"days_available": {"type": "integer", "minimum": 0, "maximum": 14}, "sleep_average_hours": {"type": ["number", "null"], "minimum": 0}, "sleep_insufficient_days": {"type": "integer", "minimum": 0}, "caution_days": {"type": "integer", "minimum": 0}, "rhr_average": {"type": ["number", "null"], "minimum": 0}, "hrv_average": {"type": ["number", "null"], "minimum": 0}, "running_distance_km": {"type": "number", "minimum": 0}, "activity_count": {"type": "integer", "minimum": 0}, "data_gap_count": {"type": "integer", "minimum": 0}}},
    "evidence_labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_daily_result": {"$ref": "#/$defs/output_ref"},
    "presentation_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_calls": {"const": 0}
  },
  "$defs": {
    "output_ref": {"type": "object", "additionalProperties": false, "required": ["output_id", "sha256", "content_json_sha256"], "properties": {"output_id": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "content_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["label", "value", "unit", "observed_date"], "properties": {"label": {"type": "string", "minLength": 1}, "value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}, "observed_date": {"type": "string", "format": "date"}}},
    "nullable_metric": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/metric"}]},
    "activity": {"type": "object", "additionalProperties": false, "required": ["label", "activity_kind", "duration_seconds"], "properties": {"label": {"type": "string", "minLength": 1}, "activity_kind": {"type": "string", "minLength": 1}, "distance_km": {"type": ["number", "null"], "minimum": 0}, "duration_seconds": {"type": "number", "minimum": 0}, "pace_seconds_per_km": {"type": ["number", "null"], "minimum": 0}, "heart_rate_average_bpm": {"type": ["number", "null"], "minimum": 0}, "heart_rate_maximum_bpm": {"type": ["number", "null"], "minimum": 0}}},
    "sleep": {"type": "object", "additionalProperties": false, "required": ["start", "end", "duration_seconds", "completeness"], "properties": {"start": {"type": "string"}, "end": {"type": "string"}, "duration_seconds": {"type": "number", "minimum": 0}, "completeness": {"const": "complete"}}}
  },
  "allOf": [{"if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]}, "then": {"properties": {"safety": {"const": "blocked"}, "charts": {"maxItems": 0}}}}]
}
