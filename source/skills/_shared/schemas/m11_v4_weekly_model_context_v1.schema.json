{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/m11_v4_weekly_model_context_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "activity_period", "next_plan_dates", "training_goal", "weekly_evidence", "allowed_technical_activity_refs", "provider_calls", "external_actions"],
  "properties": {
    "schema_version": {"type": "string", "const": "m11_v4_weekly_model_context_v1"},
    "activity_period": {"$ref": "#/$defs/period"},
    "next_plan_dates": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"type": "string", "const": "2026-08-19"},
        {"type": "string", "const": "2026-08-20"},
        {"type": "string", "const": "2026-08-21"},
        {"type": "string", "const": "2026-08-22"},
        {"type": "string", "const": "2026-08-23"},
        {"type": "string", "const": "2026-08-24"},
        {"type": "string", "const": "2026-08-25"}
      ],
      "items": false
    },
    "training_goal": {"type": "string", "minLength": 1, "maxLength": 20000},
    "weekly_evidence": {"$ref": "https://trainlab.local/schemas/weekly_training_evidence_v2.schema.json"},
    "allowed_technical_activity_refs": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/activity_ref"}
    },
    "provider_calls": {"type": "integer", "const": 0},
    "external_actions": {"type": "integer", "const": 0}
  },
  "$defs": {
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_start_date", "activity_end_date", "sleep_wake_start_date", "sleep_wake_end_date"],
      "properties": {
        "activity_start_date": {"type": "string", "const": "2026-08-11"},
        "activity_end_date": {"type": "string", "const": "2026-08-17"},
        "sleep_wake_start_date": {"type": "string", "const": "2026-08-12"},
        "sleep_wake_end_date": {"type": "string", "const": "2026-08-18"}
      }
    },
    "activity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_inventory_id", "raw_file_id", "raw_sha256"],
      "properties": {
        "activity_inventory_id": {"type": "integer", "minimum": 1},
        "raw_file_id": {"type": "integer", "minimum": 1},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
