{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_summary_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "period", "daily_count", "training_plan", "progression_decision", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "weekly_summary_v1"},
    "status": {"type": "string", "enum": ["succeeded", "blocked"]},
    "period": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])/[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"},
    "daily_count": {"type": "integer", "const": 7},
    "daily_input_sha256": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "review_output_id": {"type": "integer", "minimum": 1},
    "evidence_consistency": {"type": "string", "enum": ["verified", "blocked"]},
    "activity_days": {"type": "integer", "minimum": 0, "maximum": 7},
    "sleep_complete_days": {"type": "integer", "minimum": 0, "maximum": 7},
    "training_plan": {"$ref": "#/$defs/training_plan"},
    "progression_decision": {"type": "string", "enum": ["advance", "hold", "deload"]},
    "provider_calls": {"type": "integer", "const": 0}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"required": ["daily_input_sha256", "review_output_id"]}},
    {"if": {"properties": {"status": {"const": "blocked"}}}, "then": {"required": ["period"]}}
  ],
  "$defs": {
    "step": {"type": "object", "additionalProperties": false, "required": ["name", "end_condition"], "properties": {"name": {"type": "string", "minLength": 1}, "end_condition": {"type": "string", "minLength": 1}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["date", "activity_kind", "name", "purpose", "load_level", "garmin_mapping_status", "rpe", "downgrade_rule", "stop_conditions"], "properties": {"date": {"type": "string", "format": "date"}, "activity_kind": {"enum": ["running", "climbing", "rest"]}, "name": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "load_level": {"enum": ["low", "moderate", "hard"]}, "garmin_mapping_status": {"enum": ["candidate", "requires_review", "unsupported_skip"]}, "distance_km": {"type": "number", "exclusiveMinimum": 0}, "duration_minutes": {"type": "number", "exclusiveMinimum": 0}, "pace_min_seconds_per_km": {"type": "number", "exclusiveMinimum": 0}, "pace_max_seconds_per_km": {"type": "number", "exclusiveMinimum": 0}, "heart_rate_min_bpm": {"type": "number", "exclusiveMinimum": 0}, "heart_rate_max_bpm": {"type": "number", "exclusiveMinimum": 0}, "rpe": {"type": "number", "minimum": 1, "maximum": 10}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}, "downgrade_rule": {"type": "string", "minLength": 1}, "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}, "allOf": [{"if": {"properties": {"activity_kind": {"const": "running"}}}, "then": {"anyOf": [{"required": ["distance_km"]}, {"required": ["duration_minutes"]}]}}, {"if": {"properties": {"activity_kind": {"const": "climbing"}}}, "then": {"required": ["duration_minutes"], "properties": {"garmin_mapping_status": {"const": "unsupported_skip"}}}}, {"if": {"properties": {"activity_kind": {"const": "rest"}}}, "then": {"properties": {"garmin_mapping_status": {"const": "unsupported_skip"}}, "not": {"anyOf": [{"required": ["distance_km"]}, {"required": ["duration_minutes"]}]}}}]},
    "training_plan": {"type": "object", "additionalProperties": false, "required": ["schema_version", "status", "items", "progression_rule", "progression_dimension", "provider_calls"], "properties": {"schema_version": {"const": "training_plan_v1"}, "status": {"enum": ["succeeded", "blocked"]}, "items": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/item"}}, "progression_rule": {"enum": ["advance", "hold", "deload"]}, "progression_dimension": {"enum": ["distance", "intensity", "none"]}, "previous_week_distance_km": {"type": "number", "minimum": 0}, "current_week_distance_km": {"type": "number", "minimum": 0}, "previous_week_intensity_score": {"type": "number", "minimum": 0}, "current_week_intensity_score": {"type": "number", "minimum": 0}, "evidence_running_distance_km": {"type": "number", "minimum": 0}, "evidence_caution_days": {"type": "integer", "minimum": 0, "maximum": 7}, "evidence_daily_count": {"type": "integer", "minimum": 0, "maximum": 7}, "provider_calls": {"const": 0}}}
  }
}
