{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fit_report_artifacts_v1",
      "type": "string"
    },
    "period_end_utc": {
      "type": "string",
      "minLength": 1
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "revision_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "effective_plan_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "view_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "renderer_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "markdown_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "pdf_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "period_end_utc",
    "revision_id",
    "revision_sha256",
    "effective_plan_sha256",
    "view_sha256",
    "renderer_sha256",
    "markdown_sha256",
    "pdf_sha256"
  ],
  "additionalProperties": false
}
