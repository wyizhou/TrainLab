{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_prompt_semantics_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "root_allowed_fields", "root_required_fields", "day_slots", "course_variants", "forbidden_host_fields"],
  "properties": {
    "schema_version": {"type": "string", "const": "weekly_prompt_semantics_v1"},
    "root_allowed_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "root_required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "day_slots": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "string", "pattern": "^day_[1-7]$"}},
    "course_variants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["running", "climbing", "rest"],
      "properties": {
        "running": {"$ref": "#/$defs/variant"},
        "climbing": {"$ref": "#/$defs/variant"},
        "rest": {"$ref": "#/$defs/variant"}
      }
    },
    "forbidden_host_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_types", "phase_keys"],
      "properties": {
        "session_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "phase_keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
