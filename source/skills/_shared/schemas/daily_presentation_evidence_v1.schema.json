{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/daily_presentation_evidence_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "report_date", "review_date", "sleep_wake_date", "safety", "source_daily_result", "activities", "sleep", "health", "recent_trend", "provider_calls"],
  "properties": {
    "schema_version": {"const": "daily_presentation_evidence_v1"},
    "status": {"enum": ["ready", "blocked"]},
    "error_code": {"type": ["string", "null"]},
    "report_date": {"type": "string", "format": "date"},
    "review_date": {"type": "string", "format": "date"},
    "sleep_wake_date": {"type": "string", "format": "date"},
    "safety": {"enum": ["ready", "caution", "blocked"]},
    "source_daily_result": {"$ref": "#/$defs/output_ref"},
    "activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
    "sleep": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sleep"}]},
    "health": {"type": "object", "additionalProperties": false, "required": ["rhr", "hrv", "vo2_max", "weight"], "properties": {"rhr": {"$ref": "#/$defs/nullable_metric"}, "hrv": {"$ref": "#/$defs/nullable_metric"}, "vo2_max": {"$ref": "#/$defs/nullable_metric"}, "weight": {"$ref": "#/$defs/nullable_metric"}}},
    "recent_trend": {"type": "object", "additionalProperties": false, "required": ["days_available"], "properties": {"days_available": {"type": "integer", "minimum": 0, "maximum": 14}, "sleep_average_hours": {"type": ["number", "null"], "minimum": 0}, "sleep_insufficient_days": {"type": "integer", "minimum": 0}, "caution_days": {"type": "integer", "minimum": 0}, "rhr_average": {"type": ["number", "null"], "minimum": 0}, "hrv_average": {"type": ["number", "null"], "minimum": 0}, "running_distance_km": {"type": "number", "minimum": 0}, "activity_count": {"type": "integer", "minimum": 0}, "data_gap_count": {"type": "integer", "minimum": 0}}},
    "provider_calls": {"const": 0}
  },
  "$defs": {
    "output_ref": {"type": "object", "additionalProperties": false, "required": ["output_id", "sha256", "content_json_sha256"], "properties": {"output_id": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "content_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["value", "unit", "observed_date", "raw_file_id", "raw_sha256"], "properties": {"value": {"type": "number"}, "unit": {"type": "string", "minLength": 1}, "observed_date": {"type": "string", "format": "date"}, "raw_file_id": {"type": "integer", "minimum": 1}, "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "nullable_metric": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/metric"}]},
    "zone_segment": {"type": "object", "additionalProperties": false, "required": ["label", "duration_seconds", "percentage"], "properties": {"label": {"enum": ["低于Z1", "Z1", "Z2", "Z3", "Z4", "Z5", "高于Z5"]}, "duration_seconds": {"type": "number", "minimum": 0}, "percentage": {"type": "number", "minimum": 0, "maximum": 100}}},
    "sleep_segment": {"type": "object", "additionalProperties": false, "required": ["label", "duration_seconds", "percentage"], "properties": {"label": {"enum": ["深睡", "浅睡", "REM", "清醒"]}, "duration_seconds": {"type": "number", "minimum": 0}, "percentage": {"type": "number", "minimum": 0, "maximum": 100}}},
    "zones": {"type": "object", "additionalProperties": false, "required": ["source", "definition_sha256", "percentage_source", "segments"], "properties": {"source": {"const": "fit_session_time_in_hr_zone"}, "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "percentage_source": {"const": "derived_from_provider_duration"}, "segments": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/zone_segment"}}}},
    "series_point": {"type": "object", "additionalProperties": false, "required": ["offset_seconds", "value"], "properties": {"offset_seconds": {"type": "integer", "minimum": 0}, "value": {"type": "number", "minimum": 0}}},
    "activity": {"type": "object", "additionalProperties": false, "required": ["activity_inventory_id", "raw_file_id", "raw_sha256", "activity_kind", "duration_seconds", "heart_rate_series"], "properties": {"activity_inventory_id": {"type": "integer", "minimum": 1}, "raw_file_id": {"type": "integer", "minimum": 1}, "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "activity_kind": {"type": "string", "minLength": 1}, "distance_km": {"type": ["number", "null"], "minimum": 0}, "duration_seconds": {"type": "number", "minimum": 0}, "pace_seconds_per_km": {"type": ["number", "null"], "minimum": 0}, "heart_rate_average_bpm": {"type": ["number", "null"], "minimum": 0}, "heart_rate_maximum_bpm": {"type": ["number", "null"], "minimum": 0}, "heart_rate_series": {"type": "array", "items": {"$ref": "#/$defs/series_point"}}, "observed_heart_rate_zones": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/zones"}]} }},
    "sleep": {"type": "object", "additionalProperties": false, "required": ["raw_file_id", "raw_sha256", "start", "end", "duration_seconds", "completeness"], "properties": {"raw_file_id": {"type": "integer", "minimum": 1}, "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "start": {"type": "string", "minLength": 1}, "end": {"type": "string", "minLength": 1}, "duration_seconds": {"type": "number", "minimum": 0}, "completeness": {"const": "complete"}, "stages": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/sleep_segment"}}}}
  }
}
