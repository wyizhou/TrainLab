{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/m11_v3_live_batch_candidate_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "batch_id",
    "database",
    "parent_database_sha256",
    "parent_build_receipt_sha256",
    "runtime_sha256",
    "formal_state_sha256",
    "recipient_sha256",
    "auth_receipt_sha256",
    "auth_provider_calls",
    "authorization_rule",
    "strict_serial",
    "authorized_action_count",
    "items",
    "action_ids",
    "action_api_calls",
    "action_phase_calls",
    "action_send_calls",
    "api_calls",
    "send_calls",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "m11_v3_live_batch_candidate_v1"},
    "batch_id": {"type": "string", "const": "m11-v3-live-batch"},
    "database": {"type": "string", "minLength": 1},
    "parent_database_sha256": {"$ref": "#/$defs/sha"},
    "parent_build_receipt_sha256": {"$ref": "#/$defs/sha"},
    "runtime_sha256": {"$ref": "#/$defs/sha"},
    "formal_state_sha256": {"$ref": "#/$defs/sha"},
    "recipient_sha256": {"$ref": "#/$defs/sha"},
    "auth_receipt_sha256": {"$ref": "#/$defs/sha"},
    "auth_provider_calls": {"type": "integer", "const": 1},
    "authorization_rule": {"type": "string", "const": "A-017"},
    "strict_serial": {"type": "boolean", "const": true},
    "authorized_action_count": {"type": "integer", "const": 8},
    "items": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/item"}
    },
    "action_ids": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "action_api_calls": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 16}
    },
    "action_phase_calls": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lookup", "raw", "confirmation"],
        "properties": {
          "lookup": {"type": "integer", "minimum": 0, "maximum": 5},
          "raw": {"type": "integer", "minimum": 0, "maximum": 5},
          "confirmation": {"type": "integer", "minimum": 0, "maximum": 5}
        }
      }
    },
    "action_send_calls": {
      "type": "object",
      "minProperties": 8,
      "maxProperties": 8,
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 1}
    },
    "api_calls": {"type": "integer", "minimum": 0, "maximum": 128},
    "send_calls": {"type": "integer", "minimum": 0, "maximum": 8},
    "created_at_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "date": {"type": "string", "format": "date"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "item_key",
        "kind",
        "preview_name",
        "period_start",
        "period_end",
        "action_id",
        "delivery_run_id",
        "approval_id",
        "request_sha256",
        "requested_message_id",
        "mime_sha256",
        "render_sha256",
        "output_id",
        "output_sha256"
      ],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 1, "maximum": 8},
        "item_key": {
          "type": "string",
          "pattern": "^(daily-[0-9]{4}-[0-9]{2}-[0-9]{2}|weekly-[0-9]{4}-[0-9]{2}-[0-9]{2}--[0-9]{4}-[0-9]{2}-[0-9]{2})$"
        },
        "kind": {"type": "string", "enum": ["daily", "weekly"]},
        "preview_name": {"type": "string", "minLength": 1},
        "period_start": {"$ref": "#/$defs/date"},
        "period_end": {"$ref": "#/$defs/date"},
        "action_id": {"type": "integer", "minimum": 1},
        "delivery_run_id": {"type": "integer", "minimum": 1},
        "approval_id": {"type": "integer", "minimum": 1},
        "request_sha256": {"$ref": "#/$defs/sha"},
        "requested_message_id": {
          "type": "string",
          "pattern": "^<trainlab\\.v2\\.[0-9a-f]{64}@trainlab\\.invalid>$"
        },
        "mime_sha256": {"$ref": "#/$defs/sha"},
        "render_sha256": {"$ref": "#/$defs/sha"},
        "output_id": {"type": "integer", "minimum": 1},
        "output_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
