{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_training_evidence_v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "period", "daily_observation_refs", "health_days", "all_activities", "weekly_totals", "key_run_refs", "plan_comparison", "raw_reads", "provider_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "weekly_training_evidence_v2"},
    "status": {"type": "string", "const": "ready"},
    "period": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_start_date", "activity_end_date", "sleep_wake_start_date", "sleep_wake_end_date"],
      "properties": {
        "activity_start_date": {"type": "string", "format": "date"},
        "activity_end_date": {"type": "string", "format": "date"},
        "sleep_wake_start_date": {"type": "string", "format": "date"},
        "sleep_wake_end_date": {"type": "string", "format": "date"}
      }
    },
    "daily_observation_refs": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/ref"}},
    "health_days": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/health_day"}},
    "all_activities": {"type": "array", "items": {"$ref": "#/$defs/activity"}},
    "weekly_totals": {"$ref": "#/$defs/totals"},
    "key_run_refs": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/activity_ref"}},
    "plan_comparison": {"$ref": "#/$defs/plan_comparison"},
    "raw_reads": {"type": "integer", "const": 0},
    "provider_calls": {"type": "integer", "const": 0}
  },
  "$defs": {
    "ref": {
      "type": "object", "additionalProperties": false,
      "required": ["report_date", "activity_date", "output_id", "sha256"],
      "properties": {
        "report_date": {"type": "string", "format": "date"},
        "activity_date": {"type": "string", "format": "date"},
        "output_id": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "activity_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_inventory_id", "raw_file_id", "raw_sha256"],
      "properties": {
        "activity_inventory_id": {"type": "integer", "minimum": 1},
        "raw_file_id": {"type": "integer", "minimum": 1},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "health_fact": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_code", "value", "unit", "observed_date", "raw_file_id", "raw_sha256", "uncertainty"],
      "properties": {
        "metric_code": {"type": "string", "enum": ["sleep:main_sleep", "rhr:resting_heart_rate", "hrv:hrv", "heart_rates:heart_rate", "max_metrics:vo2_max", "weigh_ins:weight"]},
        "value": {
          "oneOf": [
            {"$ref": "#/$defs/sleep_value"},
            {"$ref": "#/$defs/rhr_value"},
            {"$ref": "#/$defs/hrv_value"},
            {"$ref": "#/$defs/heart_rates_value"},
            {"$ref": "#/$defs/vo2_value"},
            {"$ref": "#/$defs/weight_value"}
          ]
        },
        "unit": {"type": ["string", "null"]},
        "observed_date": {"type": "string", "format": "date"},
        "raw_file_id": {"type": "integer", "minimum": 1},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"metric_code": {"const": "sleep:main_sleep"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/sleep_value"}}}},
        {"if": {"properties": {"metric_code": {"const": "rhr:resting_heart_rate"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/rhr_value"}}}},
        {"if": {"properties": {"metric_code": {"const": "hrv:hrv"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/hrv_value"}}}},
        {"if": {"properties": {"metric_code": {"const": "heart_rates:heart_rate"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/heart_rates_value"}}}},
        {"if": {"properties": {"metric_code": {"const": "max_metrics:vo2_max"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/vo2_value"}}}},
        {"if": {"properties": {"metric_code": {"const": "weigh_ins:weight"}}}, "then": {"properties": {"value": {"$ref": "#/$defs/weight_value"}}}}
      ]
    },
    "sleep_value": {
      "type": "object", "additionalProperties": false,
      "required": ["resource", "metric", "uncertainty", "completeness", "sleep_start", "sleep_end", "duration_seconds", "sleep_wake_date"],
      "properties": {
        "resource": {"type": "string", "const": "sleep"},
        "metric": {"type": "string", "const": "main_sleep"},
        "uncertainty": {"type": "string", "const": "named_fields"},
        "completeness": {"type": "string", "const": "complete"},
        "sleep_start": {"type": "string", "format": "date-time"},
        "sleep_end": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "sleep_wake_date": {"type": "string", "format": "date"},
        "stage_group_count": {"type": "integer", "minimum": 0},
        "sleep_stages": {"$ref": "#/$defs/sleep_stages"}
      }
    },
    "sleep_stages": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "durations_seconds", "timeline"],
      "properties": {
        "source": {"type": "string", "const": "garmin_named_sleep_stage_durations"},
        "durations_seconds": {
          "type": "object", "additionalProperties": false,
          "required": ["deep", "light", "rem", "awake"],
          "properties": {
            "deep": {"type": "number", "minimum": 0},
            "light": {"type": "number", "minimum": 0},
            "rem": {"type": "number", "minimum": 0},
            "awake": {"type": "number", "minimum": 0}
          }
        },
        "timeline": {"type": "array", "items": {"$ref": "#/$defs/sleep_stage_interval"}}
      }
    },
    "sleep_stage_interval": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "start", "end", "duration_seconds"],
      "properties": {
        "stage": {"type": "string", "enum": ["deep", "light", "rem", "awake"]},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "rhr_value": {
      "type": "object", "additionalProperties": false,
      "required": ["resource", "uncertainty", "metric", "resting_heart_rate_bpm"],
      "properties": {
        "resource": {"type": "string", "const": "rhr"},
        "uncertainty": {"type": "string", "const": "named_fields"},
        "metric": {"type": "string", "const": "resting_heart_rate"},
        "resting_heart_rate_bpm": {"type": "number", "minimum": 0}
      }
    },
    "hrv_value": {
      "type": "object", "additionalProperties": false,
      "required": ["resource", "uncertainty", "metric"],
      "properties": {
        "resource": {"type": "string", "const": "hrv"},
        "uncertainty": {"type": "string", "const": "named_fields"},
        "metric": {"type": "string", "const": "hrv"},
        "last_night_average": {"type": "number", "minimum": 0},
        "weekly_average": {"type": "number", "minimum": 0},
        "last_night_5_min_high": {"type": "number", "minimum": 0}
      }
    },
    "heart_rates_value": {
      "type": "object", "additionalProperties": false,
      "required": ["resource", "uncertainty", "metric", "sample_count"],
      "properties": {
        "resource": {"type": "string", "const": "heart_rates"},
        "uncertainty": {"type": "string", "const": "named_fields"},
        "metric": {"type": "string", "const": "heart_rate"},
        "sample_count": {"type": "integer", "minimum": 0},
        "aggregate": {"$ref": "#/$defs/numeric_summary"},
        "median": {"type": "number", "minimum": 0},
        "average": {"type": "number", "minimum": 0},
        "resting_heart_rate_bpm": {"type": "number", "minimum": 0}
      }
    },
    "numeric_summary": {
      "type": "object", "additionalProperties": false,
      "required": ["count"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "minimum": {"type": "number", "minimum": 0},
        "maximum": {"type": "number", "minimum": 0},
        "average": {"type": "number", "minimum": 0}
      }
    },
    "vo2_value": {
      "type": "object", "additionalProperties": false,
      "required": ["resource", "metric", "vo2_max", "unit", "observed_date", "age_days", "selection_kind"],
      "properties": {
        "resource": {"type": "string", "const": "max_metrics"},
        "metric": {"type": "string", "const": "vo2_max"},
        "vo2_max": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "const": "ml/kg/min"},
        "observed_date": {"type": "string", "format": "date"},
        "age_days": {"type": "integer", "minimum": 0},
        "selection_kind": {"type": "string", "enum": ["exact_date", "latest_prior"]}
      }
    },
    "weight_value": {
      "type": "object", "additionalProperties": false,
      "required": ["resource", "metric", "weight", "unit", "observed_date", "age_days", "selection_kind"],
      "properties": {
        "resource": {"type": "string", "const": "weigh_ins"},
        "metric": {"type": "string", "const": "weight"},
        "weight": {"type": "number", "minimum": 0},
        "unit": {"type": "string", "const": "kg"},
        "observed_date": {"type": "string", "format": "date"},
        "age_days": {"type": "integer", "minimum": 0},
        "selection_kind": {"type": "string", "enum": ["exact_date", "latest_prior"]}
      }
    },
    "health_day": {
      "type": "object", "additionalProperties": false,
      "required": ["health_date", "sleep_wake_date", "facts", "health_analysis_ref"],
      "properties": {
        "health_date": {"type": "string", "format": "date"},
        "sleep_wake_date": {"type": "string", "format": "date"},
        "facts": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "https://trainlab.local/schemas/health_fact_v2.schema.json"}},
        "health_analysis_ref": {"type": "object", "additionalProperties": false, "required": ["output_id", "sha256"], "properties": {"output_id": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      }
    },
    "activity": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_inventory_id", "raw_file_id", "raw_sha256", "activity_date", "activity_kind", "distance_km", "duration_seconds", "coverage", "missing_fields", "uncertainty", "technical_metrics", "plan_relation"],
      "properties": {
        "activity_inventory_id": {"type": "integer", "minimum": 1},
        "raw_file_id": {"type": "integer", "minimum": 1},
        "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "activity_date": {"type": "string", "format": "date"},
        "activity_kind": {"type": "string", "enum": ["running", "rock_climbing", "climbing", "cycling", "walking", "hiking", "strength_training", "rest"]},
        "distance_km": {"type": ["number", "null"], "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "average_heart_rate_bpm": {"type": ["number", "null"], "minimum": 0},
        "maximum_heart_rate_bpm": {"type": ["number", "null"], "minimum": 0},
        "coverage": {"type": "object", "additionalProperties": false, "required": ["summary", "sequence"], "properties": {"summary": {"type": "number", "minimum": 0, "maximum": 1}, "sequence": {"type": "number", "minimum": 0, "maximum": 1}}},
        "missing_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "technical_metrics": {"type": "array", "items": {"$ref": "https://trainlab.local/schemas/activity_technical_evidence_v1.schema.json#/$defs/metric"}},
        "plan_relation": {"type": "string", "enum": ["date_only_match", "unplanned"]}
      }
    },
    "totals": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_count", "activity_days", "no_activity_days", "duration_seconds", "running_distance_km", "by_activity_kind"],
      "properties": {
        "activity_count": {"type": "integer", "minimum": 0},
        "activity_days": {"type": "integer", "minimum": 0, "maximum": 7},
        "no_activity_days": {"type": "integer", "minimum": 0, "maximum": 7},
        "duration_seconds": {"type": "number", "minimum": 0},
        "running_distance_km": {"type": "number", "minimum": 0},
        "by_activity_kind": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "running": {"type": "integer", "minimum": 0},
            "rock_climbing": {"type": "integer", "minimum": 0},
            "climbing": {"type": "integer", "minimum": 0},
            "cycling": {"type": "integer", "minimum": 0},
            "walking": {"type": "integer", "minimum": 0},
            "hiking": {"type": "integer", "minimum": 0},
            "strength_training": {"type": "integer", "minimum": 0},
            "rest": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "plan_comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["date_only_matches", "unplanned_activities", "comparison_is_secondary"],
      "properties": {
        "date_only_matches": {"type": "integer", "minimum": 0},
        "unplanned_activities": {"type": "integer", "minimum": 0},
        "comparison_is_secondary": {"type": "boolean", "const": true}
      }
    }
  }
}
