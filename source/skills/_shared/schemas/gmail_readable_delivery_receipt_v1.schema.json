{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/gmail_readable_delivery_receipt_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "error_code", "request_sha256", "requested_message_id", "mime_sha256", "gmail_message_id", "actual_rfc822_message_id", "provider_calls", "send_calls"],
  "properties": {
    "schema_version": {"type": "string", "const": "gmail_readable_delivery_receipt_v1"},
    "status": {"type": "string", "enum": ["succeeded", "blocked", "unknown"]},
    "error_code": {"type": ["string", "null"]},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_message_id": {"type": "string", "pattern": "^<trainlab\\.v2\\.[0-9a-f]{64}@trainlab\\.invalid>$"},
    "mime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gmail_message_id": {"type": ["string", "null"]},
    "actual_rfc822_message_id": {"type": ["string", "null"]},
    "provider_calls": {"type": "integer", "minimum": 0, "maximum": 4},
    "send_calls": {"type": "integer", "minimum": 0, "maximum": 1}
  }
}
