{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gmail_rest_auth_receipt_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "account_matches", "scopes_match",
    "refresh_token_available",
    "token_published", "short_lived_testing_token", "provider_calls",
    "completed_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "gmail_rest_auth_receipt_v1"},
    "status": {"enum": ["succeeded", "blocked"]},
    "account_matches": {"type": "boolean"},
    "scopes_match": {"type": "boolean"},
    "refresh_token_available": {"type": "boolean"},
    "token_published": {"type": "boolean"},
    "short_lived_testing_token": {"type": "boolean"},
    "provider_calls": {"type": "integer", "minimum": 0, "maximum": 1},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "error_code": {"type": "string", "minLength": 1}
  }
}
