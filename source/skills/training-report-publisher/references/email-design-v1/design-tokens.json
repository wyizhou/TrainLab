{
  "meta": {
    "name": "TrainLab Email System",
    "version": "1.0.0",
    "source": "trainlab-email-architecture-plan.md",
    "color_space": "OKLch source with sRGB email fallback"
  },
  "colors": {
    "background": { "oklch": "oklch(0.975 0.008 205)", "hex": "#F4F8F8" },
    "surface": { "oklch": "oklch(1 0 0)", "hex": "#FFFFFF" },
    "foreground": { "oklch": "oklch(0.305 0.040 220)", "hex": "#17323B" },
    "muted": { "oklch": "oklch(0.515 0.025 215)", "hex": "#556970" },
    "border": { "oklch": "oklch(0.900 0.020 205)", "hex": "#D7E4E6" },
    "accent": { "oklch": "oklch(0.525 0.100 190)", "hex": "#087A78" },
    "accent_soft": { "oklch": "oklch(0.945 0.035 190)", "hex": "#DDF3F0" }
  },
  "typography": {
    "font_family": "-apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Microsoft YaHei, sans-serif",
    "mono_family": "SFMono-Regular, Consolas, Menlo, monospace",
    "weights": { "read": 400, "emphasize": 550, "announce": 600 },
    "sizes_px": { "title_desktop": 28, "title_mobile": 24, "section": 20, "card_title": 17, "body": 16, "small": 13, "caption": 12 },
    "line_heights": { "title": 1.2, "section": 1.3, "body": 1.55, "small": 1.5 }
  },
  "spacing": { "2xs": 4, "xs": 8, "sm": 12, "md": 16, "lg": 20, "xl": 24, "2xl": 32, "3xl": 40 },
  "radius": { "small": 8, "medium": 12, "card": 16, "pill": 999 },
  "borders": {
    "default": "1px solid #D7E4E6",
    "strong": "1px solid #B9CCCF",
    "dark_mode": "1px solid rgba(255,255,255,0.12)"
  },
  "shadows": {
    "card": "0 8px 24px rgba(23,50,59,0.08)",
    "none_fallback": "none"
  },
  "status_colors": {
    "ready": { "text": "#1B6F47", "background": "#E7F5ED", "border": "#A9D7BD", "label": "可以训练" },
    "caution": { "text": "#8A5700", "background": "#FFF2CF", "border": "#E6C66D", "label": "需要谨慎" },
    "blocked": { "text": "#A7372F", "background": "#FDE9E6", "border": "#E6AAA4", "label": "报告已阻断" },
    "neutral": { "text": "#40535A", "background": "#EEF3F4", "border": "#CAD8DB", "label": "状态未知" }
  },
  "activity_colors": {
    "running": { "text": "#086B79", "background": "#DDF2F4", "chart": "#087B8C" },
    "climbing": { "text": "#98450F", "background": "#FCEBDD", "chart": "#B85B18" },
    "sleep": { "text": "#414A82", "background": "#E9EBF7", "chart": "#48548E" },
    "recovery": { "text": "#1B6F47", "background": "#E7F5ED", "chart": "#26744B" },
    "rest": { "text": "#4F5F66", "background": "#EDF1F2", "chart": "#6A777D" }
  },
  "chart_palette": ["#087B8C", "#B85B18", "#48548E", "#26744B", "#8A5700", "#A7372F"],
  "email_widths": {
    "outer_percent": 100,
    "desktop_px": 672,
    "desktop_content_px": 624,
    "mobile_artboard_px": 375,
    "mobile_content_px": 343,
    "desktop_padding_px": 24,
    "mobile_padding_px": 16,
    "chart_2x_width_px": 1248
  }
}
