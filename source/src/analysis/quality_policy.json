{
  "version": "5",
  "catalog_version": "garmin-v4",
  "routes": [
    "daily_summary",
    "weekly_summary",
    "weekly_plan",
    "revise_plan"
  ],
  "required_resources": [
    {"resource_kind": "activity_inventory", "cursor_required": false}
  ],
  "conditional_resources": [
    {"resource_kind": "body_composition", "cursor_required": true},
    {"resource_kind": "heart_rates", "cursor_required": true},
    {"resource_kind": "hrv", "cursor_required": true},
    {"resource_kind": "max_metrics", "cursor_required": true},
    {"resource_kind": "rhr", "cursor_required": true},
    {"resource_kind": "sleep", "cursor_required": true},
    {"resource_kind": "spo2", "cursor_required": true},
    {"resource_kind": "weigh_ins", "cursor_required": true}
  ],
  "max_reasons_per_bucket": 64,
  "max_snapshot_rows": 8000,
  "max_snapshot_bytes": 4000000,
  "max_entity_length": 96,
  "reason_codes": [
    "activity_absent_unconfirmed",
    "activity_inventory_incomplete",
    "activity_inventory_proof_missing",
    "activity_stage_incomplete",
    "capability_conflict",
    "capability_expired",
    "capability_missing",
    "capability_required_unavailable",
    "coverage_ambiguous",
    "coverage_error",
    "coverage_missing",
    "coverage_optional",
    "coverage_partial",
    "coverage_state_unknown",
    "cursor_ambiguous",
    "cursor_catalog_unknown",
    "cursor_hole",
    "cursor_missing",
    "facts_malformed",
    "gap_deferred",
    "gap_open",
    "gap_state_unknown",
    "gate_evidence_limit_exceeded",
    "plan_incomplete",
    "plan_lineage_invalid",
    "plan_reason_invalid",
    "quality_error",
    "quality_state_unknown",
    "quality_warning",
    "sleep_evidence_missing",
    "snapshot_malformed",
    "subject_identity_invalid"
  ]
}
