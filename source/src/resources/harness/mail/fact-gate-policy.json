    "mail_fact_gate_accepted",
    "mail_fact_gate_acknowledgement_loop",
    "mail_fact_gate_action_invalid",
    "mail_fact_gate_active_fact_invalid",
    "mail_fact_gate_current_plan_missing",
    "mail_fact_gate_dependency_failed",
    "mail_fact_gate_dependency_invalid",
    "mail_fact_gate_dependency_missing",
    "mail_fact_gate_dependency_ready",
    "mail_fact_gate_dependency_requested",
    "mail_fact_gate_dependency_source_missing",
    "mail_fact_gate_fact_candidate_invalid",
    "mail_fact_gate_fact_conflict",
    "mail_fact_gate_fact_identity_ambiguous",
    "mail_fact_gate_fact_not_explicit",
    "mail_fact_gate_fact_scope_invalid",
    "mail_fact_gate_fact_time_invalid",
    "mail_fact_gate_identity_invalid",
    "mail_fact_gate_internal",
    "mail_fact_gate_irrelevant_action",
    "mail_fact_gate_long_term_not_explicit",
    "mail_fact_gate_medical_diagnosis",
    "mail_fact_gate_operator_review_side_effect",
    "mail_fact_gate_plan_action_invalid",
    "mail_fact_gate_plan_constraint_not_explicit",
    "mail_fact_gate_plan_date_not_explicit",
