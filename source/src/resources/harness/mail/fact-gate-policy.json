    "mail_fact_gate_privileged_structure",
    "mail_fact_gate_provider_claim_unbound",
    "mail_fact_gate_reason_event_invalid",
    "mail_fact_gate_result_invalid"
  ],
  "limits": {
    "max_result_bytes": 262144,
    "max_json_depth": 8,
    "max_json_nodes": 20000,
    "max_temporary_days": 90
  },
  "intent_actions": {
    "feedback": ["store_only", "reply"],
    "health_or_activity_question": ["reply", "operator_review"],
    "training_question": ["reply", "operator_review"],
    "plan_change_request": ["await_analysis", "reply", "operator_review"],
    "user_fact_update": ["store_only", "reply", "operator_review"],
    "acknowledgement": ["store_only"],
    "non_trainlab_or_unsupported": ["ignore"],
    "safety_concern": ["reply", "operator_review"]
  },
  "fact_keys": {
    "training_goal": {"scopes": ["long_term"], "value_types": ["string"]},
    "training_preference": {"scopes": ["temporary", "long_term"], "value_types": ["string"]},
    "availability": {"scopes": ["temporary", "long_term"], "value_types": ["string"]},
    "schedule_constraint": {"scopes": ["temporary", "long_term"], "value_types": ["string"]},
    "equipment_access": {"scopes": ["temporary", "long_term"], "value_types": ["string"]},
    "injury_status": {"scopes": ["temporary"], "value_types": ["string"]},
    "pain_status": {"scopes": ["temporary"], "value_types": ["string"]},
    "recovery_status": {"scopes": ["temporary"], "value_types": ["string"]},
    "training_note": {"scopes": ["message_only"], "value_types": ["string"]}
  },
  "long_term_markers": [
