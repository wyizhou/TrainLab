{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/analysis_result.schema.json",
  "title": "TrainLab analysis result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_key", "mode", "subject_id", "status", "artifacts", "training_plan", "source_usage", "quality_disclosures", "safety", "warnings"],
  "properties": {
    "schema_version": {"const": "1"},
    "run_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "mode": {"enum": ["daily", "weekly", "revise_plan", "regenerate"]},
    "subject_id": {"type": "integer", "minimum": 1},
    "status": {"const": "accepted"},
    "artifacts": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"$ref": "#/$defs/artifact"}},
    "training_plan": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/training_plan"}, {"$ref": "#/$defs/revision_training_plan"}]},
    "source_usage": {"type": "array", "minItems": 1, "maxItems": 4000, "items": {"$ref": "#/$defs/source_usage"}},
    "quality_disclosures": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/disclosure"}},
    "safety": {"anyOf": [{"$ref": "#/$defs/safety"}, {"$ref": "#/$defs/weekly_safety"}, {"$ref": "#/$defs/revision_safety"}]},
    "warnings": {"type": "array", "maxItems": 128, "items": {"type": "string", "minLength": 1, "maxLength": 1000}}
  },
  "$defs": {
    "period": {"type": "object", "additionalProperties": false, "required": ["start_local_date", "end_local_date"], "properties": {"start_local_date": {"type": "string", "format": "date"}, "end_local_date": {"type": "string", "format": "date"}}},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "period", "structured_content", "user_visible_text"],
      "properties": {
        "artifact_kind": {"enum": ["daily_summary", "daily_training_advice", "weekly_summary", "weekly_training_plan"]},
        "period": {"$ref": "#/$defs/period"},
        "structured_content": {"$ref": "#/$defs/json_value"},
        "user_visible_text": {"type": "string", "minLength": 1, "maxLength": 30000}
      },
      "allOf": [
        {
          "if": {"properties": {"artifact_kind": {"const": "daily_summary"}}},
          "then": {"properties": {"structured_content": {"$ref": "#/$defs/daily_summary_content"}}}
        },
        {
          "if": {"properties": {"artifact_kind": {"const": "daily_training_advice"}}},
          "then": {"properties": {"structured_content": {"$ref": "#/$defs/daily_advice_content"}}}
        }
      ]
    },
    "daily_summary_content": {
      "type": "object", "additionalProperties": false,
      "additionalProperties": false,
      "required": ["overall_state", "decision_factors", "activity_evidence", "plan_evidence", "data_completeness"],
      "properties": {
        "overall_state": {"type": "string", "minLength": 1, "maxLength": 500},
        "decision_factors": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
        "activity_highlights": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"enum": ["cadence", "power", "ascent"]}},
        "activity_evidence": {"enum": ["confirmed_recorded", "confirmed_no_recorded_activity", "partial", "unconfirmed"]},
        "plan_evidence": {"enum": ["available", "partial", "unavailable"]},
        "data_completeness": {"enum": ["complete", "partial", "limited"]}
      }
    },
    "daily_advice_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_item", "configured_difficulty_level", "selected_session_difficulty_level", "difficulty_adjustment_reason", "confidence", "confidence_reason", "data_limitation"],
      "properties": {
        "primary_item": {"$ref": "#/$defs/daily_primary_item"},
        "configured_difficulty_level": {"type": "integer", "minimum": 1, "maximum": 5},
        "selected_session_difficulty_level": {"type": "integer", "minimum": 1, "maximum": 5},
        "difficulty_adjustment_reason": {"type": ["string", "null"], "maxLength": 500},
        "confidence": {"enum": ["较高", "一般", "较低"]},
        "confidence_reason": {"type": "string", "minLength": 1, "maxLength": 500},
        "data_limitation": {"type": ["string", "null"], "maxLength": 500},
        "plan_decision": {"enum": ["as_planned", "modify_today", "postpone", "cancel"]}
      }
    },
    "source_usage": {"type": "object", "additionalProperties": false, "required": ["ordinal", "input_role", "source_entity_id", "source_revision_id"], "properties": {"ordinal": {"type": "integer", "minimum": 0, "maximum": 3999}, "input_role": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,95}$"}, "source_entity_id": {"type": "string", "minLength": 1, "maxLength": 192}, "source_revision_id": {"type": "string", "minLength": 1, "maxLength": 192}}},
    "disclosure": {"type": "object", "additionalProperties": false, "required": ["code", "entity"], "properties": {"code": {"type": "string", "pattern": "^[a-z0-9_]{1,96}$"}, "entity": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9_.:-]+$"}}},
    "prescription_token": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,95}$"},
    "prescription_bpm_range": {"type": "object", "additionalProperties": false, "required": ["minimum_bpm", "maximum_bpm"], "properties": {"minimum_bpm": {"type": "integer", "minimum": 30, "maximum": 250}, "maximum_bpm": {"type": "integer", "minimum": 30, "maximum": 250}}},
    "prescription_interval": {"type": "object", "additionalProperties": false, "required": ["work_seconds", "recovery_seconds", "repetitions", "target_zone"], "properties": {"work_seconds": {"type": "integer", "minimum": 15, "maximum": 1800}, "recovery_seconds": {"type": "integer", "minimum": 15, "maximum": 1800}, "repetitions": {"type": "integer", "minimum": 1, "maximum": 20}, "target_zone": {"type": "integer", "minimum": 1, "maximum": 5}}},
    "prescription_pace_range": {"type": "object", "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number", "minimum": 0}, "max": {"type": "number", "minimum": 0}}},
    "running_prescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_kind", "hansons_session_role", "course_type", "warmup", "main_set", "cooldown", "planned_duration_minutes", "total_volume", "target_zone", "target_bpm_range", "prescribed_rpe", "talk_test", "work_intervals", "stop_conditions", "rationale"],
      "properties": {
        "activity_kind": {"const": "running"},
        "hansons_session_role": {"enum": ["easy", "long", "tempo", "speed", "running_strength"]},
        "course_type": {"enum": ["easy", "steady", "long_easy", "intervals"]},
        "warmup": {"$ref": "#/$defs/prescription_token"},
        "main_set": {"$ref": "#/$defs/prescription_token"},
        "cooldown": {"$ref": "#/$defs/prescription_token"},
        "planned_duration_minutes": {"type": "integer", "minimum": 10, "maximum": 240},
        "planned_duration_seconds": {"type": "integer", "minimum": 600, "maximum": 14400},
        "total_volume": {"$ref": "#/$defs/prescription_token"},
        "target_zone": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 1, "maximum": 5}]},
        "target_bpm_range": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/prescription_bpm_range"}]},
        "prescribed_rpe": {"type": "number", "minimum": 1, "maximum": 10},
        "talk_test": {"$ref": "#/$defs/prescription_token"},
        "work_intervals": {"type": "array", "maxItems": 20, "items": {"$ref": "#/$defs/prescription_interval"}},
        "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"enum": ["acute_pain", "chest_pain", "fainting_or_dizziness", "unusual_shortness_of_breath"]}},
        "rationale": {"$ref": "#/$defs/prescription_token"},
        "planned_distance_m": {"type": ["number", "null"], "minimum": 0},
        "planned_distance_km": {"type": ["number", "null"], "minimum": 0},
        "distance_m": {"type": ["number", "null"], "minimum": 0},
        "pace_seconds_per_km": {"oneOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/prescription_pace_range"}]},
        "target_pace_seconds_per_km": {"oneOf": [{"type": "number", "minimum": 0}, {"$ref": "#/$defs/prescription_pace_range"}]},
        "course_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
        "rationale_text": {"type": ["string", "null"], "maxLength": 10000},
        "hard_session": {"type": "boolean"},
        "recovery_cost_hours": {"type": "integer", "minimum": 0, "maximum": 120},
        "garmin_mapping": {"enum": ["candidate", "requires_review", "unsupported_skip"]}
      }
    },
    "climbing_prescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_kind", "rationale"],
      "properties": {
        "activity_kind": {"const": "climbing"},
        "rationale": {"$ref": "#/$defs/prescription_token"},
        "course_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,95}$"},
        "planned_duration_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "planned_duration_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "prescribed_rpe": {"type": "number", "minimum": 1, "maximum": 10},
        "hard_session": {"type": "boolean"},
        "garmin_mapping": {"const": "unsupported_skip"},
        "recovery_cost_hours": {"type": "integer", "minimum": 0, "maximum": 120},
        "course_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
        "rationale_text": {"type": ["string", "null"], "maxLength": 10000}
      }
    },
    "rest_prescription": {
      "type": "object", "additionalProperties": false,
      "required": ["activity_kind", "evidence", "uncertainty", "daily_activity_allowed", "recovery_signals", "seek_professional_help_if"],
      "properties": {
        "activity_kind": {"const": "rest"},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/prescription_token"}},
        "uncertainty": {"$ref": "#/$defs/prescription_token"},
        "daily_activity_allowed": {"type": "boolean"},
        "recovery_signals": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/prescription_token"}},
        "seek_professional_help_if": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/prescription_token"}}
      }
    },
    "prescription": {"oneOf": [{"$ref": "#/$defs/running_prescription"}, {"$ref": "#/$defs/climbing_prescription"}, {"$ref": "#/$defs/rest_prescription"}]},
    "safety": {"type": "object", "additionalProperties": false, "required": ["safety_state", "primary_item"], "properties": {"safety_state": {"enum": ["normal", "warning", "suspended"]}, "primary_item": {"$ref": "#/$defs/json_value"}}},
    "prior_artifact_state": {
      "type": "object", "additionalProperties": false,
      "required": ["summary", "plan"],
      "properties": {
        "summary": {"enum": ["available", "no_prior_artifact"]},
        "plan": {"enum": ["available", "no_prior_artifact"]}
      }
    },
    "plan_item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_index", "local_date", "activity_kind", "prescription", "course_contract", "rationale_text", "stop_conditions"],
      "properties": {
        "item_index": {"type": "integer", "minimum": 0, "maximum": 6},
        "local_date": {"type": "string", "format": "date"},
        "activity_kind": {"enum": ["running", "climbing", "rest"]},
        "prescription": {"$ref": "#/$defs/prescription"},
        "course_contract": {"$ref": "#/$defs/course_contract"},
        "rationale_text": {"type": ["string", "null"], "maxLength": 10000},
        "stop_conditions": {"type": "array", "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "daily_primary_item": {
      "type": "object",
      "required": ["activity_kind", "course_contract"],
      "properties": {
        "activity_kind": {"enum": ["running", "climbing", "rest"]},
        "course_contract": {"$ref": "#/$defs/course_contract"}
      },
      "additionalProperties": true
    },
    "course_contract": {
      "type": "object",
      "required": ["schema_version", "local_date", "activity_kind", "course_name", "purpose", "dose", "steps", "targets", "guardrails", "load_level", "recovery_cost", "degradation_rule", "stop_conditions", "garmin_mapping"],
      "properties": {
        "schema_version": {"const": "2"},
        "local_date": {"type": "string", "format": "date"},
        "activity_kind": {"enum": ["running", "climbing", "rest"]},
        "course_name": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "dose": {"type": "object", "required": ["distance_m", "duration_seconds"]},
        "steps": {"type": "array", "minItems": 1},
        "targets": {"type": "object"},
        "guardrails": {"type": "array"},
        "load_level": {"enum": ["recovery", "easy", "moderate", "hard", "very_hard", "unknown"]},
        "recovery_cost": {"type": "integer", "minimum": 0},
        "degradation_rule": {"type": "string", "minLength": 1},
        "stop_conditions": {"type": "array", "minItems": 1},
        "garmin_mapping": {"enum": ["candidate", "requires_review", "unsupported_skip"]}
      },
      "additionalProperties": false
    },
    "training_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["period", "timezone", "objective", "constraints", "prior_artifact_state", "items"],
      "properties": {
        "period": {"$ref": "#/$defs/period"},
        "timezone": {"const": "Asia/Hong_Kong"},
        "objective": {"type": "object", "maxProperties": 64, "additionalProperties": {"$ref": "#/$defs/json_value"}},
        "constraints": {"type": "object", "maxProperties": 64, "additionalProperties": {"$ref": "#/$defs/json_value"}},
        "prior_artifact_state": {"$ref": "#/$defs/prior_artifact_state"},
        "items": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/plan_item"}}
      }
    },
    "revision_training_plan": {
      "type": "object", "additionalProperties": false,
      "required": ["period", "timezone", "objective", "constraints", "original_plan_id", "original_artifact_id", "reason_event_id", "effective_local_date", "items"],
      "properties": {
        "period": {"$ref": "#/$defs/period"},
        "timezone": {"const": "Asia/Hong_Kong"},
        "objective": {"type": "object", "maxProperties": 64, "additionalProperties": {"$ref": "#/$defs/json_value"}},
        "constraints": {"type": "object", "maxProperties": 64, "additionalProperties": {"$ref": "#/$defs/json_value"}},
        "original_plan_id": {"type": "string", "minLength": 1, "maxLength": 192},
        "original_artifact_id": {"type": "string", "minLength": 1, "maxLength": 192},
        "reason_event_id": {"type": "string", "minLength": 1, "maxLength": 192},
        "effective_local_date": {"type": "string", "format": "date"},
        "items": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/plan_item"}}
      }
    },
    "weekly_safety_item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_index", "local_date", "safety_state", "primary_item"],
      "properties": {
        "item_index": {"type": "integer", "minimum": 0, "maximum": 6},
        "local_date": {"type": "string", "format": "date"},
        "safety_state": {"enum": ["normal", "warning", "suspended"]},
        "primary_item": {"$ref": "#/$defs/json_value"}
      }
    },
    "weekly_safety": {
      "type": "object", "additionalProperties": false,
      "required": ["safety_state", "plan_items"],
      "properties": {
        "safety_state": {"enum": ["normal", "warning", "suspended"]},
        "plan_items": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/weekly_safety_item"}}
      }
    },
    "revision_safety": {
      "type": "object", "additionalProperties": false,
      "required": ["safety_state", "plan_items"],
      "properties": {
        "safety_state": {"enum": ["normal", "warning", "suspended"]},
        "plan_items": {"type": "array", "minItems": 0, "maxItems": 7, "items": {"$ref": "#/$defs/weekly_safety_item"}}
      }
    },
    "json_value": {"anyOf": [{"type": "null"}, {"type": "boolean"}, {"type": "number"}, {"type": "string", "maxLength": 10000}, {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/json_value"}}, {"type": "object", "maxProperties": 128, "propertyNames": {"type": "string", "maxLength": 128}, "additionalProperties": {"$ref": "#/$defs/json_value"}}]}
  }
}
