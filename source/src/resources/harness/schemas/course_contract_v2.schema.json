{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/course_contract_v2.schema.json",
  "title": "TrainLab course contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "local_date", "activity_kind", "course_name", "purpose", "dose", "steps", "targets", "guardrails", "load_level", "recovery_cost", "degradation_rule", "stop_conditions", "garmin_mapping"],
  "properties": {
    "schema_version": {"const": "2"},
    "local_date": {"type": "string", "format": "date"},
    "activity_kind": {"enum": ["running", "climbing", "rest"]},
    "course_name": {"type": "string", "minLength": 1, "maxLength": 160},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "dose": {"$ref": "#/$defs/dose"},
    "steps": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/step"}},
    "targets": {"$ref": "#/$defs/targets"},
    "guardrails": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "load_level": {"enum": ["recovery", "easy", "moderate", "hard", "very_hard", "unknown"]},
    "recovery_cost": {"type": "integer", "minimum": 0, "maximum": 120},
    "degradation_rule": {"type": "string", "minLength": 1, "maxLength": 500},
    "stop_conditions": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "garmin_mapping": {"enum": ["candidate", "requires_review", "unsupported_skip"]}
  },
  "$defs": {
    "dose": {"type": "object", "additionalProperties": false, "required": ["distance_m", "duration_seconds"], "properties": {"distance_m": {"type": ["number", "null"], "minimum": 0}, "duration_seconds": {"type": ["number", "null"], "minimum": 0}, "hard_session": {"type": "boolean"}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["name", "end_condition", "end_value"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "end_condition": {"enum": ["duration_seconds", "distance_m", "repetitions", "until_symptom_or_guardrail"]}, "end_value": {"type": ["number", "integer", "string"], "minLength": 1}, "notes": {"type": "string", "maxLength": 500}}},
    "targets": {"type": "object", "additionalProperties": false, "required": ["pace_seconds_per_km", "heart_rate_bpm", "rpe", "talk_test"], "properties": {"pace_seconds_per_km": {"type": ["object", "null"], "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number", "minimum": 0}, "max": {"type": "number", "minimum": 0}}}, "heart_rate_bpm": {"type": ["object", "null"], "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number", "minimum": 0}, "max": {"type": "number", "minimum": 0}}}, "rpe": {"type": ["object", "null"], "additionalProperties": false, "required": ["min", "max"], "properties": {"min": {"type": "number", "minimum": 0, "maximum": 10}, "max": {"type": "number", "minimum": 0, "maximum": 10}}}, "talk_test": {"type": ["string", "null"], "maxLength": 240}}}
  },
  "allOf": [
    {
      "if": {"properties": {"activity_kind": {"enum": ["running", "climbing"]}}},
      "then": {
        "properties": {
          "dose": {"anyOf": [{"properties": {"distance_m": {"type": "number"}}}, {"properties": {"duration_seconds": {"type": "number"}}}]}
        }
      }
    },
    {
      "if": {"properties": {"activity_kind": {"const": "climbing"}}},
      "then": {
        "properties": {
          "garmin_mapping": {"const": "unsupported_skip"},
          "targets": {"properties": {"pace_seconds_per_km": {"const": null}}}
        }
      }
    },
    {
      "if": {"properties": {"activity_kind": {"const": "rest"}}},
      "then": {
        "properties": {
          "dose": {"properties": {"distance_m": {"const": 0}, "duration_seconds": {"const": 0}}},
          "garmin_mapping": {"const": "unsupported_skip"}
        }
      }
    }
  ]
}
