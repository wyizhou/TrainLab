{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/coaching_profile_contract_v1.schema.json",
  "title": "TrainLab coaching profile contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "weekly_capacity_km", "weekly_frequency", "hard_load_max", "hard_load_min_gap_days", "climbing_schedule"],
  "properties": {
    "schema_version": {"const": "1"},
    "status": {"enum": ["unconfigured", "confirmed"]},
    "weekly_capacity_km": {"type": ["number", "null"], "minimum": 0},
    "weekly_frequency": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
    "long_run_max_km": {"type": ["number", "null"], "minimum": 0},
    "hard_load_max": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
    "hard_load_min_gap_days": {"type": ["integer", "null"], "minimum": 0, "maximum": 7},
    "available_weekdays": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}},
    "climbing_schedule": {"type": "array", "maxItems": 7, "items": {"type": "object", "additionalProperties": false, "required": ["weekday", "load_level"], "properties": {"weekday": {"type": "integer", "minimum": 1, "maximum": 7}, "load_level": {"enum": ["easy", "moderate", "hard", "unknown"]}, "duration_minutes": {"type": ["integer", "null"], "minimum": 0, "maximum": 600}}}},
    "race_goal": {"type": ["string", "null"], "maxLength": 64},
    "progression_rule": {"enum": ["conservative", "confirmed_only", null]}
  }
}
