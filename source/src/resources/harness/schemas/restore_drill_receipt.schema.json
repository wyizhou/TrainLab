{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/restore_drill_receipt.schema.json",
  "title": "TrainLab isolated restore drill receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_kind", "run_id", "status", "database_kind", "partitions", "checks", "external_effects"],
  "properties": {
    "schema_version": {"const": "1"},
    "receipt_kind": {"const": "restore_drill"},
    "run_id": {"type": "string", "pattern": "^restore-drill-[0-9a-f]{32}$"},
    "status": {"const": "succeeded"},
    "database_kind": {"const": "sanitized_generated"},
    "partitions": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"enum": ["valid-current", "valid-previous-supported", "corrupt-backup", "missing-manifest", "newer-unsupported-schema", "older-unsupported-schema", "interrupted-restore"]}
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity", "foreign_keys", "schema", "manifest", "promotion"],
      "properties": {
        "integrity": {"const": true},
        "foreign_keys": {"const": true},
        "schema": {"const": true},
        "manifest": {"const": true},
        "promotion": {"const": true}
      }
    },
    "external_effects": {"const": false}
  }
}
