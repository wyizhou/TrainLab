{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/weekly_capacity_assessment_v1.schema.json",
  "title": "TrainLab weekly capacity assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "decision", "plan_period", "complete_weeks", "baseline", "allowed_range", "frequency", "long_run_max_km", "hard_load", "single_change_dimension", "race_pace_anchor", "reason"],
  "properties": {
    "schema_version": {"const": "1"},
    "status": {"enum": ["ready", "deferred"]},
    "decision": {"enum": ["advance", "hold", "deload"]},
    "plan_period": {"type": "object", "additionalProperties": false, "required": ["start_local_date", "end_local_date"], "properties": {"start_local_date": {"type": "string", "format": "date"}, "end_local_date": {"type": "string", "format": "date"}}},
    "complete_weeks": {"type": "array", "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["start_local_date", "end_local_date", "distance_km", "running_count", "longest_run_km", "hard_load_count"], "properties": {"start_local_date": {"type": "string", "format": "date"}, "end_local_date": {"type": "string", "format": "date"}, "distance_km": {"type": "number", "minimum": 0}, "running_count": {"type": "integer", "minimum": 0}, "longest_run_km": {"type": "number", "minimum": 0}, "hard_load_count": {"type": "integer", "minimum": 0}}}},
    "baseline": {"type": "object", "additionalProperties": false, "required": ["weekly_km_median", "frequency_median_floor", "longest_run_km_median", "hard_load_median_floor"], "properties": {"weekly_km_median": {"type": "number", "minimum": 0}, "frequency_median_floor": {"type": "integer", "minimum": 0}, "longest_run_km_median": {"type": "number", "minimum": 0}, "hard_load_median_floor": {"type": "integer", "minimum": 0}}},
    "allowed_range": {"type": "object", "additionalProperties": false, "required": ["minimum_km", "maximum_km"], "properties": {"minimum_km": {"type": "number", "minimum": 0}, "maximum_km": {"type": "number", "minimum": 0}}},
    "frequency": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "allowed_weekdays"], "properties": {"minimum": {"type": "integer", "minimum": 0, "maximum": 4}, "maximum": {"type": "integer", "minimum": 0, "maximum": 4}, "allowed_weekdays": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}}}},
    "long_run_max_km": {"type": "number", "minimum": 0},
    "hard_load": {"type": "object", "additionalProperties": false, "required": ["maximum", "minimum_gap_days"], "properties": {"maximum": {"type": "integer", "minimum": 0, "maximum": 7}, "minimum_gap_days": {"type": "integer", "minimum": 0, "maximum": 7}}},
    "single_change_dimension": {"enum": ["volume", "intensity", "none"]},
    "race_pace_anchor": {"const": false},
    "reason": {"type": "string", "minLength": 1, "maxLength": 240}
  }
}
