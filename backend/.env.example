TRAINLAB_ENVIRONMENT=development
TRAINLAB_DATABASE_URL=postgresql+psycopg://trainlab:trainlab@localhost:5432/trainlab
TRAINLAB_PUBLIC_ORIGIN=http://localhost:8000
TRAINLAB_TRUSTED_ORIGINS=["http://localhost:8000","http://localhost:5173"]
TRAINLAB_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
TRAINLAB_SESSION_COOKIE_SECURE=false
TRAINLAB_FRONTEND_DIST=../frontend/dist
TRAINLAB_PRIVATE_STORAGE_ROOT=./data/private
TRAINLAB_FIT_UPLOAD_MAX_BYTES=52428800
TRAINLAB_IMPORT_PROCESSING_STALE_MINUTES=15
TRAINLAB_USER_STORAGE_MAX_BYTES=5368709120
TRAINLAB_USER_STORAGE_MAX_FILES=10000
TRAINLAB_STORAGE_STAGING_GRACE_MINUTES=60
TRAINLAB_LOG_LEVEL=INFO
