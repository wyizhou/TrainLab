<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.trainlab.orchestrator-supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>@PYTHON_EXECUTABLE@</string>
    <string>-m</string>
    <string>trainlab</string>
    <string>supervisor</string>
    <string>run</string>
  </array>
  <key>WorkingDirectory</key>
  <string>@PROJECT_ROOT@</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>TZ</key>
    <string>Asia/Singapore</string>
    <key>PATH</key>
    <string>@RUNTIME_PATH@</string>
    <key>__PYVENV_LAUNCHER__</key>
    <string>@PROJECT_ROOT@/.venv/bin/python</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>@PROJECT_ROOT@/logs/supervisor.launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>@PROJECT_ROOT@/logs/supervisor.launchd.err.log</string>
</dict>
</plist>
