<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.trainlab.watchdog</string>
  <key>ProgramArguments</key><array><string>@PROJECT_ROOT@/.venv/bin/python</string><string>@PROJECT_ROOT@/scripts/watchdog.py</string></array>
  <key>WorkingDirectory</key><string>@PROJECT_ROOT@</string>
  <key>EnvironmentVariables</key><dict><key>TRAINLAB_CONFIG</key><string>@PROJECT_ROOT@/config/trainlab.production.yaml</string></dict>
  <key>StartInterval</key><integer>60</integer><key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>@PROJECT_ROOT@/logs/watchdog.out.log</string>
  <key>StandardErrorPath</key><string>@PROJECT_ROOT@/logs/watchdog.err.log</string>
</dict></plist>
