[Unit]
Description=TrainLab health and FIT ingest daemon

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/.venv/bin/python @PROJECT_ROOT@/scripts/ingest_daemon.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
Environment=TRAINLAB_CONFIG=@PROJECT_ROOT@/config/trainlab.production.yaml

[Install]
WantedBy=default.target
