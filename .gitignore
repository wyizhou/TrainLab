.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
*.egg-info/
build/
dist/

# Personal health data and runtime-only files are excluded from normal commits.
# A deliberately sanitized snapshot can still be added explicitly with git -f.
*.[Ff][Ii][Tt]
raw/
data.db
data.db-wal
data.db-shm
data.db-journal
*.db
*.db-*
*.sqlite
*.sqlite3
*.lock
!source/requirements.lock

# The old runtime is retained outside the product tree for rollback/audit only.
/data-backup/

# Product instance data is local-only. Public documentation and examples are
# re-included below so the source tree itself remains visible to Git.
/source/state/**
!/source/state/.gitkeep
/source/logs/**
!/source/logs/.gitkeep
/source/config/**
!/source/config/README.md
!/source/config/examples/
!/source/config/examples/**
/source/**/raw/
/source/**/test_data/
/source/**/private/
/source/*.db
/source/*.db-*
/source/*.sqlite
/source/*.sqlite3
/source/credentials.json
/source/gcp-oauth.keys.json
/source/token.json
/source/*token*.json
/source/**/garmin_tokens.json
/source/**/secrets/

# Legacy root instance paths are ignored only during the migration window.
/state/
/logs/
/config/*.yaml
/config/*.json

# Credentials must never enter repository history.
.env
.env.*
config/gmail_mcp.yaml
config/foundation.yaml
config/garmin.yaml
config/trainlab.production.yaml
config/rclone.conf
config/trainlab.json
config/orchestration.yaml
credentials.json
gmail-mcp.credentials.json
token.json
gcp-oauth.keys.json
