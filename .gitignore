.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Personal health data and runtime-only files are excluded from normal commits.
# A deliberately sanitized snapshot can still be added explicitly with git -f.
*.[Ff][Ii][Tt]
source/
test_data/
raw/
data.db
data.db-wal
data.db-shm
data.db-journal
*.db
*.db-*
*.sqlite
*.sqlite3
state/*
!state/.gitkeep
logs/*
!logs/.gitkeep
*.lock
!requirements.lock

# Garmin Full archives are permanent local evidence, never Git content.
# Raw provider JSON and extracted FIT files stay on disk indefinitely; the
# database and sync state that reference them are local-only as well.
/state/foundation/raw/garmin/json/
/state/foundation/raw/garmin/fit/
/state/foundation/data.db
/state/foundation/data.db-*
/state/foundation/state/

# Credentials must never enter repository history.
.env
.env.*
state/**/secrets/garmin/
config/gmail_mcp.yaml
config/foundation.yaml
config/garmin.yaml
config/trainlab.production.yaml
config/rclone.conf
config/trainlab.json
config/orchestration.yaml
credentials.json
gmail-mcp.credentials.json
token.json
gcp-oauth.keys.json
