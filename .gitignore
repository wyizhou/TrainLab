.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Personal health data and runtime-only files are excluded from normal commits.
# A deliberately sanitized snapshot can still be added explicitly with git -f.
source/
test_data/
data.db
data.db-wal
data.db-shm
data.db-journal
state/*
!state/.gitkeep
logs/*
!logs/.gitkeep
*.lock
!requirements.lock

# Credentials must never enter repository history.
.env
.env.*
config/gmail_mcp.yaml
config/trainlab.production.yaml
config/rclone.conf
credentials.json
token.json
