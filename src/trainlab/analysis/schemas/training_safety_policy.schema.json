{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/training_safety_policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "timezone",
    "zone_boundary_policy",
    "zone_source_priority",
    "hrr_zone_percentages",
    "fallback",
    "quality_session",
    "controlled_tokens",
    "required_running_stop_conditions",
    "required_strength_stop_conditions",
    "red_flag_signal_kinds",
    "hr_blocking_signal_kinds",
    "climbing_blocking_signal_kinds",
    "strength_blocking_signal_kinds",
    "reason_codes"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "policy_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "timezone": {"const": "Asia/Singapore"},
    "zone_boundary_policy": {"const": "inclusive_contiguous_no_overlap"},
    "zone_source_priority": {
      "const": ["garmin_sport_zones", "user_zones", "hrr"]
    },
    "hrr_zone_percentages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["1", "2", "3", "4", "5"],
      "properties": {
        "1": {"$ref": "#/$defs/percentage_pair"},
        "2": {"$ref": "#/$defs/percentage_pair"},
        "3": {"$ref": "#/$defs/percentage_pair"},
        "4": {"$ref": "#/$defs/percentage_pair"},
        "5": {"$ref": "#/$defs/percentage_pair"}
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_rpe", "maximum_duration_minutes", "course_type"],
      "properties": {
        "maximum_rpe": {"type": "integer", "minimum": 1, "maximum": 9},
        "maximum_duration_minutes": {"type": "integer", "minimum": 10, "maximum": 120},
        "course_type": {"const": "easy"}
      }
    },
    "quality_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lookback_days",
        "maximum_prior_sessions",
        "minimum_recovery_hours",
        "zone4_maximum_total_work_seconds",
        "zone5_maximum_total_work_seconds",
        "zone4_maximum_single_work_seconds",
        "zone5_maximum_single_work_seconds",
        "minimum_recovery_to_work_ratio",
        "minimum_warmup_cooldown_seconds",
        "quality_rpe_threshold",
        "maximum_rpe"
      ],
      "properties": {
        "lookback_days": {"type": "integer", "minimum": 1, "maximum": 28},
        "maximum_prior_sessions": {"type": "integer", "minimum": 0, "maximum": 4},
        "minimum_recovery_hours": {"type": "integer", "minimum": 24, "maximum": 168},
        "zone4_maximum_total_work_seconds": {"type": "integer", "minimum": 60, "maximum": 3600},
        "zone5_maximum_total_work_seconds": {"type": "integer", "minimum": 30, "maximum": 1800},
        "zone4_maximum_single_work_seconds": {"type": "integer", "minimum": 30, "maximum": 1800},
        "zone5_maximum_single_work_seconds": {"type": "integer", "minimum": 15, "maximum": 600},
        "minimum_recovery_to_work_ratio": {"type": "number", "minimum": 0.5, "maximum": 4},
        "minimum_warmup_cooldown_seconds": {"type": "integer", "minimum": 300, "maximum": 1800},
        "quality_rpe_threshold": {"type": "integer", "minimum": 6, "maximum": 9},
        "maximum_rpe": {"type": "integer", "minimum": 1, "maximum": 9}
      }
    },
    "controlled_tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "running_warmup",
        "running_main_set",
        "running_cooldown",
        "running_total_volume",
        "running_talk_test",
        "running_rationale",
        "climbing_rationale",
        "strength_rationale",
        "strength_exercises",
        "rest_evidence",
        "rest_uncertainty",
        "rest_recovery_signals",
        "rest_seek_help"
      ],
      "properties": {
        "running_warmup": {"$ref": "#/$defs/token_set"},
        "running_main_set": {"$ref": "#/$defs/token_set"},
        "running_cooldown": {"$ref": "#/$defs/token_set"},
        "running_total_volume": {"$ref": "#/$defs/token_set"},
        "running_talk_test": {"$ref": "#/$defs/token_set"},
        "running_rationale": {"$ref": "#/$defs/token_set"},
        "climbing_rationale": {"$ref": "#/$defs/token_set"},
        "strength_rationale": {"$ref": "#/$defs/token_set"},
        "strength_exercises": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"enum": ["squat", "hinge", "push", "pull", "carry", "core"]}
        },
        "rest_evidence": {"$ref": "#/$defs/token_set"},
        "rest_uncertainty": {"$ref": "#/$defs/token_set"},
        "rest_recovery_signals": {"$ref": "#/$defs/token_set"},
        "rest_seek_help": {"$ref": "#/$defs/token_set"}
      }
    },
    "required_running_stop_conditions": {"$ref": "#/$defs/string_set"},
    "required_strength_stop_conditions": {"$ref": "#/$defs/string_set"},
    "red_flag_signal_kinds": {"$ref": "#/$defs/string_set"},
    "hr_blocking_signal_kinds": {"$ref": "#/$defs/string_set"},
    "climbing_blocking_signal_kinds": {"$ref": "#/$defs/string_set"},
    "strength_blocking_signal_kinds": {"$ref": "#/$defs/string_set"},
    "reason_codes": {"$ref": "#/$defs/string_set"}
  },
  "$defs": {
    "percentage_pair": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "string_set": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 96},
      "minItems": 1,
      "uniqueItems": true
    },
    "token_set": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,95}$"},
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
