{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trainlab.local/schemas/training_safety_request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_id",
    "advice_local_date",
    "as_of_utc",
    "primary_items",
    "zone_evidence",
    "safety_signals",
    "quality_sessions",
    "substitution"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "subject_id": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "minLength": 1, "maxLength": 128}
      ]
    },
    "advice_local_date": {"type": "string", "format": "date"},
    "as_of_utc": {"type": "string", "format": "date-time"},
    "primary_items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {"$ref": "#/$defs/primary_item"}
    },
    "zone_evidence": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/zone_evidence"}
    },
    "safety_signals": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/safety_signal"}
    },
    "quality_sessions": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/quality_session"}
    },
    "substitution": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/substitution"}
      ]
    }
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,95}$"},
    "revision_id": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "minLength": 1, "maxLength": 128}
      ]
    },
    "bpm_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_bpm", "maximum_bpm"],
      "properties": {
        "minimum_bpm": {"type": "integer", "minimum": 30, "maximum": 250},
        "maximum_bpm": {"type": "integer", "minimum": 30, "maximum": 250}
      }
    },
    "zone_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["zone", "minimum_bpm", "maximum_bpm"],
      "properties": {
        "zone": {"type": "integer", "minimum": 1, "maximum": 5},
        "minimum_bpm": {"type": "integer", "minimum": 30, "maximum": 250},
        "maximum_bpm": {"type": "integer", "minimum": 30, "maximum": 250}
      }
    },
    "zone_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "source_kind",
        "source_revision_id",
        "current",
        "reliability",
        "effective_from_utc",
        "expires_at_utc",
        "sport",
        "zones",
        "heart_rate_bpm",
        "measurement_method"
      ],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_kind": {
          "enum": [
            "garmin_sport_zones",
            "user_zones",
            "max_hr_baseline",
            "resting_hr_baseline",
            "time_in_zone",
            "age_formula",
            "single_sample_max_hr"
          ]
        },
        "source_revision_id": {"$ref": "#/$defs/revision_id"},
        "current": {"type": "boolean"},
        "reliability": {"enum": ["reliable", "unreliable", "unknown"]},
        "effective_from_utc": {"type": "string", "format": "date-time"},
        "expires_at_utc": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        },
        "sport": {
          "oneOf": [
            {"type": "null"},
            {"const": "running"}
          ]
        },
        "zones": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {"$ref": "#/$defs/zone_boundary"}
            }
          ]
        },
        "heart_rate_bpm": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 30, "maximum": 250}
          ]
        },
        "measurement_method": {
          "enum": [
            "provider_profile",
            "user_verified",
            "multiple_observations",
            "single_sample",
            "age_formula",
            "activity_time_in_zone",
            "not_applicable"
          ]
        }
      }
    },
    "safety_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signal_id",
        "kind",
        "origin",
        "source_revision_id",
        "current",
        "active",
        "effective_from_utc",
        "expires_at_utc"
      ],
      "properties": {
        "signal_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "kind": {
          "enum": [
            "chest_pain",
            "fainting",
            "acute_injury",
            "acute_pain",
            "device_anomaly",
            "hr_affecting_medication",
            "hr_baseline_unreliable",
            "forearm_recovery_insufficient",
            "shoulder_recovery_insufficient",
            "back_recovery_insufficient",
            "recent_running_quality_session",
            "recent_long_run"
          ]
        },
        "origin": {"enum": ["user_asserted", "provider_fact", "device_fact"]},
        "source_revision_id": {"$ref": "#/$defs/revision_id"},
        "current": {"type": "boolean"},
        "active": {"type": "boolean"},
        "effective_from_utc": {"type": "string", "format": "date-time"},
        "expires_at_utc": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        }
      }
    },
    "quality_session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "source_revision_id",
        "current",
        "is_formal_training",
        "quality_session",
        "local_date",
        "start_time_utc",
        "end_time_utc"
      ],
      "properties": {
        "activity_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_revision_id": {"$ref": "#/$defs/revision_id"},
        "current": {"type": "boolean"},
        "is_formal_training": {"type": "boolean"},
        "quality_session": {"type": "boolean"},
        "local_date": {"type": "string", "format": "date"},
        "start_time_utc": {"type": "string", "format": "date-time"},
        "end_time_utc": {"type": "string", "format": "date-time"}
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work_seconds", "recovery_seconds", "repetitions", "target_zone"],
      "properties": {
        "work_seconds": {"type": "integer", "minimum": 15, "maximum": 1800},
        "recovery_seconds": {"type": "integer", "minimum": 15, "maximum": 1800},
        "repetitions": {"type": "integer", "minimum": 1, "maximum": 20},
        "target_zone": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "running_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_kind",
        "hansons_session_role",
        "course_type",
        "warmup",
        "main_set",
        "cooldown",
        "planned_duration_minutes",
        "total_volume",
        "target_zone",
        "target_bpm_range",
        "prescribed_rpe",
        "talk_test",
        "work_intervals",
        "stop_conditions",
        "rationale"
      ],
      "properties": {
        "activity_kind": {"const": "running"},
        "hansons_session_role": {"enum": ["easy", "long", "tempo", "speed", "running_strength"]},
        "course_type": {"enum": ["easy", "steady", "long_easy", "intervals"]},
        "warmup": {"$ref": "#/$defs/token"},
        "main_set": {"$ref": "#/$defs/token"},
        "cooldown": {"$ref": "#/$defs/token"},
        "planned_duration_minutes": {"type": "integer", "minimum": 10, "maximum": 240},
        "planned_duration_seconds": {"type": "integer", "minimum": 600, "maximum": 14400},
        "total_volume": {"$ref": "#/$defs/token"},
        "target_zone": {
          "oneOf": [
            {"type": "null"},
            {"type": "integer", "minimum": 1, "maximum": 5}
          ]
        },
        "target_bpm_range": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/bpm_range"}
          ]
        },
        "prescribed_rpe": {"type": "number", "minimum": 1, "maximum": 10},
        "talk_test": {"$ref": "#/$defs/token"},
        "work_intervals": {
          "type": "array",
          "maxItems": 20,
          "items": {"$ref": "#/$defs/interval"}
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "enum": [
              "acute_pain",
              "chest_pain",
              "fainting_or_dizziness",
              "unusual_shortness_of_breath"
            ]
          }
        },
        "rationale": {"$ref": "#/$defs/token"}
      }
    },
    "climbing_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_kind", "rationale"],
      "properties": {
        "activity_kind": {"const": "climbing"},
        "rationale": {"$ref": "#/$defs/token"}
      }
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exercise_key", "movement_kind"],
      "properties": {
        "exercise_key": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
        "movement_kind": {"enum": ["squat", "hinge", "push", "pull", "carry", "core"]}
      }
    },
    "strength_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_kind", "rationale", "movements", "stop_conditions"],
      "properties": {
        "activity_kind": {"const": "strength"},
        "rationale": {"$ref": "#/$defs/token"},
        "movements": {
          "type": "array",
          "minItems": 3,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/movement"}
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["acute_pain", "acute_discomfort"]}
        }
      }
    },
    "rest_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_kind",
        "evidence",
        "uncertainty",
        "daily_activity_allowed",
        "recovery_signals",
        "seek_professional_help_if"
      ],
      "properties": {
        "activity_kind": {"const": "rest"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/token"}
        },
        "uncertainty": {"$ref": "#/$defs/token"},
        "daily_activity_allowed": {"type": "boolean"},
        "recovery_signals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/token"}
        },
        "seek_professional_help_if": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "primary_item": {
      "oneOf": [
        {"$ref": "#/$defs/running_item"},
        {"$ref": "#/$defs/climbing_item"},
        {"$ref": "#/$defs/strength_item"},
        {"$ref": "#/$defs/rest_item"}
      ]
    },
    "substitution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_revision_id",
        "current",
        "declared",
        "planned_activity_kind",
        "actual_activity_kind",
        "planned_duration_minutes",
        "planned_duration_seconds",
        "actual_duration_minutes",
        "actual_duration_seconds"
      ],
      "properties": {
        "source_revision_id": {"$ref": "#/$defs/revision_id"},
        "current": {"type": "boolean"},
        "declared": {"const": "substituted"},
        "planned_activity_kind": {"enum": ["running", "climbing", "strength", "rest"]},
        "actual_activity_kind": {"enum": ["running", "climbing", "strength", "rest"]},
        "planned_duration_minutes": {"type": "number", "minimum": 1, "maximum": 1440},
        "planned_duration_seconds": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 1, "maximum": 86400}
          ]
        },
        "actual_duration_minutes": {"type": "number", "minimum": 1, "maximum": 1440},
        "actual_duration_seconds": {
          "oneOf": [
            {"type": "null"},
            {"type": "number", "minimum": 1, "maximum": 86400}
          ]
        }
      }
    }
  }
}
