{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundles"],
  "properties": {
    "schema_version": {"const": "1"},
    "bundles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["daily", "weekly", "revise_plan", "delivery"],
      "properties": {
        "daily": {"$ref": "#/$defs/bundle"},
        "weekly": {"$ref": "#/$defs/bundle"},
        "revise_plan": {"$ref": "#/$defs/bundle"},
        "delivery": {"$ref": "#/$defs/bundle"}
      }
    }
  },
  "$defs": {
    "bundle": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^harness/(shared/HARNESS|analysis/(HARNESS|daily|weekly|revise-plan|delivery))\\.md$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
